{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "99299078e3cc4c0796ee939e561c7ad0",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "CalculateEdges (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1581.000244140625,
            "y": 638.5001220703125,
            "width": 242.5001220703125,
            "height": 214.00006103515626
        }
    },
    "m_Slots": [
        {
            "m_Id": "e41cd06c8e44402f92fb3c6fd91dc934"
        },
        {
            "m_Id": "88c497c6340e46c088bfb045daf2acbd"
        },
        {
            "m_Id": "aec258099abf48128abb792bc3c9fefa"
        },
        {
            "m_Id": "3e06125481b74bfd82da1927fe30ba91"
        },
        {
            "m_Id": "ddce756eff564208949b5727ddf124c0"
        },
        {
            "m_Id": "40dfc3e944cf450ca2afb7e34c7e23cb"
        },
        {
            "m_Id": "b8202604d4dc4b27822409f86598abbe"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "CalculateEdges",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#ifndef SHADERGRAPH_PREVIEW\n    #include \"Packages/com.unity.render-pipelines.universal/ShaderLibrary/DeclareDepthTexture.hlsl\"\n    #include \"Packages/com.unity.render-pipelines.universal/ShaderLibrary/DeclareNormalsTexture.hlsl\"\n#endif\n\n#ifdef SHADERGRAPH_PREVIEW\n    Edge = 0.0;\n#else\n    float2 texelSize = 1.0 / _ScreenParams.xy;\n    float2 t = texelSize * Thickness;\n\n    // 8 точок вибірки для кращого детектування в ізометрії\n    float2 uvOffsets[8] = {\n        float2(0, t.y), float2(0, -t.y), float2(t.x, 0), float2(-t.x, 0),\n        float2(t.x, t.y), float2(-t.x, -t.y), float2(t.x, -t.y), float2(-t.x, t.y)\n    };\n\n    float centerDepth = SampleSceneDepth(UV);\n    float3 centerNormal = SampleSceneNormals(UV);\n    \n    float depthEdge = 0;\n    float normEdge = 0;\n\n    for (int i = 0; i < 8; i++) {\n        float d = SampleSceneDepth(UV + uvOffsets[i]);\n        float3 n = SampleSceneNormals(UV + uvOffsets[i]);\n\n        depthEdge += abs(centerDepth - d);\n        normEdge += (1.0 - dot(centerNormal, n));\n    }\n\n    // Динамічні пороги з врахуванням ефекту олівця\n    float d_thresh = DepthThreshold + (PencilNoise * UsePencilEffect * 0.01);\n    float n_thresh = NormalThreshold + (PencilNoise * UsePencilEffect * 0.2);\n\n    float finalDepth = step(d_thresh, depthEdge * 10.0);\n    float finalNorm = step(n_thresh, normEdge);\n\n    // Логіка неба\n    if (centerDepth > 0.999 || centerDepth < 0.0001) {\n        Edge = 0.0;\n    } else {\n        Edge = saturate(finalDepth + finalNorm);\n    }\n#endif"
}

