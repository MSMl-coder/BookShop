/* =====================================================
   InventoryStyles.uss — PAPER ARCHIVE
   Інвентар як registry log
   ===================================================== */

/* Панель — manila folder */
.inventory-panel {
    position: absolute;
    left: 0;
    top: 56px;
    bottom: 50px;
    width: 360px;
    background-color: rgb(216, 180, 120);
    border-right-color: rgb(138, 112, 64);
    border-right-width: 2px;
    flex-direction: column;
}

/* Header як штамп архіву */
.inventory-header {
    padding-top: 14px;
    padding-bottom: 10px;
    padding-left: 18px;
    padding-right: 18px;
    border-bottom-color: rgb(26, 26, 26);
    border-bottom-width: 2px;
}

.inventory-title {
    color: rgb(26, 26, 26);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    margin-bottom: 4px;
}

.inventory-count {
    font-size: 9px;
    color: rgb(106, 74, 26);
    letter-spacing: 2px;
    -unity-font-style: italic;
    margin-bottom: 8px;
}

/* Sort tabs — як вкладки у картотеці */
.sort-tabs-row {
    flex-direction: row;
    flex-wrap: wrap;
    padding-top: 4px;
}

.sort-tab {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    border-radius: 0;
    color: rgb(26, 26, 26);
    font-size: 10px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 9px;
    padding-right: 9px;
    margin-right: 4px;
    margin-bottom: 4px;
    letter-spacing: 1px;
    transition-duration: 0.12s;
}

.sort-tab:hover {
    background-color: rgb(240, 226, 184);
}

.sort-tab.active {
    background-color: rgb(26, 26, 26);
    color: rgb(244, 234, 208);
    -unity-font-style: bold;
}

/* ── Сітка книг ── */
.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
    flex-grow: 1;
    align-content: flex-start;
}

/* ══════════════════════════════════════════════════════
   КАРТКА КНИГИ — як паперовий бланк з номером
   ══════════════════════════════════════════════════════ */
.book-card {
    width: 88px;
    height: 124px;
    margin-top: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    margin-right: 5px;
    background-color: rgb(244, 234, 208);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    border-radius: 1px;
    flex-direction: column;
    overflow: hidden;
    transition-duration: 0.15s;
}

.book-card:hover {
    border-color: rgb(200, 64, 48);
    border-width: 2px;
    background-color: rgb(248, 240, 218);
    translate: 0 -2px;
    rotate: -1deg;
}

.book-card:active { scale: 0.97; }

/* Spine — кольорова смужка зверху, як на бланках */
.book-spine {
    height: 5px;
    width: 100%;
}

/* Cover — зона іконки */
.book-cover {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(216, 180, 120, 0.3);
}

.book-icon {
    width: 70%;
    height: 70%;
    -unity-background-scale-mode: scale-to-fit;
}

.book-icon-label {
    font-size: 9px;
    color: rgb(58, 42, 26);
    -unity-text-align: middle-center;
    white-space: normal;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    padding-right: 4px;
    -unity-font-style: bold;
}

/* Footer — ціна як на касовому чеку */
.book-footer {
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgb(240, 226, 184);
    border-top-color: rgb(26, 26, 26);
    border-top-width: 1px;
}

.book-price-label {
    font-size: 11px;
    color: rgb(26, 26, 26);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

/* Точка рідкості — як кольоровий штамп у куті */
.rarity-dot {
    width: 10px;
    height: 10px;
    position: absolute;
    top: 8px;
    right: 6px;
    border-color: rgb(26, 26, 26);
    border-width: 1px;
}

.rarity-dot.common    { background-color: rgb(122, 117, 112); }
.rarity-dot.uncommon  { background-color: rgb(42, 74, 42);    }
.rarity-dot.rare      { background-color: rgb(26, 58, 106);   }
.rarity-dot.epic      { background-color: rgb(90, 42, 106);   }
.rarity-dot.legendary { background-color: rgb(200, 64, 48);   }
