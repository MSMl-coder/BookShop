/* =====================================================
   PhaseButtonStyles.uss — PAPER ARCHIVE
   Кнопка фази як штамп + Upgrade як паперова форма
   ===================================================== */

/* ══════════════════════════════════════════════════════
   PHASE WIDGET — внизу по центру
   ══════════════════════════════════════════════════════ */

.phase-widget {
    position: absolute;
    bottom: 58px;
    left: 50%;
    translate: -50% 0;

    flex-direction: row;
    align-items: center;

    background-color: rgb(244, 234, 208);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    border-radius: 3px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    rotate: -0.4deg;
}

/* Індикатор фази */
.phase-indicator {
    flex-direction: column;
    align-items: center;
    padding-left: 6px;
    padding-right: 8px;
}

.phase-indicator__dots {
    flex-direction: row;
    margin-bottom: 3px;
}

.phase-dot {
    width: 8px;
    height: 8px;
    margin-left: 2px;
    margin-right: 2px;
    background-color: rgb(216, 200, 152);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    transition-duration: 0.3s;
}

.phase-dot.active {
    background-color: rgb(200, 64, 48);
    width: 22px;
}

.phase-dot.done {
    background-color: rgb(26, 26, 26);
}

.phase-indicator__label {
    font-size: 8px;
    color: rgb(106, 74, 26);
    letter-spacing: 2px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
}

.phase-widget__sep {
    width: 1px;
    height: 28px;
    background-color: rgb(26, 26, 26);
    margin-left: 8px;
    margin-right: 8px;
}

/* Головна кнопка-штамп */
.phase-main-btn {
    height: 36px;
    border-radius: 2px;
    border-width: 1px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    padding-left: 22px;
    padding-right: 22px;
    transition-duration: 0.18s;
}

.phase-main-btn.open-shop {
    background-color: rgb(42, 74, 42);
    border-color: rgb(20, 50, 20);
    color: rgb(244, 234, 208);
}

.phase-main-btn.open-shop:hover {
    background-color: rgb(60, 100, 60);
    scale: 1.03;
}

.phase-main-btn.end-day {
    background-color: rgb(200, 64, 48);
    border-color: rgb(160, 40, 32);
    color: rgb(244, 234, 208);
}

.phase-main-btn.end-day:hover {
    background-color: rgb(220, 76, 56);
    scale: 1.03;
}

.phase-main-btn.inactive {
    background-color: rgb(216, 200, 152);
    border-color: rgb(106, 74, 26);
    color: rgb(106, 74, 26);
    opacity: 0.6;
}

.phase-main-btn:active { scale: 0.97; }

.phase-timer {
    font-size: 10px;
    color: rgb(106, 74, 26);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    min-width: 36px;
    margin-left: 4px;
}

/* ══════════════════════════════════════════════════════
   UPGRADE MODAL — як офіційна форма
   ══════════════════════════════════════════════════════ */

.upgrade-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(40, 45, 30, 0.78);
    align-items: center;
    justify-content: center;
}

.upgrade-overlay.hidden { display: none; }

.upgrade-modal {
    width: 520px;
    background-color: rgb(244, 234, 208);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    border-radius: 2px;
    overflow: hidden;
    flex-direction: column;
    rotate: -0.3deg;
}

.upgrade-modal__top-bar {
    height: 5px;
    background-color: rgb(200, 64, 48);
}

/* Header як на офіційній формі */
.upgrade-modal__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    padding-bottom: 12px;
    padding-left: 22px;
    padding-right: 18px;
    border-bottom-color: rgb(26, 26, 26);
    border-bottom-width: 2px;
    background-color: rgb(240, 226, 184);
}

.upgrade-modal__title {
    font-size: 16px;
    color: rgb(26, 26, 26);
    -unity-font-style: bold;
    letter-spacing: 5px;
}

.upgrade-modal__slot-name {
    font-size: 9px;
    color: rgb(106, 74, 26);
    -unity-font-style: italic;
    letter-spacing: 1px;
    margin-top: 3px;
}

/* Body */
.upgrade-modal__body {
    flex-direction: row;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 18px;
    padding-right: 18px;
}

/* Поточна шафа — бібліотечна картка */
.upgrade-current {
    width: 130px;
    flex-direction: column;
    align-items: center;
    background-color: rgb(216, 200, 152);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    border-radius: 2px;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 10px;
    padding-right: 10px;
    margin-right: 10px;
}

.upgrade-current__label {
    font-size: 8px;
    color: rgb(106, 74, 26);
    letter-spacing: 2px;
    -unity-font-style: italic;
    margin-bottom: 10px;
}

.upgrade-current__icon {
    width: 60px;
    height: 60px;
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    margin-bottom: 8px;
    background-color: rgb(244, 234, 208);
    -unity-background-scale-mode: scale-to-fit;
}

.upgrade-current__name {
    font-size: 11px;
    color: rgb(26, 26, 26);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 4px;
    letter-spacing: 1px;
}

.upgrade-current__class {
    font-size: 8px;
    color: rgb(106, 74, 26);
    letter-spacing: 1px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
}

.upgrade-arrow {
    font-size: 22px;
    color: rgb(200, 64, 48);
    align-self: center;
    margin-left: 4px;
    margin-right: 4px;
    -unity-font-style: bold;
}

/* Опції — як рядки реєстру */
.upgrade-options {
    flex-grow: 1;
    flex-direction: column;
}

.upgrade-options__label {
    font-size: 8px;
    color: rgb(106, 74, 26);
    letter-spacing: 2px;
    -unity-font-style: italic;
    margin-bottom: 6px;
}

.upgrade-option {
    flex-direction: row;
    align-items: center;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgb(240, 226, 184);
    border-color: rgb(138, 112, 64);
    border-width: 1px;
    margin-bottom: 4px;
    transition-duration: 0.12s;
}

.upgrade-option:hover {
    background-color: rgb(244, 234, 208);
    border-color: rgb(26, 26, 26);
}

.upgrade-option.selected {
    background-color: rgb(244, 234, 208);
    border-color: rgb(200, 64, 48);
    border-width: 2px;
}

.upgrade-option.cant-afford { opacity: 0.45; }

.upgrade-option__icon {
    width: 38px;
    height: 38px;
    background-color: rgb(216, 200, 152);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.upgrade-option__info {
    flex-grow: 1;
    flex-direction: column;
}

.upgrade-option__name {
    font-size: 11px;
    color: rgb(26, 26, 26);
    -unity-font-style: bold;
    margin-bottom: 2px;
    letter-spacing: 1px;
}

.upgrade-option__bonus {
    font-size: 9px;
    color: rgb(106, 74, 26);
    -unity-font-style: italic;
    white-space: normal;
}

.upgrade-option__price {
    font-size: 13px;
    color: rgb(26, 74, 26);
    -unity-font-style: bold;
    margin-left: 8px;
    letter-spacing: 1px;
}

.upgrade-option.cant-afford .upgrade-option__price {
    color: rgb(200, 64, 48);
}

/* Footer */
.upgrade-modal__footer {
    flex-direction: row;
    justify-content: flex-end;
    padding-top: 12px;
    padding-bottom: 16px;
    padding-left: 20px;
    padding-right: 20px;
    border-top-color: rgb(26, 26, 26);
    border-top-width: 1px;
    background-color: rgb(240, 226, 184);
}

.upgrade-cancel-btn {
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    border-radius: 2px;
    color: rgb(26, 26, 26);
    font-size: 11px;
    letter-spacing: 2px;
    margin-right: 10px;
}

.upgrade-cancel-btn:hover {
    background-color: rgb(216, 180, 120);
}

.upgrade-confirm-btn {
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 22px;
    padding-right: 22px;
    background-color: rgb(200, 64, 48);
    border-color: rgb(160, 40, 32);
    border-width: 1px;
    border-radius: 2px;
    color: rgb(244, 234, 208);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    transition-duration: 0.12s;
}

.upgrade-confirm-btn:hover {
    background-color: rgb(220, 76, 56);
    scale: 1.02;
}

.upgrade-confirm-btn:active { scale: 0.97; }

.upgrade-confirm-btn:disabled {
    opacity: 0.4;
    background-color: rgb(140, 100, 90);
}
