/* =====================================================
   EndOfDayStyles.uss — PAPER ARCHIVE
   Loot картки як розкидані бібліотечні картки
   ===================================================== */

.end-day-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(40, 45, 30, 0.95);
    align-items: center;
    justify-content: center;
    display: none;
}

/* Title — як штамп архіву */
.end-day-title-block {
    align-items: center;
    margin-bottom: 30px;
}

.end-day-title {
    font-size: 42px;
    color: rgb(244, 234, 208);
    -unity-font-style: bold;
    letter-spacing: 12px;
    margin-bottom: 6px;
}

.end-day-subtitle {
    font-size: 11px;
    color: rgb(216, 200, 152);
    -unity-font-style: italic;
    letter-spacing: 4px;
}

/* Stats row — як паперові пігулки HUD */
.end-day-stats {
    flex-direction: row;
    margin-bottom: 36px;
}

.stat-chip {
    background-color: rgb(244, 234, 208);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    border-radius: 2px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 24px;
    padding-right: 24px;
    margin-left: 8px;
    margin-right: 8px;
    align-items: center;
    rotate: -1deg;
}

.stat-chip__label {
    font-size: 9px;
    color: rgb(106, 74, 26);
    letter-spacing: 3px;
    -unity-font-style: italic;
    margin-bottom: 4px;
}

.stat-chip__value {
    font-size: 22px;
    color: rgb(26, 26, 26);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* Loot cards row */
.loot-cards-row {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    margin-bottom: 24px;
    flex-wrap: wrap;
}

/* ══════════════════════════════════════════════════════
   LOOT CARD — як бібліотечна картка з нахилом
   ══════════════════════════════════════════════════════ */

.loot-card {
    width: 200px;
    min-height: 320px;
    margin-left: 12px;
    margin-right: 12px;
    margin-top: 8px;
    background-color: rgb(244, 234, 208);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    border-radius: 2px;
    flex-direction: column;
    overflow: hidden;
    transition-duration: 0.2s;
    rotate: -1.5deg;
}

/* Кожна друга картка — нахил у інший бік */
.loot-card:nth-child(even) { rotate: 1.5deg; }

.loot-card:hover {
    border-color: rgb(200, 64, 48);
    border-width: 2px;
    translate: 0 -6px;
    rotate: 0deg;
}

/* Золота (legendary) картка */
.loot-card.gold {
    border-color: rgb(200, 64, 48);
    border-width: 2px;
    background-color: rgb(248, 240, 218);
}

/* Top bar */
.loot-card__top-bar {
    height: 6px;
    background-color: rgb(106, 74, 26);
}

.loot-card.gold .loot-card__top-bar {
    background-color: rgb(200, 64, 48);
}

/* Icon area */
.loot-card__icon-area {
    height: 130px;
    align-items: center;
    justify-content: center;
    background-color: rgb(216, 200, 152);
    border-bottom-color: rgb(138, 112, 64);
    border-bottom-width: 1px;
}

.loot-card__icon {
    font-size: 44px;
    color: rgb(26, 26, 26);
}

/* Type badge — як штамп */
.loot-card__type-badge {
    position: absolute;
    top: 14px;
    right: 10px;
    background-color: rgb(244, 234, 208);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 7px;
    padding-right: 7px;
    rotate: 4deg;
}

.loot-card__type-text {
    font-size: 9px;
    color: rgb(26, 26, 26);
    letter-spacing: 1px;
    -unity-font-style: bold;
}

/* Body */
.loot-card__body {
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 14px;
    padding-right: 14px;
    flex-grow: 1;
}

.loot-card__name {
    color: rgb(26, 26, 26);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: normal;
    margin-bottom: 8px;
}

.loot-card.gold .loot-card__name {
    color: rgb(200, 64, 48);
}

.loot-card__desc {
    color: rgb(58, 42, 26);
    font-size: 10px;
    -unity-font-style: italic;
    white-space: normal;
}

/* Footer */
.loot-card__footer {
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 14px;
    padding-right: 14px;
    border-top-color: rgb(26, 26, 26);
    border-top-width: 1px;
    background-color: rgb(240, 226, 184);
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.loot-card__cost {
    font-size: 14px;
    color: rgb(26, 26, 26);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.loot-card__cost.free {
    color: rgb(26, 74, 26);
}

/* Pick button — червоний штамп */
.loot-card__pick-btn {
    background-color: rgb(200, 64, 48);
    border-color: rgb(160, 40, 32);
    border-width: 1px;
    border-radius: 2px;
    color: rgb(244, 234, 208);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 14px;
    padding-right: 14px;
    transition-duration: 0.12s;
}

.loot-card__pick-btn:hover {
    background-color: rgb(220, 76, 56);
    scale: 1.04;
}

.loot-card__pick-btn:active { scale: 0.97; }

.loot-card__pick-btn:disabled {
    background-color: rgb(140, 100, 90);
    color: rgb(216, 200, 152);
    opacity: 0.5;
}

.end-day-hint {
    font-size: 11px;
    color: rgb(180, 165, 140);
    -unity-font-style: italic;
    letter-spacing: 1px;
}

.picks-remaining {
    font-size: 13px;
    color: rgb(216, 200, 152);
    margin-bottom: 16px;
    letter-spacing: 2px;
}

.picks-remaining__number {
    color: rgb(244, 234, 208);
    -unity-font-style: bold;
}
