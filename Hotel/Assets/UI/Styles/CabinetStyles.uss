/* =====================================================
   CabinetStyles.uss — PAPER ARCHIVE
   Шафи та полиці як архівна картотека
   ===================================================== */

/* Cabinet panel — manila folder з right side */
.cabinet-panel {
    position: absolute;
    right: 0;
    top: 56px;
    bottom: 50px;
    width: 280px;
    background-color: rgb(216, 180, 120);
    border-left-color: rgb(138, 112, 64);
    border-left-width: 2px;
    flex-direction: column;
}

/* Header */
.cabinet-header {
    padding-top: 14px;
    padding-bottom: 10px;
    padding-left: 18px;
    padding-right: 18px;
    border-bottom-color: rgb(26, 26, 26);
    border-bottom-width: 2px;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
}

.cabinet-title {
    color: rgb(26, 26, 26);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 5px;
}

.cabinet-zone-label {
    font-size: 9px;
    color: rgb(106, 74, 26);
    letter-spacing: 1px;
    -unity-font-style: italic;
    margin-top: 2px;
}

/* Section label — "— SHELVES —" */
.section-label {
    font-size: 9px;
    color: rgb(106, 74, 26);
    letter-spacing: 3px;
    -unity-font-style: italic;
    padding-top: 10px;
    padding-bottom: 4px;
    padding-left: 18px;
    padding-right: 18px;
}

/* Cabinet list */
.cabinet-list {
    max-height: 160px;
    border-bottom-color: rgb(138, 112, 64);
    border-bottom-width: 1px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
}

/* Cabinet item — рядок registry */
.cabinet-item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(244, 234, 208);
    border-color: rgb(138, 112, 64);
    border-width: 1px;
    border-radius: 1px;
    margin-bottom: 4px;
    transition-duration: 0.12s;
}

.cabinet-item:hover {
    background-color: rgb(248, 240, 218);
    border-color: rgb(26, 26, 26);
}

.cabinet-item.selected {
    background-color: rgb(240, 226, 184);
    border-color: rgb(26, 26, 26);
    border-width: 2px;
}

.cabinet-item__name {
    color: rgb(26, 26, 26);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    flex-grow: 1;
}

.cabinet-item__count {
    font-size: 9px;
    color: rgb(106, 74, 26);
    letter-spacing: 1px;
    margin-left: 6px;
}

/* Shelf list */
.shelf-list {
    flex-grow: 1;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
}

/* Shelf item — як рядок з табельного журналу */
.shelf-item {
    flex-direction: row;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgb(240, 226, 184);
    border-color: rgb(138, 112, 64);
    border-width: 1px;
    border-radius: 1px;
    margin-bottom: 3px;
    transition-duration: 0.12s;
}

.shelf-item:hover {
    background-color: rgb(244, 234, 208);
    border-color: rgb(26, 26, 26);
}

.shelf-item.selected {
    background-color: rgb(244, 234, 208);
    border-color: rgb(26, 26, 26);
    border-width: 2px;
}

.shelf-item__name {
    color: rgb(26, 26, 26);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    min-width: 70px;
}

/* Fill bar — машинописні крапки прогресу */
.shelf-fill-bg {
    flex-grow: 1;
    height: 4px;
    background-color: rgb(216, 200, 152);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    margin-left: 8px;
    margin-right: 8px;
}

.shelf-fill-bar {
    height: 4px;
    background-color: rgb(26, 26, 26);
    transition-duration: 0.3s;
}

.shelf-fill-bar.full {
    background-color: rgb(200, 64, 48);
}

.shelf-item__count {
    font-size: 9px;
    color: rgb(106, 74, 26);
    letter-spacing: 1px;
    min-width: 36px;
    -unity-text-align: middle-right;
}

/* Selected shelf label — як підпис унизу картки */
.selected-shelf-label {
    font-size: 10px;
    color: rgb(58, 42, 26);
    -unity-font-style: italic;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 18px;
    padding-right: 18px;
    border-top-color: rgb(138, 112, 64);
    border-top-width: 1px;
    white-space: normal;
}

/* Transfer row — кнопки перенесення */
.transfer-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-top: 10px;
    padding-bottom: 14px;
    padding-left: 12px;
    padding-right: 12px;
    border-top-color: rgb(26, 26, 26);
    border-top-width: 1px;
    background-color: rgb(216, 200, 152);
}

.transfer-btn {
    width: 42px;
    height: 32px;
    border-radius: 2px;
    font-size: 16px;
    -unity-font-style: bold;
    margin-left: 3px;
    margin-right: 3px;
    -unity-text-align: middle-center;
    transition-duration: 0.12s;
    border-width: 1px;
}

.transfer-btn.push {
    background-color: rgb(200, 64, 48);
    border-color: rgb(160, 40, 32);
    color: rgb(244, 234, 208);
}

.transfer-btn.push:hover {
    background-color: rgb(220, 76, 56);
    scale: 1.06;
}

.transfer-btn.pop {
    background-color: rgb(244, 234, 208);
    border-color: rgb(26, 26, 26);
    color: rgb(26, 26, 26);
}

.transfer-btn.pop:hover {
    background-color: rgb(216, 180, 120);
    scale: 1.06;
}

.transfer-btn:active { scale: 0.95; }

.transfer-btn:disabled {
    opacity: 0.4;
    background-color: rgb(180, 165, 130);
}
