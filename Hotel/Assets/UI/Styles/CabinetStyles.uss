/* =====================================================
   CabinetStyles.uss
   Стилі для CabinetPanel: список шаф, полиць, transfer-кнопки
   ===================================================== */

/* ── Cabinet Panel ── */
.cabinet-panel {
    position: absolute;
    right: 0;
    top: 56px;
    bottom: 50px;
    width: 280px;
    background-color: rgba(12, 7, 3, 0.97);
    border-left-color: rgba(184, 134, 11, 0.28);
    border-left-width: 1px;
    flex-direction: column;
}

/* ── Panel Header ── */
.cabinet-header {
    padding-top: 14px;
    padding-bottom: 10px;
    padding-left: 18px;
    padding-right: 18px;
    border-bottom-color: rgba(184, 134, 11, 0.18);
    border-bottom-width: 1px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.cabinet-title {
    color: rgb(212, 160, 23);
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 4px;
}

.cabinet-zone-label {
    font-size: 10px;
    color: rgb(100, 70, 45);
    -unity-font-style: italic;
    letter-spacing: 1px;
}

/* ── Section divider label ── */
.section-label {
    font-size: 9px;
    color: rgb(100, 70, 45);
    letter-spacing: 3px;
    -unity-font-style: italic;
    padding-top: 10px;
    padding-bottom: 4px;
    padding-left: 18px;
    padding-right: 18px;
}

/* ── Cabinet List (ScrollView) ── */
.cabinet-list {
    max-height: 160px;
    border-bottom-color: rgba(184, 134, 11, 0.15);
    border-bottom-width: 1px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
}

/* ── Cabinet Item ── */
.cabinet-item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 5px;
    border-color: rgba(184, 134, 11, 0.1);
    border-width: 1px;
    margin-bottom: 3px;
    transition-duration: 0.12s;
}

.cabinet-item:hover {
    background-color: rgba(184, 134, 11, 0.1);
    border-color: rgba(184, 134, 11, 0.3);
    cursor: link;
}

.cabinet-item.selected {
    background-color: rgba(184, 134, 11, 0.2);
    border-color: rgba(184, 134, 11, 0.55);
}

.cabinet-item__name {
    color: rgb(220, 205, 174);
    font-size: 13px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.cabinet-item.selected .cabinet-item__name {
    color: rgb(240, 192, 64);
}

.cabinet-item__count {
    font-size: 10px;
    color: rgb(100, 70, 45);
    -unity-font-style: italic;
    margin-left: 6px;
}

/* ── Shelf List (ScrollView) ── */
.shelf-list {
    flex-grow: 1;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
}

/* ── Shelf Item ── */
.shelf-item {
    flex-direction: row;
    align-items: center;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 5px;
    border-color: rgba(184, 134, 11, 0.08);
    border-width: 1px;
    margin-bottom: 3px;
    transition-duration: 0.12s;
}

.shelf-item:hover {
    background-color: rgba(184, 134, 11, 0.1);
    border-color: rgba(184, 134, 11, 0.28);
    cursor: link;
}

.shelf-item.selected {
    background-color: rgba(184, 134, 11, 0.18);
    border-color: rgba(184, 134, 11, 0.5);
}

.shelf-item__name {
    color: rgb(180, 160, 130);
    font-size: 12px;
    min-width: 70px;
}

.shelf-item.selected .shelf-item__name {
    color: rgb(240, 192, 64);
}

/* ── Fill Bar ── */
.shelf-fill-bg {
    flex-grow: 1;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.07);
    border-radius: 2px;
    margin-left: 8px;
    margin-right: 8px;
}

.shelf-fill-bar {
    height: 4px;
    background-color: rgb(184, 134, 11);
    border-radius: 2px;
    transition-duration: 0.3s;
}

/* Заповнена полиця — червона підсказка */
.shelf-fill-bar.full {
    background-color: rgb(200, 60, 40);
}

.shelf-item__count {
    font-size: 10px;
    color: rgb(100, 70, 45);
    -unity-font-style: italic;
    min-width: 40px;
    -unity-text-align: middle-right;
}

/* ── Selected Shelf Label ── */
.selected-shelf-label {
    font-size: 11px;
    color: rgb(130, 95, 65);
    -unity-font-style: italic;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 18px;
    padding-right: 18px;
    border-top-color: rgba(184, 134, 11, 0.18);
    border-top-width: 1px;
    white-space: normal;
}

/* ── Transfer Row ── */
.transfer-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-top: 10px;
    padding-bottom: 14px;
    padding-left: 12px;
    padding-right: 12px;
    border-top-color: rgba(184, 134, 11, 0.2);
    border-top-width: 1px;
}

.transfer-btn {
    width: 44px;
    height: 36px;
    border-radius: 5px;
    font-size: 18px;
    -unity-font-style: bold;
    margin-left: 4px;
    margin-right: 4px;
    -unity-text-align: middle-center;
    transition-duration: 0.12s;
}

/* › » — покласти на полицю (золото) */
.transfer-btn.push {
    background-color: rgba(184, 134, 11, 0.15);
    border-color: rgba(184, 134, 11, 0.4);
    border-width: 1px;
    color: rgb(212, 160, 23);
}

.transfer-btn.push:hover {
    background-color: rgba(184, 134, 11, 0.3);
    border-color: rgb(240, 192, 64);
    color: rgb(240, 192, 64);
    scale: 1.06;
}

/* ‹ « — забрати з полиці (тьмяно) */
.transfer-btn.pop {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(130, 95, 65, 0.35);
    border-width: 1px;
    color: rgb(130, 95, 65);
}

.transfer-btn.pop:hover {
    background-color: rgba(200, 100, 40, 0.15);
    border-color: rgba(200, 130, 60, 0.55);
    color: rgb(200, 160, 80);
    scale: 1.06;
}

.transfer-btn:active {
    scale: 0.95;
}

.transfer-btn:disabled {
    opacity: 0.35;
}
