/* Assets/UI/Styles/ContextMenuUI.uss v3.2 */

/* ── Зовнішня панель ───────────────────────────────────── */
.ctx-panel {
    position: absolute;
    display: none;

    background-color: rgba(18, 18, 22, 0.96);
    border-radius: 8px;

    padding: 4px 2px;
    width: 210px;

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.09);
    border-right-color: rgba(255, 255, 255, 0.09);
    border-top-color: rgba(255, 255, 255, 0.09);
    border-bottom-color: rgba(255, 255, 255, 0.09);
}

/* ── Контейнер кнопок ─────────────────────────────────── */
.ctx-container {
    flex-direction: column;
    align-items: stretch;
}

/* ── Кнопка ───────────────────────────────────────────── */
.ctx-btn {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(235, 225, 200);

    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-radius: 5px;

    padding: 8px 14px;
    font-size: 13px;
    -unity-text-align: middle-left;
    margin: 1px 2px;
    cursor: link;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;

    transition-duration: 0.08s;
    transition-property: background-color;
}

.ctx-btn:hover {
    background-color: rgba(255, 255, 255, 0.09);
}

.ctx-btn:active {
    background-color: rgba(255, 255, 255, 0.16);
}

/* ── Disabled ─────────────────────────────────────────── */
.ctx-btn--disabled {
    color: rgb(90, 90, 95);
    cursor: arrow;
}

/* ── Tutorial highlight (зберігаємо) ─────────────────── */
.tutorial-highlight {
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-color: rgb(255, 212, 0);
    border-bottom-color: rgb(255, 212, 0);
    border-left-color: rgb(255, 212, 0);
    border-right-color: rgb(255, 212, 0);
    border-radius: 4px;
    transition-duration: 0.4s;
    transition-property: border-color;
}
