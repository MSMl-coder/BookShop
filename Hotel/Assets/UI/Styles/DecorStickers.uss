/* =====================================================
   DecorStickers.uss — PAPER ARCHIVE
   Декоративні стікери на сцені (для атмосфери)
   ===================================================== */

/* Контейнер декоративних стікерів — поверх HUD але під модалами */
.decor-stickers {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    /* НЕ блокує кліки */
    /* picking-mode встановлюється в UXML */
}

/* ── Бібліотечна картка з номером (правий верх) ── */
.sticker-library-card {
    position: absolute;
    top: 80px;
    right: 24px;
    width: 100px;

    background-color: rgb(216, 200, 152);
    border-color: rgb(138, 112, 64);
    border-width: 1px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 6px;
    padding-right: 6px;
    align-items: center;

    rotate: 5deg;
}

.sticker-library-card__lbl {
    font-size: 8px;
    color: rgb(106, 74, 26);
    letter-spacing: 1px;
    margin-bottom: 3px;
}

.sticker-library-card__num {
    font-size: 14px;
    color: rgb(26, 26, 26);
    -unity-font-style: bold;
    letter-spacing: 2px;
    border-top-color: rgb(26, 26, 26);
    border-top-width: 1px;
    border-bottom-color: rgb(26, 26, 26);
    border-bottom-width: 1px;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 6px;
    padding-right: 6px;
}

.sticker-library-card__foot {
    font-size: 7px;
    color: rgb(106, 74, 26);
    margin-top: 4px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ── REGISTERED штамп (низ зліва) ── */
.sticker-registered {
    position: absolute;
    bottom: 130px;
    left: 380px;

    background-color: rgb(244, 234, 208);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 12px;
    padding-right: 12px;
    flex-direction: row;
    align-items: center;
    rotate: -3deg;
}

.sticker-registered__label {
    color: rgb(200, 64, 48);
    -unity-font-style: bold;
    letter-spacing: 2px;
    font-size: 10px;
    margin-right: 6px;
}

.sticker-registered__num {
    color: rgb(26, 26, 26);
    font-size: 10px;
    letter-spacing: 1px;
}

/* ── Flight tag (правий бік) ── */
.sticker-flight-tag {
    position: absolute;
    bottom: 200px;
    right: 320px;

    background-color: rgb(216, 180, 120);
    border-color: rgb(106, 74, 26);
    border-width: 1px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    align-items: center;
    rotate: -4deg;
}

.sticker-flight-tag__lbl {
    font-size: 7px;
    color: rgb(106, 74, 26);
    letter-spacing: 1px;
}

.sticker-flight-tag__val {
    font-size: 12px;
    color: rgb(26, 26, 26);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

/* ── Великий "А" символ як на референсі ── */
.sticker-rank-letter {
    position: absolute;
    top: 130px;
    right: 140px;

    font-size: 38px;
    color: rgb(200, 64, 48);
    -unity-font-style: bold;
    letter-spacing: 2px;
    rotate: -4deg;
    /* opacity не доступна для тексту як у HTML, але в USS — opacity:0.X */
    opacity: 0.85;
}

/* ── CONFIDENTIAL штамп ── */
.sticker-confidential {
    position: absolute;
    top: 70px;
    left: 380px;

    border-color: rgb(200, 64, 48);
    border-width: 2px;
    color: rgb(200, 64, 48);
    -unity-font-style: bold;
    font-size: 11px;
    letter-spacing: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgba(244, 234, 208, 0.4);
    rotate: 6deg;
}
