/* =====================================================
   DecorationStyles.uss — PAPER ARCHIVE
   Декор як папки в архівній шафі
   ===================================================== */

.decoration-panel {
    position: absolute;
    left: 50%;
    top: 56px;
    bottom: 50px;
    translate: -50% 0;

    width: 680px;
    background-color: rgb(216, 180, 120);
    border-color: rgb(138, 112, 64);
    border-width: 1px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    flex-direction: column;
    overflow: hidden;
}

/* Шапка — як на FBI формі */
.deco-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    padding-bottom: 10px;
    padding-left: 22px;
    padding-right: 16px;
    border-bottom-color: rgb(26, 26, 26);
    border-bottom-width: 2px;
    background-color: rgb(216, 200, 152);
}

.deco-header__left {
    flex-direction: column;
}

.deco-title {
    color: rgb(26, 26, 26);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 6px;
}

.deco-subtitle {
    font-size: 9px;
    color: rgb(106, 74, 26);
    letter-spacing: 1px;
    -unity-font-style: italic;
    margin-top: 3px;
}

.deco-close-btn {
    color: rgb(26, 26, 26);
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(26, 26, 26);
}

.deco-close-btn:hover {
    background-color: rgb(200, 64, 48);
    color: rgb(244, 234, 208);
    border-color: rgb(160, 40, 32);
}

/* Filter row */
.deco-filter-row {
    flex-direction: row;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgb(216, 180, 120);
    border-bottom-color: rgb(138, 112, 64);
    border-bottom-width: 1px;
}

.deco-filter-btn {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    border-radius: 0;
    color: rgb(26, 26, 26);
    font-size: 10px;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 12px;
    padding-right: 12px;
    margin-right: 5px;
    letter-spacing: 1px;
    transition-duration: 0.12s;
}

.deco-filter-btn:hover {
    background-color: rgb(244, 234, 208);
}

.deco-filter-btn.active {
    background-color: rgb(26, 26, 26);
    color: rgb(244, 234, 208);
    -unity-font-style: bold;
}

/* Body — сітка + деталі */
.deco-body {
    flex-direction: row;
    flex-grow: 1;
    overflow: hidden;
}

.deco-grid {
    flex-grow: 1;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    padding-right: 8px;
    background-color: rgb(216, 200, 152);
}

.deco-grid > #unity-content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

/* ══════════════════════════════════════════════════════
   КАРТКА ПРЕДМЕТА — як інвентарний тег
   ══════════════════════════════════════════════════════ */
.furniture-card {
    width: 100px;
    height: 132px;
    margin-top: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    margin-right: 5px;
    background-color: rgb(244, 234, 208);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    border-radius: 2px;
    flex-direction: column;
    overflow: hidden;
    transition-duration: 0.15s;
}

.furniture-card:hover {
    border-color: rgb(200, 64, 48);
    border-width: 2px;
    translate: 0 -2px;
    rotate: -1deg;
}

.furniture-card:active { scale: 0.97; }

.furniture-card.placed {
    border-color: rgb(26, 74, 26);
    border-width: 2px;
    background-color: rgb(232, 224, 192);
}

.furniture-card.locked {
    background-color: rgb(216, 200, 152);
    border-color: rgb(138, 112, 64);
    opacity: 0.6;
}

.furniture-card.locked:hover {
    translate: 0 0;
    rotate: 0deg;
    border-color: rgb(106, 74, 26);
    border-width: 1px;
}

.furniture-card.selected {
    border-color: rgb(200, 64, 48);
    border-width: 2px;
    background-color: rgb(248, 240, 218);
}

/* Іконка */
.furniture-card__icon {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(216, 180, 120, 0.4);
    -unity-background-scale-mode: scale-to-fit;
}

.furniture-card__lock {
    font-size: 18px;
    color: rgb(58, 42, 26);
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    display: none;
}

.furniture-card.locked .furniture-card__lock {
    display: flex;
}

.furniture-card__name {
    font-size: 10px;
    color: rgb(26, 26, 26);
    -unity-text-align: middle-center;
    white-space: normal;
    padding-top: 4px;
    padding-bottom: 2px;
    padding-left: 4px;
    padding-right: 4px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.furniture-card.locked .furniture-card__name {
    color: rgb(80, 65, 50);
}

/* Bonus badge */
.furniture-card__bonus-badge {
    align-items: center;
    padding-bottom: 3px;
    padding-left: 4px;
    padding-right: 4px;
}

.furniture-card__bonus-text {
    font-size: 8px;
    color: rgb(106, 74, 26);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    white-space: normal;
    letter-spacing: 1px;
}

/* Status footer — як штамп */
.furniture-card__footer {
    padding-top: 3px;
    padding-bottom: 4px;
    background-color: rgb(240, 226, 184);
    border-top-color: rgb(26, 26, 26);
    border-top-width: 1px;
    align-items: center;
}

.furniture-card__status {
    font-size: 9px;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.furniture-card .furniture-card__status          { color: rgb(80, 65, 50); }
.furniture-card.placed .furniture-card__status   { color: rgb(26, 74, 26); }
.furniture-card.locked .furniture-card__status   { color: rgb(80, 65, 50); }
.furniture-card.selected .furniture-card__status { color: rgb(200, 64, 48); }

/* ══════════════════════════════════════════════════════
   ДЕТАЛІ
   ══════════════════════════════════════════════════════ */
.deco-detail {
    width: 200px;
    background-color: rgb(244, 234, 208);
    border-left-color: rgb(26, 26, 26);
    border-left-width: 2px;
    flex-direction: column;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 14px;
    padding-right: 14px;
}

.deco-detail__empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

.deco-detail__empty-icon {
    font-size: 32px;
    color: rgb(106, 74, 26);
    opacity: 0.3;
    margin-bottom: 10px;
}

.deco-detail__empty-text {
    font-size: 11px;
    color: rgb(106, 74, 26);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.deco-detail__content {
    flex-direction: column;
    flex-grow: 1;
}

.deco-detail__content.hidden { display: none; }

.deco-detail__icon {
    width: 76px;
    height: 76px;
    align-self: center;
    background-color: rgb(216, 200, 152);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    border-radius: 2px;
    margin-bottom: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.deco-detail__name {
    font-size: 13px;
    color: rgb(26, 26, 26);
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: normal;
    margin-bottom: 3px;
}

.deco-detail__class {
    font-size: 8px;
    color: rgb(106, 74, 26);
    letter-spacing: 2px;
    -unity-font-style: italic;
    margin-bottom: 8px;
}

.deco-detail__divider {
    height: 1px;
    background-color: rgb(26, 26, 26);
    margin-top: 6px;
    margin-bottom: 8px;
}

.deco-detail__section-label {
    font-size: 8px;
    color: rgb(106, 74, 26);
    letter-spacing: 2px;
    -unity-font-style: italic;
    margin-bottom: 4px;
}

.deco-detail__bonus-block {
    margin-bottom: 10px;
}

.deco-detail__bonus {
    font-size: 11px;
    color: rgb(26, 74, 26);
    -unity-font-style: bold;
    white-space: normal;
    letter-spacing: 1px;
}

.deco-detail__unlock-block {
    margin-bottom: 10px;
}

.deco-detail__unlock-block.hidden { display: none; }

.deco-detail__unlock {
    font-size: 10px;
    color: rgb(106, 74, 26);
    white-space: normal;
    -unity-font-style: italic;
}

.deco-detail__set-block {
    margin-bottom: 10px;
}

.deco-detail__set-block.hidden { display: none; }

.deco-detail__set-name {
    font-size: 11px;
    color: rgb(26, 26, 26);
    -unity-font-style: bold;
    margin-bottom: 6px;
    white-space: normal;
    letter-spacing: 1px;
}

.deco-detail__set-progress {
    flex-direction: row;
    flex-wrap: wrap;
}

.set-dot {
    width: 11px;
    height: 11px;
    margin-right: 4px;
    margin-bottom: 4px;
    border-color: rgb(26, 26, 26);
    border-width: 1px;
}

.set-dot.collected { background-color: rgb(26, 74, 26); }
.set-dot.missing   { background-color: rgb(244, 234, 208); }

/* Action button — червоний штамп */
.deco-action-btn {
    margin-top: auto;
    width: 100%;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgb(200, 64, 48);
    border-color: rgb(160, 40, 32);
    border-width: 1px;
    border-radius: 2px;
    color: rgb(244, 234, 208);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    transition-duration: 0.12s;
}

.deco-action-btn:hover {
    background-color: rgb(220, 76, 56);
    scale: 1.02;
}

.deco-action-btn.remove {
    background-color: rgb(58, 42, 26);
    border-color: rgb(26, 26, 26);
    color: rgb(244, 234, 208);
}

.deco-action-btn.remove:hover {
    background-color: rgb(80, 60, 40);
}

.deco-action-btn:disabled { opacity: 0.4; }
