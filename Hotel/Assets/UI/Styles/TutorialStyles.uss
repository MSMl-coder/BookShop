   Tutorial як post-it / службова записка
   ===================================================== */

.tutorial-bubble {
    position: absolute;
    bottom: 60px;
    left: 380px;
    right: 300px;

    background-color: rgb(240, 226, 184);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    border-radius: 2px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    flex-direction: row;
    align-items: center;
    rotate: -1deg;

    display: none;
}

.tutorial-bubble__icon {
    font-size: 24px;
    color: rgb(200, 64, 48);
    margin-right: 12px;
    flex-shrink: 0;
}

.tutorial-bubble__text {
    font-size: 12px;
    color: rgb(26, 26, 26);
    white-space: normal;
    flex-grow: 1;
    letter-spacing: 1px;
}

.tutorial-bubble__text .highlight {
    color: rgb(200, 64, 48);
    -unity-font-style: bold;
}

.tutorial-ok-btn {
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: rgb(200, 64, 48);
    border-color: rgb(160, 40, 32);
    border-width: 1px;
    border-radius: 2px;
    color: rgb(244, 234, 208);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    flex-shrink: 0;
    margin-left: 14px;
    transition-duration: 0.12s;
}

.tutorial-ok-btn:hover {
    background-color: rgb(220, 76, 56);
    scale: 1.02;
}
