/* =====================================================
   BookshopTheme.uss — Light Academia
   Підключати першим у кожному UXML
   ===================================================== */

/* ── Змінні кольорів ── */
:root {
    --parch:        rgb(242, 232, 208);
    --parch-dark:   rgb(220, 205, 174);
    --ink:          rgb(28, 14, 6);
    --ink2:         rgb(80, 52, 30);
    --ink3:         rgb(130, 95, 65);
    --gold:         rgb(184, 134, 11);
    --gold2:        rgb(212, 160, 23);
    --gold3:        rgb(240, 192, 64);
    --panel-bg:     rgba(14, 8, 3, 0.96);
    --panel-border: rgba(184, 134, 11, 0.35);
    --divider:      rgba(184, 134, 11, 0.2);
    --hover-bg:     rgba(184, 134, 11, 0.12);
    --selected-bg:  rgba(184, 134, 11, 0.22);
    --rare-common:   rgb(158, 158, 158);
    --rare-uncommon: rgb(76,  175, 80);
    --rare-rare:     rgb(33,  150, 243);
    --rare-epic:     rgb(156, 39,  176);
    --rare-legendary:rgb(255, 152, 0);
}

/* ── Текст ── */
.text-heading {
    font-size: 20px;
    color: rgb(240, 192, 64);
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.text-subheading {
    font-size: 13px;
    color: rgb(130, 95, 65);
    -unity-font-style: italic;
    letter-spacing: 2px;
}

.text-body {
    font-size: 14px;
    color: rgb(220, 205, 174);
}

.text-label {
    font-size: 11px;
    color: rgb(130, 95, 65);
    -unity-font-style: italic;
    letter-spacing: 1px;
}

.text-gold {
    color: rgb(240, 192, 64);
    -unity-font-style: bold;
}

.text-price {
    font-size: 16px;
    color: rgb(240, 192, 64);
    -unity-font-style: bold;
}

/* ── Кнопки ── */
.btn-primary {
    background-color: rgba(140, 100, 10, 0.8);
    border-color: rgba(240, 192, 64, 0.6);
    border-width: 1px;
    border-radius: 6px;
    color: rgb(242, 232, 208);
    -unity-font-style: bold;
    font-size: 13px;
    letter-spacing: 1px;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 16px;
    padding-right: 16px;
    transition-duration: 0.15s;
}

.btn-primary:hover {
    background-color: rgba(212, 160, 23, 0.6);
    border-color: rgb(240, 192, 64);
    scale: 1.02;
}

.btn-primary:active {
    scale: 0.98;
}

.btn-secondary {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(184, 134, 11, 0.3);
    border-width: 1px;
    border-radius: 6px;
    color: rgb(130, 95, 65);
    font-size: 12px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    transition-duration: 0.15s;
}

.btn-secondary:hover {
    background-color: rgba(184, 134, 11, 0.15);
    color: rgb(240, 192, 64);
    border-color: rgba(240, 192, 64, 0.5);
}

.btn-secondary.active {
    background-color: rgba(184, 134, 11, 0.22);
    border-color: rgb(240, 192, 64);
    color: rgb(240, 192, 64);
}

.btn-icon {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: rgba(184, 134, 11, 0.12);
    border-color: rgba(184, 134, 11, 0.35);
    border-width: 1px;
    color: rgb(240, 192, 64);
    font-size: 18px;
    -unity-text-align: middle-center;
    transition-duration: 0.12s;
}

.btn-icon:hover {
    background-color: rgba(184, 134, 11, 0.28);
    scale: 1.08;
}

/* ── Панелі ── */
.panel {
    background-color: rgba(14, 8, 3, 0.96);
    border-color: rgba(184, 134, 11, 0.35);
    border-width: 1px;
}

.panel-header {
    padding-top: 14px;
    padding-bottom: 10px;
    padding-left: 18px;
    padding-right: 18px;
    border-bottom-color: rgba(184, 134, 11, 0.2);
    border-bottom-width: 1px;
}

.panel-section-label {
    font-size: 9px;
    color: rgb(100, 70, 45);
    letter-spacing: 3px;
    -unity-font-style: italic;
    padding-top: 8px;
    padding-bottom: 3px;
    padding-left: 18px;
    padding-right: 18px;
}

/* ── List items ── */
.list-item {
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 5px;
    border-color: rgba(184, 134, 11, 0.12);
    border-width: 1px;
    margin-bottom: 3px;
    transition-duration: 0.12s;
}

.list-item:hover {
    background-color: rgba(184, 134, 11, 0.1);
}

.list-item.selected {
    background-color: rgba(184, 134, 11, 0.22);
    border-color: rgba(184, 134, 11, 0.5);
}

/* ── Divider ── */
.divider {
    height: 1px;
    background-color: rgba(184, 134, 11, 0.18);
    margin-top: 6px;
    margin-bottom: 6px;
}

/* ── Chip (badge) ── */
.chip {
    background-color: rgba(184, 134, 11, 0.12);
    border-color: rgba(184, 134, 11, 0.3);
    border-width: 1px;
    border-radius: 14px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 12px;
    padding-right: 12px;
    flex-direction: row;
    align-items: center;
}

/* ── Scrollbar ── */
#unity-content-viewport {
    --unity-metrics-default-font: 13px;
}

.unity-scroll-view__vertical-scroller .unity-base-slider__tracker {
    background-color: rgba(184, 134, 11, 0.08);
    width: 4px;
}

.unity-scroll-view__vertical-scroller .unity-base-slider__dragger {
    background-color: rgba(184, 134, 11, 0.35);
    border-radius: 2px;
    width: 4px;
}

.unity-scroll-view__horizontal-scroller {
    height: 0;
}
