/* =====================================================
   BookshopTheme.uss — PAPER ARCHIVE EDITION
   Підключати першим у кожному UXML
   ===================================================== */

/* ── Палітра ─────────────────────────────────────────
   bg-table     #4d5240   оливкова підкладка сцени
   paper-cream  #f4ead0   основний пергамент карток
   paper-manila #d8b478   manila folder
   paper-yellow #f0e2b8   жовті бланки, метрики
   paper-card   #d8c898   бібліотечна картка
   ink-black    #1a1a1a   основний текст
   ink-brown    #6a4a1a   мітки, лейбли
   ink-fade     #3a2a1a   вторинний текст
   stamp-red    #c84030   "REGISTERED", кнопки дії
   stamp-green  #2a4a2a   зелені штампи
   shadow-line  #8a7040   розділювачі, бордюри
   ──────────────────────────────────────────────────── */

/* ── Текст ── */
.text-heading {
    font-size: 18px;
    color: rgb(26, 26, 26);
    -unity-font-style: bold;
    letter-spacing: 5px;
}

.text-subheading {
    font-size: 9px;
    color: rgb(106, 74, 26);
    -unity-font-style: italic;
    letter-spacing: 2px;
}

.text-body {
    font-size: 12px;
    color: rgb(26, 26, 26);
}

.text-label {
    font-size: 8px;
    color: rgb(106, 74, 26);
    letter-spacing: 2px;
    -unity-font-style: italic;
}

.text-stamp {
    color: rgb(200, 64, 48);
    -unity-font-style: bold;
    letter-spacing: 3px;
}

/* ── Кнопки ───────────────────────────────────────── */

/* Червоний штамп — основна кнопка дії */
.btn-stamp {
    background-color: rgb(200, 64, 48);
    border-color: rgb(160, 40, 32);
    border-width: 1px;
    border-radius: 3px;
    color: rgb(244, 234, 208);
    -unity-font-style: bold;
    font-size: 12px;
    letter-spacing: 3px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 22px;
    padding-right: 22px;
    transition-duration: 0.15s;
}

.btn-stamp:hover {
    background-color: rgb(220, 76, 56);
    scale: 1.02;
}

.btn-stamp:active { scale: 0.97; }

.btn-stamp:disabled {
    background-color: rgb(140, 100, 90);
    color: rgb(200, 180, 170);
    opacity: 0.55;
}

/* Картонна світла кнопка — другорядна */
.btn-paper {
    background-color: rgb(240, 226, 184);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    border-radius: 2px;
    color: rgb(26, 26, 26);
    font-size: 11px;
    letter-spacing: 2px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 14px;
    padding-right: 14px;
    transition-duration: 0.12s;
}

.btn-paper:hover {
    background-color: rgb(232, 215, 165);
    border-color: rgb(106, 74, 26);
}

.btn-paper.active {
    background-color: rgb(216, 180, 120);
    border-color: rgb(106, 74, 26);
    border-width: 2px;
}

/* Кругла іконка-кнопка */
.btn-icon {
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background-color: rgb(240, 226, 184);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    color: rgb(26, 26, 26);
    font-size: 14px;
    -unity-text-align: middle-center;
    transition-duration: 0.12s;
}

.btn-icon:hover {
    background-color: rgb(216, 180, 120);
    scale: 1.08;
}

/* ── Manila Folder (основа панелі) ─────────────────── */
.folder {
    background-color: rgb(216, 180, 120);
    border-color: rgb(138, 112, 64);
    border-width: 1px;
    border-radius: 2px 2px 6px 6px;
    padding-top: 18px;
    padding-bottom: 22px;
    padding-left: 22px;
    padding-right: 22px;
}

/* Виступ зверху folder (tab) — окремий VisualElement */
.folder-tab {
    position: absolute;
    top: -12px;
    left: 30px;
    width: 90px;
    height: 18px;
    background-color: rgb(216, 180, 120);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-color: rgb(138, 112, 64);
    border-width: 1px;
    border-bottom-width: 0;
}

.folder-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom-color: rgb(26, 26, 26);
    border-bottom-width: 2px;
    padding-bottom: 10px;
    margin-bottom: 14px;
}

/* ── Паперова картка (cream) ──────────────────────── */
.paper-card {
    background-color: rgb(244, 234, 208);
    border-color: rgb(138, 112, 64);
    border-width: 1px;
    border-radius: 2px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 14px;
    padding-right: 14px;
}

/* Жовтий бланк — метрика, шорт-форма */
.yellow-form {
    background-color: rgb(240, 226, 184);
    border-color: rgb(138, 112, 64);
    border-width: 1px;
    border-radius: 2px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
}

/* Бібліотечна картка з номером */
.library-card {
    background-color: rgb(216, 200, 152);
    border-color: rgb(138, 112, 64);
    border-width: 1px;
    border-radius: 1px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 8px;
    padding-right: 8px;
}

/* ── Розділювачі ── */
.divider-solid {
    height: 2px;
    background-color: rgb(26, 26, 26);
    margin-top: 8px;
    margin-bottom: 10px;
}

.divider-dashed {
    height: 1px;
    background-color: rgb(138, 112, 64);
    margin-top: 6px;
    margin-bottom: 6px;
    /* USS не має border-style: dashed для горизонтальних ліній —
       імітуємо через color, в реальному USS це лишається solid */
}

/* ── Штамп-badge ── */
.stamp-badge {
    border-color: rgb(200, 64, 48);
    border-width: 2px;
    color: rgb(200, 64, 48);
    -unity-font-style: bold;
    font-size: 10px;
    letter-spacing: 3px;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgba(0, 0, 0, 0);
}

/* ── Tag-pill (для HUD) ── */
.hud-pill {
    background-color: rgb(240, 226, 184);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 14px;
    padding-right: 14px;
    flex-direction: row;
    align-items: center;
}

/* ── Scrollbar — мінімалістичний ── */
.unity-scroll-view__vertical-scroller .unity-base-slider__tracker {
    background-color: rgba(138, 112, 64, 0.15);
    width: 4px;
}

.unity-scroll-view__vertical-scroller .unity-base-slider__dragger {
    background-color: rgba(106, 74, 26, 0.5);
    border-radius: 2px;
    width: 4px;
}

.unity-scroll-view__horizontal-scroller {
    height: 0;
}
