/* =====================================================
   BookInfoCardStyles.uss
   "Бібліотечна картка" що висувається з правого краю
   ===================================================== */

/* ── Картка (контейнер) ── */
.book-info-card {
    position: absolute;
    right: 0;
    top: 50%;
    translate: 0 -50%;

    width: 240px;
    background-color: rgba(242, 232, 208, 0.97); /* --parch */
    border-left-color: rgba(184, 134, 11, 0.6);
    border-left-width: 2px;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;

    flex-direction: column;
    overflow: hidden;

    /* Анімація висування */
    transition-property: translate, opacity;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

/* Видима — висунута зліва */
.book-info-card.visible {
    translate: 0 -50%;
    opacity: 1;
}

/* Прихована — за правим краєм екрану */
.book-info-card.hidden {
    translate: 260px -50%;
    opacity: 0;
}

/* ── Верхня смуга жанру ── */
.info-card__genre-bar {
    height: 6px;
    background-color: rgb(184, 134, 11); /* дефолт: золото */
}

/* Кольори жанрів — задаються через C# AddToClassList() */
.info-card__genre-bar.fantasy    { background-color: rgb(79,  84, 192); }
.info-card__genre-bar.horror     { background-color: rgb(140, 26,  26); }
.info-card__genre-bar.mystery    { background-color: rgb(64,  64,  90); }
.info-card__genre-bar.classic    { background-color: rgb(120, 72,  26); }
.info-card__genre-bar.scifi      { background-color: rgb(26, 102, 140); }
.info-card__genre-bar.biography  { background-color: rgb(77, 128,  64); }
.info-card__genre-bar.academic   { background-color: rgb(140, 115, 38); }

/* ── Шапка ── */
.info-card__header {
    padding-top: 12px;
    padding-bottom: 8px;
    padding-left: 14px;
    padding-right: 14px;
    flex-direction: column;
}

.info-card__title {
    font-size: 14px;
    color: rgb(28, 14, 6);    /* --ink */
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 5px;
}

/* Рідкість — badge */
.info-card__rarity {
    font-size: 9px;
    letter-spacing: 2px;
    -unity-font-style: italic;
    align-self: flex-start;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 8px;
}

.info-card__rarity.common    { color: rgb(80,  80,  80);  background-color: rgba(158,158,158,0.18); }
.info-card__rarity.uncommon  { color: rgb(30,  90,  35);  background-color: rgba(76, 175, 80, 0.18); }
.info-card__rarity.rare      { color: rgb(15,  70, 140);  background-color: rgba(33, 150,243, 0.18); }
.info-card__rarity.epic      { color: rgb(90,  20, 110);  background-color: rgba(156, 39,176, 0.18); }
.info-card__rarity.legendary { color: rgb(140,  70,  5);  background-color: rgba(255,152,  0, 0.18); }

/* ── Роздільник ── */
.info-card__divider {
    height: 1px;
    background-color: rgba(184, 134, 11, 0.3);
    margin-top: 2px;
    margin-bottom: 2px;
    margin-left: 14px;
    margin-right: 14px;
}

/* ── Мета-рядки ── */
.info-card__meta-row {
    flex-direction: row;
    padding-top: 8px;
    padding-bottom: 4px;
    padding-left: 14px;
    padding-right: 14px;
}

.info-card__meta-item {
    flex-direction: column;
    flex-grow: 1;
    margin-right: 8px;
}

.info-card__meta-label {
    font-size: 8px;
    color: rgb(130, 95, 65);   /* --ink3 */
    letter-spacing: 2px;
    -unity-font-style: italic;
    margin-bottom: 2px;
}

.info-card__meta-value {
    font-size: 12px;
    color: rgb(28, 14, 6);     /* --ink */
    -unity-font-style: bold;
    white-space: normal;
}

/* ── Footer: ціна + кнопка ── */
.info-card__footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 14px;
    padding-right: 14px;
}

.info-card__price-block {
    flex-direction: column;
}

.info-card__price {
    font-size: 18px;
    color: rgb(100, 60, 5);
    -unity-font-style: bold;
}

.info-card__sell-btn {
    /* Перевизначаємо btn-primary для темного фону на світлій картці */
    background-color: rgba(28, 14, 6, 0.85);
    border-color: rgba(184, 134, 11, 0.5);
    border-width: 1px;
    border-radius: 5px;
    color: rgb(240, 192, 64);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    transition-duration: 0.12s;
}

.info-card__sell-btn:hover {
    background-color: rgb(28, 14, 6);
    border-color: rgb(240, 192, 64);
    scale: 1.03;
}

.info-card__sell-btn:active {
    scale: 0.97;
}

/* ── Опис ── */
.info-card__desc-block {
    padding-top: 6px;
    padding-bottom: 8px;
    padding-left: 14px;
    padding-right: 14px;
    border-top-color: rgba(184, 134, 11, 0.2);
    border-top-width: 1px;
}

.info-card__desc {
    font-size: 11px;
    color: rgb(80, 52, 30);    /* --ink2 */
    -unity-font-style: italic;
    white-space: normal;
}

/* ── Трейти ── */
.info-card__traits {
    flex-direction: row;
    flex-wrap: wrap;
    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 8px;
}

.trait-badge {
    font-size: 9px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 8px;
    margin-right: 4px;
    margin-bottom: 4px;
}

.trait-badge.disobedient {
    background-color: rgba(200, 30, 30, 0.15);
    color: rgb(180, 30, 30);
    border-color: rgba(200, 30, 30, 0.4);
    border-width: 1px;
}

.trait-badge.collection {
    background-color: rgba(184, 134, 11, 0.15);
    color: rgb(120, 80, 5);
    border-color: rgba(184, 134, 11, 0.4);
    border-width: 1px;
}

/* ── Колекція ── */
.info-card__collection {
    flex-direction: row;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 8px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(184, 134, 11, 0.1);
    border-top-color: rgba(184, 134, 11, 0.25);
    border-top-width: 1px;
}

.info-card__collection.hidden {
    display: none;
}

.info-card__collection-icon {
    font-size: 14px;
    margin-right: 6px;
}

.info-card__collection-name {
    font-size: 11px;
    color: rgb(100, 65, 10);
    -unity-font-style: italic;
    white-space: normal;
}
