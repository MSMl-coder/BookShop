/* =====================================================
   BookInfoCardStyles.uss — PAPER ARCHIVE
   Бібліотечна картка як на референсі
   ===================================================== */

.book-info-card {
    position: absolute;
    right: 0;
    top: 50%;
    translate: 0 -50%;

    width: 230px;
    background-color: rgb(244, 234, 208);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;

    flex-direction: column;
    overflow: hidden;
    rotate: 1.5deg;

    transition-property: translate, opacity, rotate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.book-info-card.visible {
    translate: 0 -50%;
    opacity: 1;
    rotate: 1.5deg;
}

.book-info-card.hidden {
    translate: 250px -50%;
    opacity: 0;
    rotate: 5deg;
}

/* Smyk-line зверху — кольоровий жанр */
.info-card__genre-bar {
    height: 6px;
    background-color: rgb(106, 74, 26);
}

.info-card__genre-bar.fantasy    { background-color: rgb(58, 64, 130); }
.info-card__genre-bar.horror     { background-color: rgb(140, 26,  26); }
.info-card__genre-bar.mystery    { background-color: rgb(50, 50,  80); }
.info-card__genre-bar.classic    { background-color: rgb(120, 72,  26); }
.info-card__genre-bar.scifi      { background-color: rgb(26, 90, 130); }
.info-card__genre-bar.biography  { background-color: rgb(50, 90,  40); }
.info-card__genre-bar.academic   { background-color: rgb(140, 110, 30); }

/* Header — назва + штамп рідкості */
.info-card__header {
    padding-top: 12px;
    padding-bottom: 8px;
    padding-left: 14px;
    padding-right: 14px;
    flex-direction: column;
}

.info-card__title {
    font-size: 13px;
    color: rgb(26, 26, 26);
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: normal;
    margin-bottom: 6px;
}

/* Рідкість як штамп */
.info-card__rarity {
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    align-self: flex-start;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 7px;
    padding-right: 7px;
    color: rgb(244, 234, 208);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
}

.info-card__rarity.common    { background-color: rgb(122, 117, 112); }
.info-card__rarity.uncommon  { background-color: rgb(42, 74, 42); }
.info-card__rarity.rare      { background-color: rgb(26, 58, 106); }
.info-card__rarity.epic      { background-color: rgb(90, 42, 106); }
.info-card__rarity.legendary { background-color: rgb(200, 64, 48); }

/* Розділювач — товстий чорний */
.info-card__divider {
    height: 1px;
    background-color: rgb(26, 26, 26);
    margin-left: 14px;
    margin-right: 14px;
    margin-top: 4px;
    margin-bottom: 4px;
}

/* Мета-рядки */
.info-card__meta-row {
    flex-direction: row;
    padding-top: 8px;
    padding-bottom: 4px;
    padding-left: 14px;
    padding-right: 14px;
}

.info-card__meta-item {
    flex-direction: column;
    flex-grow: 1;
    margin-right: 8px;
}

.info-card__meta-label {
    font-size: 8px;
    color: rgb(106, 74, 26);
    letter-spacing: 2px;
    margin-bottom: 2px;
}

.info-card__meta-value {
    font-size: 11px;
    color: rgb(26, 26, 26);
    -unity-font-style: bold;
    white-space: normal;
}

/* Footer — ціна + кнопка */
.info-card__footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 14px;
    padding-right: 14px;
    border-top-color: rgb(26, 26, 26);
    border-top-width: 1px;
    background-color: rgb(240, 226, 184);
}

.info-card__price-block {
    flex-direction: column;
}

.info-card__price {
    font-size: 16px;
    color: rgb(26, 74, 26);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* Sell button — червоний штамп */
.info-card__sell-btn {
    background-color: rgb(200, 64, 48);
    border-color: rgb(160, 40, 32);
    border-width: 1px;
    border-radius: 2px;
    color: rgb(244, 234, 208);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    transition-duration: 0.12s;
}

.info-card__sell-btn:hover {
    background-color: rgb(220, 76, 56);
    scale: 1.03;
}

.info-card__sell-btn:active { scale: 0.97; }

/* Опис */
.info-card__desc-block {
    padding-top: 6px;
    padding-bottom: 8px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(216, 180, 120, 0.2);
}

.info-card__desc {
    font-size: 11px;
    color: rgb(58, 42, 26);
    -unity-font-style: italic;
    white-space: normal;
}

/* Trait badges */
.info-card__traits {
    flex-direction: row;
    flex-wrap: wrap;
    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 8px;
}

.trait-badge {
    font-size: 9px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 7px;
    padding-right: 7px;
    margin-right: 4px;
    margin-bottom: 4px;
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    background-color: rgba(0, 0, 0, 0);
}

.trait-badge.disobedient {
    color: rgb(200, 64, 48);
    border-color: rgb(200, 64, 48);
    border-width: 2px;
}

.trait-badge.collection {
    color: rgb(106, 74, 26);
    border-color: rgb(106, 74, 26);
}

/* Collection footer */
.info-card__collection {
    flex-direction: row;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 8px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgb(216, 200, 152);
    border-top-color: rgb(26, 26, 26);
    border-top-width: 1px;
}

.info-card__collection.hidden { display: none; }

.info-card__collection-icon {
    font-size: 12px;
    margin-right: 6px;
    color: rgb(106, 74, 26);
}

.info-card__collection-name {
    font-size: 10px;
    color: rgb(58, 42, 26);
    -unity-font-style: italic;
    letter-spacing: 1px;
    white-space: normal;
}
