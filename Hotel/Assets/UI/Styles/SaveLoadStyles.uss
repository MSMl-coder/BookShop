/* =====================================================
   SaveLoadStyles.uss — PAPER ARCHIVE
   Слоти як manila папки в архівній шафі
   ===================================================== */

.saveload-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(40, 45, 30, 0.82);
    align-items: center;
    justify-content: center;
}

.saveload-overlay.hidden { display: none; }

.saveload-modal {
    width: 480px;
    background-color: rgb(244, 234, 208);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    border-radius: 2px;
    overflow: hidden;
    flex-direction: column;
    rotate: -0.3deg;
}

.saveload-modal__bar {
    height: 5px;
    background-color: rgb(200, 64, 48);
}

/* Header */
.saveload-modal__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    padding-bottom: 12px;
    padding-left: 22px;
    padding-right: 18px;
    border-bottom-color: rgb(26, 26, 26);
    border-bottom-width: 2px;
    background-color: rgb(240, 226, 184);
}

.saveload-modal__title {
    font-size: 16px;
    color: rgb(26, 26, 26);
    -unity-font-style: bold;
    letter-spacing: 5px;
}

/* Tabs */
.saveload-tabs {
    flex-direction: row;
    padding-top: 10px;
    padding-bottom: 0;
    padding-left: 16px;
    padding-right: 16px;
    border-bottom-color: rgb(138, 112, 64);
    border-bottom-width: 1px;
    background-color: rgb(216, 200, 152);
}

.saveload-tab {
    padding-top: 6px;
    padding-bottom: 8px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-bottom-width: 2px;
    color: rgb(106, 74, 26);
    font-size: 11px;
    letter-spacing: 2px;
    margin-right: 4px;
    transition-duration: 0.15s;
}

.saveload-tab:hover { color: rgb(26, 26, 26); }

.saveload-tab.active {
    color: rgb(26, 26, 26);
    border-bottom-color: rgb(200, 64, 48);
    border-bottom-width: 3px;
    -unity-font-style: bold;
}

/* Slot list */
.saveload-slots {
    flex-direction: column;
    padding-top: 14px;
    padding-bottom: 10px;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgb(216, 200, 152);
}

/* ══════════════════════════════════════════════════════
   SLOT — як manila папка
   ══════════════════════════════════════════════════════ */

.save-slot {
    flex-direction: row;
    align-items: center;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 14px;
    padding-right: 12px;
    background-color: rgb(216, 180, 120);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    border-radius: 1px;
    margin-bottom: 8px;
    transition-duration: 0.12s;
}

.save-slot:hover {
    background-color: rgb(220, 188, 130);
    translate: 2 0;
}

.save-slot.selected {
    background-color: rgb(232, 200, 150);
    border-color: rgb(200, 64, 48);
    border-width: 2px;
}

.save-slot.empty {
    background-color: rgb(216, 200, 152);
    opacity: 0.65;
}

/* Number badge — як штамп */
.save-slot__num {
    width: 32px;
    height: 32px;
    background-color: rgb(244, 234, 208);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    align-items: center;
    justify-content: center;
    margin-right: 14px;
}

.save-slot__num-label {
    font-size: 14px;
    color: rgb(26, 26, 26);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

/* Info */
.save-slot__info {
    flex-grow: 1;
    flex-direction: column;
}

.save-slot__name {
    font-size: 13px;
    color: rgb(26, 26, 26);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 2px;
}

.save-slot.empty .save-slot__name {
    color: rgb(80, 65, 50);
    -unity-font-style: italic;
}

.save-slot__date {
    font-size: 9px;
    color: rgb(106, 74, 26);
    -unity-font-style: italic;
    letter-spacing: 1px;
}

/* Action button */
.save-slot__btn {
    width: 32px;
    height: 32px;
    background-color: rgb(244, 234, 208);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    color: rgb(26, 26, 26);
    font-size: 14px;
    -unity-text-align: middle-center;
    transition-duration: 0.12s;
    margin-left: 6px;
}

.save-slot__btn:hover {
    background-color: rgb(200, 64, 48);
    color: rgb(244, 234, 208);
    border-color: rgb(160, 40, 32);
    scale: 1.06;
}

/* Delete */
.save-slot__del {
    width: 22px;
    height: 22px;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(200, 64, 48);
    border-width: 1px;
    color: rgb(200, 64, 48);
    font-size: 11px;
    -unity-text-align: middle-center;
    transition-duration: 0.12s;
    margin-left: 4px;
}

.save-slot__del:hover {
    background-color: rgb(200, 64, 48);
    color: rgb(244, 234, 208);
}

/* Confirm overlay */
.saveload-confirm {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(40, 45, 30, 0.92);
    align-items: center;
    justify-content: center;
    flex-direction: column;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 24px;
    padding-right: 24px;
}

.saveload-confirm.hidden { display: none; }

.saveload-confirm__text {
    font-size: 14px;
    color: rgb(244, 234, 208);
    -unity-text-align: middle-center;
    white-space: normal;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 8px;
}

.saveload-confirm__sub {
    font-size: 11px;
    color: rgb(216, 200, 152);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.saveload-confirm__btns {
    flex-direction: row;
    margin-top: 6px;
}

/* Footer */
.saveload-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 14px;
    padding-left: 16px;
    padding-right: 16px;
    border-top-color: rgb(26, 26, 26);
    border-top-width: 1px;
    background-color: rgb(240, 226, 184);
}

.saveload-hint {
    font-size: 10px;
    color: rgb(106, 74, 26);
    -unity-font-style: italic;
    letter-spacing: 1px;
}

.saveload-close-btn {
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    border-radius: 2px;
    color: rgb(26, 26, 26);
    font-size: 11px;
    letter-spacing: 2px;
    margin-right: 8px;
}

.saveload-close-btn:hover {
    background-color: rgb(216, 180, 120);
}

.saveload-action-btn {
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 22px;
    padding-right: 22px;
    background-color: rgb(200, 64, 48);
    border-color: rgb(160, 40, 32);
    border-width: 1px;
    border-radius: 2px;
    color: rgb(244, 234, 208);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    transition-duration: 0.12s;
}

.saveload-action-btn:hover {
    background-color: rgb(220, 76, 56);
    scale: 1.02;
}

.saveload-action-btn:disabled {
    opacity: 0.4;
    background-color: rgb(140, 100, 90);
}

.saveload-action-btn.danger {
    background-color: rgb(160, 40, 32);
}
