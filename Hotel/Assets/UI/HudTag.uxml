<?xml version="1.0" encoding="utf-8"?>
<!-- Assets/UI/HudTag.uxml
     Новий HUD: бірки + конверт + бонуси + тултіп
     Підключати поверх MainShopUI або як окремий UIDocument з sortOrder вище -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">

  <!-- ══════════════════════════════════════════════
       ROOT HUD LAYER — picking-mode Ignore скрізь
       де не потрібен клік
  ══════════════════════════════════════════════ -->
  <ui:VisualElement name="HudTagRoot" class="hud-tag-root" picking-mode="Ignore">

    <!-- ════ LEFT COLUMN: бірки + бонуси ════ -->
    <ui:VisualElement name="HudTagLeft" class="hud-tag-left">

      <!-- ── TAGS ROW ── -->
      <ui:VisualElement name="HudTagsRow" class="hud-tags-row">

        <!-- TAG A: гроші / день -->
        <ui:VisualElement name="TagAAssembly" class="tag-assembly">
          <ui:VisualElement name="TagAString" class="tag-string" picking-mode="Ignore"/>
          <!-- Flipper -->
          <ui:VisualElement name="TagAFlipper" class="tag-flipper">

            <!-- FRONT -->
            <ui:VisualElement name="TagAFace" class="tag-face tag-face--blue">
              <ui:VisualElement class="tag-border tag-border--outer"/>
              <ui:VisualElement class="tag-border tag-border--inner"/>
              <ui:VisualElement class="tag-accent-bar tag-accent-bar--blue"/>
              <ui:VisualElement name="TagAHole" class="tag-hole"/>
              <ui:Label name="TagABrand"  text="КНИГАРНЯ"       class="tag-brand"/>
              <ui:Label name="TagASeries" text="«Старий Архів»" class="tag-series"/>
              <ui:Label                   text="— ✦ —"          class="tag-ornament" picking-mode="Ignore"/>
              <ui:Label name="TagAAmount" text="0"              class="tag-amount"/>
              <ui:Label                   text="ГРИВЕНЬ"         class="tag-currency"/>
              <ui:VisualElement class="tag-divider"/>
              <ui:VisualElement class="tag-day-row">
                <ui:Label text="ДЕНЬ" class="tag-day-label"/>
                <ui:Label name="TagADay" text="1" class="tag-day-value"/>
              </ui:VisualElement>
            </ui:VisualElement>

            <!-- BACK -->
            <ui:VisualElement name="TagABack" class="tag-back">
              <ui:VisualElement class="tag-hole"/>
              <ui:Label text="СТАТУС КРАМНИЦІ" class="tag-back-title"/>
              <ui:VisualElement class="tag-back-row">
                <ui:Label text="Рівень"           class="tag-back-label"/>
                <ui:Label name="TagABackLevel"    class="tag-back-value" text="I"/>
              </ui:VisualElement>
              <ui:VisualElement class="tag-back-row">
                <ui:Label text="Назва"            class="tag-back-label"/>
                <ui:Label name="TagABackRank"     class="tag-back-value tag-back-value--small" text="Новачок"/>
              </ui:VisualElement>
              <ui:VisualElement class="tag-divider"/>
              <ui:Label text="Книжковий Клуб" class="tag-back-club-title"/>
              <ui:Label name="TagABackClubStars"   text="— не засновано —" class="tag-back-stars"/>
              <ui:VisualElement class="tag-back-row">
                <ui:Label text="Члени"                 class="tag-back-label"/>
                <ui:Label name="TagABackClubMembers"   class="tag-back-value" text=""/>
              </ui:VisualElement>
              <ui:Label text="натисни щоб перегорнути" class="tag-back-hint"/>
            </ui:VisualElement>

          </ui:VisualElement><!-- TagAFlipper -->
        </ui:VisualElement><!-- TagAAssembly -->

        <!-- TAG B: рівень / престиж (variant 2, приховується якщо showPrestigeTag=false) -->
        <ui:VisualElement name="TagBAssembly" class="tag-assembly">
          <ui:VisualElement name="TagBString" class="tag-string" picking-mode="Ignore"/>
          <ui:VisualElement name="TagBFlipper" class="tag-flipper">

            <!-- FRONT -->
            <ui:VisualElement name="TagBFace" class="tag-face tag-face--green">
              <ui:VisualElement class="tag-border tag-border--outer tag-border--green"/>
              <ui:VisualElement class="tag-border tag-border--inner tag-border--green"/>
              <ui:VisualElement class="tag-accent-bar tag-accent-bar--green"/>
              <ui:VisualElement class="tag-hole tag-hole--green"/>
              <ui:Label text="РІВЕНЬ"   class="tag-brand tag-brand--green"/>
              <ui:Label text="КРАМНИЦЯ" class="tag-series tag-series--green"/>
              <ui:Label name="TagBLevel" text="I"        class="tag-b-level"/>
              <ui:Label name="TagBRank"  text="НОВАЧОК"  class="tag-b-rank"/>
              <ui:VisualElement class="tag-divider tag-divider--green"/>
              <ui:Label text="ПРЕСТИЖ" class="tag-b-prestige-label"/>
              <ui:VisualElement class="tag-b-bar-bg">
                <ui:VisualElement name="TagBBarFill" class="tag-b-bar-fill"/>
              </ui:VisualElement>
              <ui:VisualElement class="tag-b-bar-row">
                <ui:Label name="TagBBarMin" text="0"    class="tag-b-bar-num"/>
                <ui:Label name="TagBBarMax" text="1000" class="tag-b-bar-num"/>
              </ui:VisualElement>
            </ui:VisualElement>

            <!-- BACK -->
            <ui:VisualElement name="TagBBack" class="tag-back tag-back--green">
              <ui:VisualElement class="tag-hole tag-hole--green"/>
              <ui:Label text="НАСТУПНИЙ РІВЕНЬ" class="tag-back-title tag-back-title--green"/>
              <ui:Label name="TagBBackNextInfo" text="" class="tag-b-next-info"/>
              <ui:Label text="натисни щоб перегорнути" class="tag-back-hint"/>
            </ui:VisualElement>

          </ui:VisualElement><!-- TagBFlipper -->
        </ui:VisualElement><!-- TagBAssembly -->

      </ui:VisualElement><!-- HudTagsRow -->

      <!-- ── BONUS STRIP (праворуч від бірок, вздовж верхнього краю) ── -->
      <ui:VisualElement name="BonusStrip" class="bonus-strip">
        <!-- Заповнюється динамічно з HudTagController.RebuildBonusStrip() -->
      </ui:VisualElement>

    </ui:VisualElement><!-- HudTagLeft -->

    <!-- ════ PHASE ENVELOPE — низ-ліво ════ -->
    <ui:VisualElement name="PhaseZone" class="phase-zone">

      <!-- Картки (під конвертом у DOM → z-index нижче) -->
      <ui:VisualElement name="PhaseCardsStack" class="phase-cards-stack" picking-mode="Ignore">

        <!-- Декоративна 2 (найглибша) -->
        <ui:VisualElement name="PhaseCardDec2" class="phase-card phase-card--dec2">
          <ui:VisualElement class="phase-card-inner">
            <ui:Label text="NOTES." class="phase-card-heading"/>
            <ui:VisualElement class="phase-lines">
              <ui:VisualElement class="phase-line-row">
                <ui:Label text="ФАЗА" class="phase-line-num"/>
                <ui:VisualElement class="phase-line-sep"/>
                <ui:Label text="НАГОРОДИ" class="phase-line-val phase-line-val--bold"/>
              </ui:VisualElement>
            </ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>

        <!-- Декоративна 1 -->
        <ui:VisualElement name="PhaseCardDec1" class="phase-card phase-card--dec1">
          <ui:VisualElement class="phase-card-inner">
            <ui:Label text="NOTES." class="phase-card-heading"/>
            <ui:VisualElement class="phase-lines">
              <ui:VisualElement class="phase-line-row">
                <ui:Label text="ФАЗА" class="phase-line-num"/>
                <ui:VisualElement class="phase-line-sep"/>
                <ui:Label text="ТОРГІВЛЯ" class="phase-line-val phase-line-val--bold"/>
              </ui:VisualElement>
            </ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>

        <!-- АКТИВНА картка -->
        <ui:VisualElement name="PhaseCardActive" class="phase-card phase-card--active">
          <ui:VisualElement class="phase-card-inner">
            <ui:Label text="NOTES." class="phase-card-heading"/>
            <ui:VisualElement class="phase-lines">
              <ui:VisualElement class="phase-line-row">
                <ui:Label text="ФАЗА"  class="phase-line-num"/>
                <ui:VisualElement class="phase-line-sep"/>
                <ui:Label name="PhaseCardName" text="ПІДГОТОВКА" class="phase-line-val phase-line-val--bold phase-line-val--blue"/>
              </ui:VisualElement>
              <ui:VisualElement class="phase-line-row">
                <ui:Label text="КРОК"  class="phase-line-num"/>
                <ui:VisualElement class="phase-line-sep"/>
                <ui:Label name="PhaseCardStep" text="1 з 3" class="phase-line-val"/>
              </ui:VisualElement>
              <ui:VisualElement class="phase-line-row">
                <ui:Label text="ЧАС"   class="phase-line-num"/>
                <ui:VisualElement class="phase-line-sep"/>
                <ui:Label name="PhaseCardTime" text="08:00" class="phase-line-val"/>
              </ui:VisualElement>
            </ui:VisualElement>
            <!-- Dots -->
            <ui:VisualElement class="phase-dots">
              <ui:VisualElement name="PhaseDot0" class="phase-dot phase-dot--active"/>
              <ui:VisualElement name="PhaseDot1" class="phase-dot"/>
              <ui:VisualElement name="PhaseDot2" class="phase-dot"/>
            </ui:VisualElement>
            <!-- Stamp -->
            <ui:Label name="PhaseCardStamp" text="ЗАКРИТО" class="phase-stamp stamp--prep"/>
          </ui:VisualElement>
        </ui:VisualElement>

      </ui:VisualElement><!-- PhaseCardsStack -->

      <!-- Конверт ПОВЕРХ карток -->
      <ui:VisualElement name="PhaseEnvelope" class="phase-envelope">
        <ui:VisualElement class="phase-envelope-string" picking-mode="Ignore"/>
        <ui:Label text="ФАЗИ ДНЯ" class="phase-envelope-label" picking-mode="Ignore"/>
      </ui:VisualElement>

    </ui:VisualElement><!-- PhaseZone -->

  </ui:VisualElement><!-- HudTagRoot -->

</ui:UXML>
