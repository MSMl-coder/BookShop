<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <ui:Template name="HudTag" src="project://database/Assets/UI/HudTag.uxml?fileID=9197481963319205126&amp;guid=5f8e334be8c0a472a9daec81b8a5f68b&amp;type=3#HudTag"/>
    <Style src="project://database/Assets/UI/Styles/BookshopTheme.uss?fileID=7433441132597879392&amp;guid=efb44dd65cdfb4cf3beb1f524f0141a4&amp;type=3#BookshopTheme"/>
    <Style src="project://database/Assets/UI/Styles/HUDStyles.uss?fileID=7433441132597879392&amp;guid=dedc834fd79aa4fbe98881ee50fec159&amp;type=3#HUDStyles"/>
    <Style src="project://database/Assets/UI/Styles/InventoryStyles.uss?fileID=7433441132597879392&amp;guid=c4b090d74adb3410c961284aa44ef032&amp;type=3#InventoryStyles"/>
    <Style src="project://database/Assets/UI/Styles/CabinetStyles.uss?fileID=7433441132597879392&amp;guid=e1f373e9a78fe46a993a3b05c43e1ab1&amp;type=3#CabinetStyles"/>
    <Style src="project://database/Assets/UI/Styles/BookInfoCardStyles.uss?fileID=7433441132597879392&amp;guid=546b6a8bc175440acb27b01e7d326b4e&amp;type=3#BookInfoCardStyles"/>
    <Style src="project://database/Assets/UI/Styles/DecorationStyles.uss?fileID=7433441132597879392&amp;guid=149d2757f709443ecb4a8b77fe396ff3&amp;type=3#DecorationStyles"/>
    <Style src="project://database/Assets/UI/Styles/PhaseButtonStyles.uss?fileID=7433441132597879392&amp;guid=18c8e793729644bda8b465ef93c05f9a&amp;type=3#PhaseButtonStyles"/>
    <Style src="project://database/Assets/UI/Styles/EndOfDayStyles.uss?fileID=7433441132597879392&amp;guid=384e909f6790e4ccab68ea6ec3752a9e&amp;type=3#EndOfDayStyles"/>
    <Style src="project://database/Assets/UI/Styles/SaveLoadStyles.uss?fileID=7433441132597879392&amp;guid=64a8a976d19544175b073a432df30816&amp;type=3#SaveLoadStyles"/>
    <Style src="project://database/Assets/UI/Styles/TutorialStyles.uss?fileID=7433441132597879392&amp;guid=5b5e3206bddca4b2a84a3897e1ecab6a&amp;type=3#TutorialStyles"/>
    <Style src="project://database/Assets/UI/Styles/DecorStickers.uss?fileID=7433441132597879392&amp;guid=00c8fe60b80644583ade971403fca434&amp;type=3#DecorStickers"/>
    <Style src="project://database/Assets/UI/Styles/HudTag.uss?fileID=7433441132597879392&amp;guid=b1a7cdd97f3aa454d92795625fcfd94c&amp;type=3#HudTag"/>
    <ui:VisualElement name="Root" picking-mode="Ignore" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; flex-direction: column;">
        <ui:VisualElement name="DecorStickers" picking-mode="Ignore" class="decor-stickers" style="display: flex; right: 93px; bottom: -3px;">
            <ui:Label name="StickerConfidential" text="CONFIDENTIAL" picking-mode="Ignore" class="sticker-confidential" style="display: none;"/>
            <ui:VisualElement name="StickerRegistered" picking-mode="Ignore" class="sticker-registered" style="display: none;">
                <ui:Label text="REGISTERED" class="sticker-registered__label"/>
                <ui:Label text="No. 2840" class="sticker-registered__num"/>
            </ui:VisualElement>
            <ui:VisualElement name="StickerFlightTag" picking-mode="Ignore" class="sticker-flight-tag" style="display: none;">
                <ui:Label text="FLIGHT" class="sticker-flight-tag__lbl"/>
                <ui:Label text="P-152" class="sticker-flight-tag__val"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="CabinetPanel" picking-mode="Position" class="cabinet-panel" style="display: none; top: 257px; width: 332px; bottom: 294px; right: 29px;">
            <ui:VisualElement class="cabinet-header">
                <ui:VisualElement>
                    <ui:Label text="ШАФИ" class="cabinet-title"/>
                    <ui:Label name="CabZoneLabel" text="Торговий зал" class="cabinet-zone-label"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="ШАФИ В МАГАЗИНІ" class="section-label"/>
            <ui:ScrollView name="CabinetList" mode="Vertical" horizontal-scroller-visibility="Hidden" mouse-wheel-scroll-size="40" picking-mode="Position" class="cabinet-list"/>
            <ui:Label text="ПОЛИЦІ" class="section-label"/>
            <ui:ScrollView name="ShelfList" mode="Vertical" horizontal-scroller-visibility="Hidden" mouse-wheel-scroll-size="40" picking-mode="Position" class="shelf-list"/>
            <ui:Label name="SelectedShelfLabel" text="Оберіть полицю" class="selected-shelf-label"/>
            <ui:VisualElement name="TransferRow" class="transfer-row">
                <ui:Button name="BtnPushOne" text="›" class="transfer-btn push"/>
                <ui:Button name="BtnPushAll" text="»" class="transfer-btn push"/>
                <ui:Button name="BtnPopOne" text="‹" class="transfer-btn pop"/>
                <ui:Button name="BtnPopAll" text="«" class="transfer-btn pop"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BookInfoCard" picking-mode="Ignore" class="book-info-card hidden" style="display: flex;">
            <ui:VisualElement name="InfoCardGenreBar" class="info-card__genre-bar"/>
            <ui:VisualElement class="info-card__header">
                <ui:Label name="InfoCardTitle" text="Назва книги" class="info-card__title"/>
                <ui:Label name="InfoCardRarity" text="ЗВИЧАЙНА" class="info-card__rarity common"/>
            </ui:VisualElement>
            <ui:VisualElement class="info-card__divider"/>
            <ui:VisualElement class="info-card__meta-row">
                <ui:VisualElement class="info-card__meta-item">
                    <ui:Label text="АВТОР" class="info-card__meta-label"/>
                    <ui:Label name="InfoCardAuthor" text="—" class="info-card__meta-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="info-card__meta-item">
                    <ui:Label text="РІК" class="info-card__meta-label"/>
                    <ui:Label name="InfoCardYear" text="—" class="info-card__meta-value"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="info-card__meta-row">
                <ui:VisualElement class="info-card__meta-item" style="flex-grow: 1;">
                    <ui:Label text="ЖАНР" class="info-card__meta-label"/>
                    <ui:Label name="InfoCardGenre" text="—" class="info-card__meta-value"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="info-card__divider"/>
            <ui:VisualElement class="info-card__footer">
                <ui:VisualElement class="info-card__price-block">
                    <ui:Label text="ЦІНА" class="info-card__meta-label"/>
                    <ui:Label name="InfoCardPrice" text="—" class="info-card__price"/>
                </ui:VisualElement>
                <ui:Button name="InfoCardSellBtn" text="ПРОДАТИ" class="info-card__sell-btn"/>
            </ui:VisualElement>
            <ui:VisualElement name="InfoCardDescBlock" class="info-card__desc-block">
                <ui:Label name="InfoCardDesc" text="" class="info-card__desc"/>
            </ui:VisualElement>
            <ui:VisualElement name="InfoCardTraits" class="info-card__traits"/>
            <ui:VisualElement name="InfoCardCollectionBlock" class="info-card__collection hidden">
                <ui:Label text="📚" class="info-card__collection-icon"/>
                <ui:Label name="InfoCardCollectionName" text="" class="info-card__collection-name"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="DecorationPanel" picking-mode="Position" class="decoration-panel" style="display: none; bottom: 268px; width: 744px; top: 214px;">
            <ui:VisualElement class="deco-header">
                <ui:VisualElement class="deco-header__left">
                    <ui:Label text="ДЕКОР" class="deco-title"/>
                    <ui:Label name="DecoUnlockedCount" text="0 предметів" class="deco-subtitle"/>
                </ui:VisualElement>
                <ui:Button name="BtnCloseDecoration" text="✕" class="deco-close-btn btn-icon"/>
            </ui:VisualElement>
            <ui:VisualElement class="deco-filter-row">
                <ui:Button name="DecoFilterAll" text="Всі" class="deco-filter-btn active"/>
                <ui:Button name="DecoFilterShelf" text="Полиці" class="deco-filter-btn"/>
                <ui:Button name="DecoFilterIsland" text="Острів" class="deco-filter-btn"/>
                <ui:Button name="DecoFilterDecor" text="Декор" class="deco-filter-btn"/>
                <ui:Button name="DecoFilterPlaced" text="В залі" class="deco-filter-btn"/>
            </ui:VisualElement>
            <ui:VisualElement class="deco-body">
                <ui:ScrollView name="DecoGrid" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" mouse-wheel-scroll-size="60" picking-mode="Position" class="deco-grid"/>
                <ui:VisualElement name="DecoDetailPanel" class="deco-detail">
                    <ui:VisualElement name="DecoDetailEmpty" class="deco-detail__empty">
                        <ui:Label text="🪑" class="deco-detail__empty-icon"/>
                        <ui:Label text="Оберіть предмет" class="deco-detail__empty-text"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="DecoDetailContent" class="deco-detail__content hidden">
                        <ui:VisualElement name="DecoDetailIcon" class="deco-detail__icon"/>
                        <ui:Label name="DecoDetailName" text="" class="deco-detail__name"/>
                        <ui:Label name="DecoDetailClass" text="" class="deco-detail__class"/>
                        <ui:VisualElement class="deco-detail__divider"/>
                        <ui:VisualElement name="DecoDetailBonusBlock" class="deco-detail__bonus-block">
                            <ui:Label text="БОНУС" class="deco-detail__section-label"/>
                            <ui:Label name="DecoDetailBonus" text="" class="deco-detail__bonus"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="DecoDetailUnlockBlock" class="deco-detail__unlock-block hidden">
                            <ui:Label text="ЯК ОТРИМАТИ" class="deco-detail__section-label"/>
                            <ui:Label name="DecoDetailUnlock" text="" class="deco-detail__unlock"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="DecoDetailSetBlock" class="deco-detail__set-block hidden">
                            <ui:Label text="НАБІР" class="deco-detail__section-label"/>
                            <ui:Label name="DecoDetailSetName" text="" class="deco-detail__set-name"/>
                            <ui:VisualElement name="DecoSetProgress" class="deco-detail__set-progress"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="deco-detail__divider"/>
                        <ui:Button name="DecoActionBtn" text="РОЗМІСТИТИ" class="deco-action-btn btn-stamp"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="PhaseWidget" picking-mode="Position" class="phase-widget" style="display: none;">
            <ui:VisualElement class="phase-indicator">
                <ui:VisualElement class="phase-indicator__dots">
                    <ui:VisualElement name="PhaseDot0" class="phase-dot active"/>
                    <ui:VisualElement name="PhaseDot1" class="phase-dot"/>
                    <ui:VisualElement name="PhaseDot2" class="phase-dot"/>
                </ui:VisualElement>
                <ui:Label name="PhaseIndicatorLabel" text="ПІДГОТОВКА" class="phase-indicator__label"/>
            </ui:VisualElement>
            <ui:VisualElement class="phase-widget__sep"/>
            <ui:Button name="PhaseMainBtn" text="ВІДКРИТИ МАГАЗИН" class="phase-main-btn open-shop"/>
            <ui:VisualElement class="phase-widget__sep"/>
            <ui:Label name="PhaseTimer" text="" class="phase-timer"/>
        </ui:VisualElement>
        <ui:VisualElement name="HUDActions" picking-mode="Position" class="hud-actions" style="display: flex;">
            <ui:Button name="BtnOpenInventory" text="📦" class="hud-action-btn"/>
            <ui:Button name="BtnOpenDecoration" text="🪑" class="hud-action-btn"/>
            <ui:Button name="BtnSettings" text="⚙" class="hud-action-btn"/>
            <ui:Button name="BtnEditMode" text="✏️" class="hud-btn"/>
        </ui:VisualElement>
        <ui:VisualElement name="UpgradeOverlay" picking-mode="Position" class="upgrade-overlay hidden" style="display: none;">
            <ui:VisualElement picking-mode="Position" class="upgrade-modal">
                <ui:VisualElement class="upgrade-modal__top-bar"/>
                <ui:VisualElement class="upgrade-modal__header">
                    <ui:VisualElement>
                        <ui:Label text="АПГРЕЙД" class="upgrade-modal__title"/>
                        <ui:Label name="UpgradeSlotName" text="" class="upgrade-modal__slot-name"/>
                    </ui:VisualElement>
                    <ui:Button name="UpgradeBtnClose" text="✕" class="btn-icon"/>
                </ui:VisualElement>
                <ui:VisualElement class="upgrade-modal__body">
                    <ui:VisualElement class="upgrade-current">
                        <ui:Label text="ЗАРАЗ" class="upgrade-current__label"/>
                        <ui:VisualElement name="UpgradeCurrentIcon" class="upgrade-current__icon"/>
                        <ui:Label name="UpgradeCurrentName" text="—" class="upgrade-current__name"/>
                        <ui:Label name="UpgradeCurrentClass" text="" class="upgrade-current__class"/>
                    </ui:VisualElement>
                    <ui:Label text="→" class="upgrade-arrow"/>
                    <ui:VisualElement class="upgrade-options">
                        <ui:Label text="ДОСТУПНІ АПГРЕЙДИ" class="upgrade-options__label"/>
                        <ui:ScrollView name="UpgradeOptionsList" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" mouse-wheel-scroll-size="40" style="max-height: 240px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="upgrade-modal__footer">
                    <ui:Button name="UpgradeBtnCancel" text="СКАСУВАТИ" class="upgrade-cancel-btn"/>
                    <ui:Button name="UpgradeBtnConfirm" text="ВСТАНОВИТИ" class="upgrade-confirm-btn"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="EndDayPanel" picking-mode="Position" class="end-day-panel" style="display: none; height: 522px; width: 715px; position: absolute; top: 277px; left: 759px;">
            <ui:VisualElement class="end-day-title-block">
                <ui:Label text="КІНЕЦЬ ДНЯ" class="end-day-title"/>
                <ui:Label name="EndDaySubtitle" text="День 1" class="end-day-subtitle"/>
            </ui:VisualElement>
            <ui:Label name="PicksLabel" text="Виборів залишилось: 3" class="picks-remaining"/>
            <ui:VisualElement class="end-day-stats">
                <ui:VisualElement class="stat-chip">
                    <ui:Label text="ПРОДАНО" class="stat-chip__label"/>
                    <ui:Label name="StatBooks" text="0" class="stat-chip__value"/>
                </ui:VisualElement>
                <ui:VisualElement class="stat-chip">
                    <ui:Label text="ЗАРОБЛЕНО" class="stat-chip__label"/>
                    <ui:Label name="StatMoney" text="0 грн" class="stat-chip__value"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="LootContainer" class="loot-cards-row"/>
            <ui:Button name="BtnSkipLoot" text="ПРОПУСТИТИ НАГОРОДИ" class="btn-paper" style="margin-top: 16px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="SaveLoadOverlay" picking-mode="Position" class="saveload-overlay hidden" style="display: none;">
            <ui:VisualElement picking-mode="Position" class="saveload-modal" style="position: relative;">
                <ui:VisualElement class="saveload-modal__bar"/>
                <ui:VisualElement class="saveload-modal__header">
                    <ui:Label name="SaveLoadTitle" text="ЗБЕРЕЖЕННЯ" class="saveload-modal__title"/>
                    <ui:Button name="SaveLoadCloseX" text="✕" class="btn-icon"/>
                </ui:VisualElement>
                <ui:VisualElement class="saveload-tabs">
                    <ui:Button name="TabSave" text="ЗБЕРЕГТИ" class="saveload-tab active"/>
                    <ui:Button name="TabLoad" text="ЗАВАНТАЖИТИ" class="saveload-tab"/>
                </ui:VisualElement>
                <ui:VisualElement name="SaveLoadSlots" class="saveload-slots">
                    <ui:VisualElement name="Slot0" class="save-slot empty">
                        <ui:VisualElement class="save-slot__num">
                            <ui:Label text="1" class="save-slot__num-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="save-slot__info">
                            <ui:Label name="Slot0Name" text="Порожній слот" class="save-slot__name"/>
                            <ui:Label name="Slot0Date" text="" class="save-slot__date"/>
                        </ui:VisualElement>
                        <ui:Button name="Slot0Del" text="✕" class="save-slot__del" style="display: none;"/>
                        <ui:Button name="Slot0Btn" text="💾" class="save-slot__btn"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="Slot1" class="save-slot empty">
                        <ui:VisualElement class="save-slot__num">
                            <ui:Label text="2" class="save-slot__num-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="save-slot__info">
                            <ui:Label name="Slot1Name" text="Порожній слот" class="save-slot__name"/>
                            <ui:Label name="Slot1Date" text="" class="save-slot__date"/>
                        </ui:VisualElement>
                        <ui:Button name="Slot1Del" text="✕" class="save-slot__del" style="display: none;"/>
                        <ui:Button name="Slot1Btn" text="💾" class="save-slot__btn"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="Slot2" class="save-slot empty">
                        <ui:VisualElement class="save-slot__num">
                            <ui:Label text="3" class="save-slot__num-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="save-slot__info">
                            <ui:Label name="Slot2Name" text="Порожній слот" class="save-slot__name"/>
                            <ui:Label name="Slot2Date" text="" class="save-slot__date"/>
                        </ui:VisualElement>
                        <ui:Button name="Slot2Del" text="✕" class="save-slot__del" style="display: none;"/>
                        <ui:Button name="Slot2Btn" text="💾" class="save-slot__btn"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="saveload-footer">
                    <ui:Label name="SaveLoadHint" text="Оберіть слот" class="saveload-hint"/>
                    <ui:Button name="SaveLoadClose" text="ЗАКРИТИ" class="saveload-close-btn"/>
                </ui:VisualElement>
                <ui:VisualElement name="ConfirmOverlay" class="saveload-confirm hidden">
                    <ui:Label name="ConfirmText" text="" class="saveload-confirm__text"/>
                    <ui:Label name="ConfirmSub" text="" class="saveload-confirm__sub"/>
                    <ui:VisualElement class="saveload-confirm__btns">
                        <ui:Button name="ConfirmYes" text="ТАК" class="saveload-action-btn danger"/>
                        <ui:Button name="ConfirmNo" text="СКАСУВАТИ" class="saveload-close-btn"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="TutorialBubble" picking-mode="Position" class="tutorial-bubble" style="display: none;">
            <ui:Label text="💡" class="tutorial-bubble__icon"/>
            <ui:Label name="TutorialMessage" text="" class="tutorial-bubble__text"/>
            <ui:Button name="TutorialOK" text="ЗРОЗУМІЛО" class="tutorial-ok-btn"/>
        </ui:VisualElement>
        <ui:VisualElement name="InventoryPanel" picking-mode="Position" class="inventory-panel" style="display: none; bottom: 357px; top: 323px; left: 28px;">
            <ui:VisualElement class="inventory-header">
                <ui:Label text="ІНВЕНТАР" class="inventory-title"/>
                <ui:Label name="InvCount" text="0 книг" class="inventory-count"/>
                <ui:VisualElement class="sort-tabs-row">
                    <ui:Button name="BtnSortTitle" text="Назва" class="sort-tab active"/>
                    <ui:Button name="BtnSortAuthor" text="Автор" class="sort-tab"/>
                    <ui:Button name="BtnSortPrice" text="Ціна" class="sort-tab"/>
                    <ui:Button name="BtnSortGenre" text="Жанр" class="sort-tab"/>
                    <ui:Button name="BtnSortRarity" text="Рідкість" class="sort-tab"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="InventoryGrid" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" mouse-wheel-scroll-size="60" touch-scroll-type="Elastic" picking-mode="Position" class="inventory-grid"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Instance template="HudTag" name="HudTagInstance" picking-mode="Ignore" style="height: 100%; position: relative; bottom: auto; top: auto;"/>
</ui:UXML>
