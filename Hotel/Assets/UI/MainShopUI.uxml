<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/BookshopTheme.uss?fileID=7433441132597879392&amp;guid=efb44dd65cdfb4cf3beb1f524f0141a4&amp;type=3#BookshopTheme"/>
    <Style src="project://database/Assets/UI/Styles/HUDStyles.uss?fileID=7433441132597879392&amp;guid=dedc834fd79aa4fbe98881ee50fec159&amp;type=3#HUDStyles"/>
    <Style src="project://database/Assets/UI/Styles/InventoryStyles.uss?fileID=7433441132597879392&amp;guid=c4b090d74adb3410c961284aa44ef032&amp;type=3#InventoryStyles"/>
    <Style src="project://database/Assets/UI/Styles/CabinetStyles.uss?fileID=7433441132597879392&amp;guid=e1f373e9a78fe46a993a3b05c43e1ab1&amp;type=3#CabinetStyles"/>
    <Style src="project://database/Assets/UI/Styles/EndOfDayStyles.uss?fileID=7433441132597879392&amp;guid=384e909f6790e4ccab68ea6ec3752a9e&amp;type=3#EndOfDayStyles"/>
    <Style src="project://database/Assets/UI/Styles/TutorialStyles.uss?fileID=7433441132597879392&amp;guid=5b5e3206bddca4b2a84a3897e1ecab6a&amp;type=3#TutorialStyles"/>
    <ui:VisualElement name="Root" picking-mode="Ignore" style="flex-grow: 1; position: absolute; top: 0; left: 0; right: 0; bottom: 0;">
        <ui:VisualElement name="HUDBar" class="hud-bar">
            <ui:VisualElement name="HUDLeft" style="flex-direction: row; align-items: center;">
                <ui:VisualElement name="ClockWidget" class="hud-clock" style="margin-right: 12px;">
                    <ui:Label name="DayLabel" text="ДЕНЬ 1" class="hud-clock__day"/>
                    <ui:Label name="PhaseLabel" text="ПІДГОТОВКА" class="hud-clock__phase"/>
                </ui:VisualElement>
                <ui:VisualElement name="WalletWidget" class="hud-wallet">
                    <ui:Label text="💰" class="hud-wallet__icon"/>
                    <ui:Label name="MoneyLabel" text="500" class="hud-wallet__amount"/>
                    <ui:Label name="CurrencyLabel" text="грн" class="hud-wallet__currency"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="PrestigeWidget" class="hud-prestige">
                <ui:Label text="ПРЕСТИЖ" class="hud-prestige__label"/>
                <ui:VisualElement class="hud-prestige__bar-bg">
                    <ui:VisualElement name="PrestigeBarFill" class="hud-prestige__bar-fill" style="width: 30%;"/>
                </ui:VisualElement>
                <ui:Label name="PrestigeValue" text="120 / 1000" class="hud-prestige__value"/>
            </ui:VisualElement>
            <ui:Button name="BtnSettings" text="⚙" class="btn-icon"/>
        </ui:VisualElement>
        <ui:VisualElement name="InventoryPanel" class="inventory-panel" style="display: none;">
            <ui:VisualElement class="inventory-header">
                <ui:Label text="ІНВЕНТАР" class="inventory-title"/>
                <ui:Label name="InvCount" text="0 книг" class="inventory-count"/>
                <ui:VisualElement class="sort-tabs-row">
                    <ui:Button name="BtnSortTitle" text="Назва" class="sort-tab active"/>
                    <ui:Button name="BtnSortAuthor" text="Автор" class="sort-tab"/>
                    <ui:Button name="BtnSortPrice" text="Ціна" class="sort-tab"/>
                    <ui:Button name="BtnSortGenre" text="Жанр" class="sort-tab"/>
                    <ui:Button name="BtnSortRarity" text="Рідкість" class="sort-tab"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="InventoryGrid" mode="Vertical" class="inventory-grid"/>
        </ui:VisualElement>
        <ui:VisualElement name="CabinetPanel" class="cabinet-panel" style="display: none;">
            <ui:VisualElement class="cabinet-header">
                <ui:Label text="ШАФИ" class="cabinet-title"/>
                <ui:Label name="CabZoneLabel" text="Торговий зал" class="cabinet-zone-label"/>
            </ui:VisualElement>
            <ui:Label text="ШАФИ" class="panel-section-label"/>
            <ui:ScrollView name="CabinetList" mode="Vertical" class="cabinet-list"/>
            <ui:Label text="ПОЛИЦІ" class="panel-section-label"/>
            <ui:ScrollView name="ShelfList" mode="Vertical" class="shelf-list"/>
            <ui:Label name="SelectedShelfLabel" text="Оберіть шафу та полицю" class="selected-shelf-label"/>
            <ui:VisualElement name="TransferRow" class="transfer-row">
                <ui:Button name="BtnPushOne" text="›" tooltip="Покласти одну книгу" class="transfer-btn push"/>
                <ui:Button name="BtnPushAll" text="»" tooltip="Покласти всі книги" class="transfer-btn push"/>
                <ui:Button name="BtnPopOne" text="‹" tooltip="Забрати одну книгу" class="transfer-btn pop"/>
                <ui:Button name="BtnPopAll" text="«" tooltip="Забрати всі книги" class="transfer-btn pop"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BookInfoCard" class="book-info-card">
            <ui:Label name="BiTitle" text="Назва книги" class="book-info-card__title"/>
            <ui:Label name="BiAuthor" text="Автор" class="book-info-card__author"/>
            <ui:VisualElement class="book-info-card__divider"/>
            <ui:VisualElement class="book-info-card__row">
                <ui:Label text="Рік" class="book-info-card__key"/>
                <ui:Label name="BiYear" text="—" class="book-info-card__value"/>
            </ui:VisualElement>
            <ui:VisualElement class="book-info-card__row">
                <ui:Label text="Жанр" class="book-info-card__key"/>
                <ui:Label name="BiGenre" text="—" class="book-info-card__value"/>
            </ui:VisualElement>
            <ui:VisualElement class="book-info-card__row">
                <ui:Label text="Рідкість" class="book-info-card__key"/>
                <ui:Label name="BiRarity" text="—" class="book-info-card__value book-info-card__rarity"/>
            </ui:VisualElement>
            <ui:VisualElement class="book-info-card__row">
                <ui:Label text="Розмір" class="book-info-card__key"/>
                <ui:Label name="BiSize" text="—" class="book-info-card__value"/>
            </ui:VisualElement>
            <ui:VisualElement class="book-info-card__divider"/>
            <ui:Label name="BiPrice" text="— грн" class="book-info-card__price"/>
        </ui:VisualElement>
        <ui:VisualElement name="EndDayPanel" picking-mode="Ignore" class="end-day-panel">
            <ui:VisualElement class="end-day-title-block">
                <ui:Label name="EndDayTitle" text="ДЕНЬ ЗАВЕРШЕНО" class="end-day-title"/>
                <ui:Label name="EndDaySubtitle" text="День 1" class="end-day-subtitle"/>
            </ui:VisualElement>
            <ui:VisualElement class="end-day-stats">
                <ui:VisualElement class="stat-chip">
                    <ui:Label text="ПРОДАНО КНИГ" class="stat-chip__label"/>
                    <ui:Label name="StatBooks" text="0" class="stat-chip__value"/>
                </ui:VisualElement>
                <ui:VisualElement class="stat-chip">
                    <ui:Label text="ЗАРОБЛЕНО" class="stat-chip__label"/>
                    <ui:Label name="StatMoney" text="0 грн" class="stat-chip__value"/>
                </ui:VisualElement>
                <ui:VisualElement class="stat-chip">
                    <ui:Label text="ВІДВІДУВАЧІВ" class="stat-chip__label"/>
                    <ui:Label name="StatVisitors" text="0" class="stat-chip__value"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="PicksLabel" text="Виборів залишилось: 3" class="picks-remaining"/>
            <ui:VisualElement name="LootContainer" class="loot-cards-row"/>
            <ui:Label text="Оберіть нагороди та розпочніть новий день" class="end-day-hint"/>
        </ui:VisualElement>
        <ui:VisualElement name="TutorialBubble" class="tutorial-bubble">
            <ui:Label name="TutorialIcon" text="📖" class="tutorial-bubble__icon"/>
            <ui:Label name="TutorialText" text="Підказка з&apos;явиться тут." class="tutorial-bubble__text"/>
            <ui:Button name="TutorialOkBtn" text="Зрозуміло!" class="tutorial-ok-btn"/>
        </ui:VisualElement>
        <ui:VisualElement name="HUDActions" class="hud-actions">
            <ui:Button name="BtnOpenInventory" text="📦" tooltip="Інвентар" class="hud-action-btn"/>
            <ui:Button name="BtnOpenJournal" text="📋" tooltip="Щоденник" class="hud-action-btn"/>
        </ui:VisualElement>
        <ui:VisualElement name="HUDNav" class="hud-nav">
            <ui:Button name="NavTabShop" text="Крамниця" class="hud-nav-tab active"/>
            <ui:Button name="NavTabCatalog" text="Каталог" class="hud-nav-tab"/>
            <ui:Button name="NavTabOrders" text="Замовлення" class="hud-nav-tab"/>
            <ui:Button name="NavTabCollections" text="Колекції" class="hud-nav-tab"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
