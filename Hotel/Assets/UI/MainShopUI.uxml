<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/BookshopTheme.uss?fileID=7433441132597879392&amp;guid=efb44dd65cdfb4cf3beb1f524f0141a4&amp;type=3#BookshopTheme"/>
    <Style src="project://database/Assets/UI/Styles/HUDStyles.uss?fileID=7433441132597879392&amp;guid=dedc834fd79aa4fbe98881ee50fec159&amp;type=3#HUDStyles"/>
    <Style src="project://database/Assets/UI/Styles/InventoryStyles.uss?fileID=7433441132597879392&amp;guid=c4b090d74adb3410c961284aa44ef032&amp;type=3#InventoryStyles"/>
    <Style src="project://database/Assets/UI/Styles/CabinetStyles.uss?fileID=7433441132597879392&amp;guid=e1f373e9a78fe46a993a3b05c43e1ab1&amp;type=3#CabinetStyles"/>
    <ui:VisualElement name="Root" picking-mode="Ignore" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0;">
        <ui:VisualElement name="HUDBar" picking-mode="Position" class="hud-bar">
            <ui:VisualElement style="flex-direction: row; align-items: center;">
                <ui:VisualElement class="hud-chip">
                    <ui:Label name="DayLabel" text="ДЕНЬ 1" class="hud-clock__day"/>
                    <ui:Label name="PhaseLabel" text="ПІДГОТОВКА" class="hud-clock__phase"/>
                </ui:VisualElement>
                <ui:VisualElement class="hud-chip">
                    <ui:Label text="💰" class="hud-wallet__icon"/>
                    <ui:Label name="MoneyLabel" text="500" class="hud-wallet__amount"/>
                    <ui:Label name="CurrencyLabel" text="грн" class="hud-wallet__currency"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="PrestigeWidget" class="hud-prestige">
                <ui:Label text="ПРЕСТИЖ" class="hud-prestige__label"/>
                <ui:VisualElement class="hud-prestige__bar-bg">
                    <ui:VisualElement name="PrestigeBarFill" class="hud-prestige__bar-fill" style="width: 12%;"/>
                </ui:VisualElement>
                <ui:Label name="PrestigeValue" text="120 / 1000" class="hud-prestige__value"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row;">
                <ui:Button name="BtnSettings" text="⚙" class="btn-icon"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="InventoryPanel" picking-mode="Position" class="inventory-panel" style="display: none;">
            <ui:VisualElement class="inventory-header">
                <ui:Label text="ІНВЕНТАР" class="inventory-title"/>
                <ui:Label name="InvCount" text="0 книг" class="inventory-count"/>
                <ui:VisualElement class="sort-tabs-row">
                    <ui:Button name="BtnSortTitle" text="Назва" class="sort-tab active"/>
                    <ui:Button name="BtnSortAuthor" text="Автор" class="sort-tab"/>
                    <ui:Button name="BtnSortPrice" text="Ціна" class="sort-tab"/>
                    <ui:Button name="BtnSortGenre" text="Жанр" class="sort-tab"/>
                    <ui:Button name="BtnSortRarity" text="Рідкість" class="sort-tab"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="InventoryGrid" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" mouse-wheel-scroll-size="60" touch-scroll-type="Elastic" picking-mode="Position" class="inventory-grid"/>
        </ui:VisualElement>
        <ui:VisualElement name="CabinetPanel" picking-mode="Position" class="cabinet-panel" style="display: none; height: 770px; position: absolute; top: 298px; left: 1693px; width: 351px; background-color: rgb(84, 77, 77);">
            <ui:VisualElement class="cabinet-header" style="background-color: rgb(152, 131, 131); -unity-font-style: bold; -unity-text-align: upper-center;">
                <ui:Label text="ШАФИ" class="cabinet-title"/>
                <ui:Label name="CabZoneLabel" text="Торговий зал" class="cabinet-zone-label"/>
            </ui:VisualElement>
            <ui:Label text="ШАФИ В МАГАЗИНІ" name="Label" class="section-label" style="align-items: auto; -unity-text-align: upper-center; -unity-font-style: bold;"/>
            <ui:ScrollView name="CabinetList" mode="Vertical" horizontal-scroller-visibility="Hidden" mouse-wheel-scroll-size="40" picking-mode="Position" class="cabinet-list" style="height: 140px; -unity-background-image-tint-color: rgb(197, 197, 197);"/>
            <ui:Label text="ПОЛИЦІ" class="section-label" style="-unity-text-align: upper-center; -unity-font-style: bold; -unity-text-outline-width: 0;"/>
            <ui:ScrollView name="ShelfList" mode="Vertical" horizontal-scroller-visibility="Hidden" mouse-wheel-scroll-size="40" picking-mode="Position" class="shelf-list" style="height: 252px;"/>
            <ui:Label name="SelectedShelfLabel" text="Оберіть полицю" class="selected-shelf-label" style="height: 89px;"/>
            <ui:VisualElement name="TransferRow" class="transfer-row" style="bottom: 0;">
                <ui:Button name="BtnPushOne" text="›" tooltip="Покласти одну книгу" class="transfer-btn push"/>
                <ui:Button name="BtnPushAll" text="»" tooltip="Покласти всі" class="transfer-btn push"/>
                <ui:Button name="BtnPopOne" text="‹" tooltip="Забрати одну" class="transfer-btn pop"/>
                <ui:Button name="BtnPopAll" text="«" tooltip="Забрати всі" class="transfer-btn pop"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="HUDActions" picking-mode="Ignore" class="hud-actions">
            <ui:Button name="BtnOpenInventory" text="📦" tooltip="Інвентар" class="hud-action-btn"/>
            <ui:Button name="BtnOpenJournal" text="📋" tooltip="Щоденник" class="hud-action-btn"/>
        </ui:VisualElement>
        <ui:VisualElement name="HUDNav" picking-mode="Position" class="hud-nav">
            <ui:Button name="NavTabShop" text="Крамниця" class="hud-nav-tab active"/>
            <ui:Button name="NavTabCatalog" text="Каталог" class="hud-nav-tab"/>
            <ui:Button name="NavTabOrders" text="Замовлення" class="hud-nav-tab"/>
            <ui:Button name="NavTabCollections" text="Колекції" class="hud-nav-tab"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
