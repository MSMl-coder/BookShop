<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         editor-extension-mode="False">

    <Style src="project://database/Assets/UI/Styles/BookshopTheme.uss"/>
    <Style src="project://database/Assets/UI/Styles/HUDStyles.uss"/>
    <Style src="project://database/Assets/UI/Styles/InventoryStyles.uss"/>
    <Style src="project://database/Assets/UI/Styles/CabinetStyles.uss"/>

    <!--
        КЛЮЧОВЕ ВИПРАВЛЕННЯ #1:
        Root має picking-mode="Ignore" — це означає що кліки проходять
        крізь нього у 3D-сцену. Кожен дочірній елемент явно встановлює
        picking-mode="Position" щоб ловити свої кліки.
    -->
    <ui:VisualElement name="Root" picking-mode="Ignore"
        style="position:absolute; top:0; left:0; right:0; bottom:0;">

        <!-- ════════════════════════════════════════
             HUD TOP BAR — ловить кліки
             ════════════════════════════════════════ -->
        <ui:VisualElement name="HUDBar" picking-mode="Position" class="hud-bar">

            <ui:VisualElement style="flex-direction: row; align-items: center;">
                <!-- Календар / годинник -->
                <ui:VisualElement class="hud-chip">
                    <ui:Label name="DayLabel"   text="ДЕНЬ 1"     class="hud-clock__day"/>
                    <ui:Label name="PhaseLabel" text="ПІДГОТОВКА" class="hud-clock__phase"/>
                </ui:VisualElement>

                <!-- Гаманець -->
                <ui:VisualElement class="hud-chip">
                    <ui:Label text="💰" class="hud-wallet__icon"/>
                    <ui:Label name="MoneyLabel"    text="500" class="hud-wallet__amount"/>
                    <ui:Label name="CurrencyLabel" text="грн" class="hud-wallet__currency"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Престиж посередині -->
            <ui:VisualElement name="PrestigeWidget" class="hud-prestige">
                <ui:Label text="ПРЕСТИЖ" class="hud-prestige__label"/>
                <ui:VisualElement class="hud-prestige__bar-bg">
                    <ui:VisualElement name="PrestigeBarFill" class="hud-prestige__bar-fill"
                        style="width: 12%;"/>
                </ui:VisualElement>
                <ui:Label name="PrestigeValue" text="120 / 1000" class="hud-prestige__value"/>
            </ui:VisualElement>

            <ui:VisualElement style="flex-direction: row;">
                <ui:Button name="BtnSettings" text="⚙" class="btn-icon"/>
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ════════════════════════════════════════
             INVENTORY PANEL (ліва) — ловить кліки
             ════════════════════════════════════════ -->
        <ui:VisualElement name="InventoryPanel" picking-mode="Position"
            class="inventory-panel" style="display: none;">

            <ui:VisualElement class="inventory-header">
                <ui:Label text="ІНВЕНТАР" class="inventory-title"/>
                <ui:Label name="InvCount" text="0 книг" class="inventory-count"/>

                <ui:VisualElement class="sort-tabs-row">
                    <ui:Button name="BtnSortTitle"  text="Назва"    class="sort-tab active"/>
                    <ui:Button name="BtnSortAuthor" text="Автор"    class="sort-tab"/>
                    <ui:Button name="BtnSortPrice"  text="Ціна"     class="sort-tab"/>
                    <ui:Button name="BtnSortGenre"  text="Жанр"     class="sort-tab"/>
                    <ui:Button name="BtnSortRarity" text="Рідкість" class="sort-tab"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <!--
                КЛЮЧОВЕ ВИПРАВЛЕННЯ #2:
                ScrollView потребує mouse-wheel-scroll-size щоб працював скрол колесом.
                Грідова розкладка задається через USS на content-container.
            -->
            <ui:ScrollView name="InventoryGrid"
                class="inventory-grid"
                mode="Vertical"
                horizontal-scroller-visibility="Hidden"
                vertical-scroller-visibility="Auto"
                mouse-wheel-scroll-size="60"
                touch-scroll-type="Elastic"
                picking-mode="Position"/>

        </ui:VisualElement>

        <!-- ════════════════════════════════════════
             CABINET PANEL (права) — ловить кліки
             ════════════════════════════════════════ -->
        <ui:VisualElement name="CabinetPanel" picking-mode="Position"
            class="cabinet-panel" style="display: none;">

            <ui:VisualElement class="cabinet-header">
                <ui:Label text="ШАФИ" class="cabinet-title"/>
                <ui:Label name="CabZoneLabel" text="Торговий зал" class="cabinet-zone-label"/>
            </ui:VisualElement>

            <ui:Label text="ШАФИ В МАГАЗИНІ" class="section-label"/>

            <ui:ScrollView name="CabinetList"
                class="cabinet-list"
                mode="Vertical"
                horizontal-scroller-visibility="Hidden"
                mouse-wheel-scroll-size="40"
                picking-mode="Position"/>

            <ui:Label text="ПОЛИЦІ" class="section-label"/>

            <ui:ScrollView name="ShelfList"
                class="shelf-list"
                mode="Vertical"
                horizontal-scroller-visibility="Hidden"
                mouse-wheel-scroll-size="40"
                picking-mode="Position"/>

            <ui:Label name="SelectedShelfLabel"
                text="Оберіть полицю"
                class="selected-shelf-label"/>

            <!--
                КЛЮЧОВЕ ВИПРАВЛЕННЯ #3:
                Transfer row — фіксована позиція в потоці, не absolute,
                кнопки тепер працюють з правильним picking-mode
            -->
            <ui:VisualElement name="TransferRow" class="transfer-row">
                <ui:Button name="BtnPushOne" text="›" class="transfer-btn push"
                    tooltip="Покласти одну книгу"/>
                <ui:Button name="BtnPushAll" text="»" class="transfer-btn push"
                    tooltip="Покласти всі"/>
                <ui:Button name="BtnPopOne"  text="‹" class="transfer-btn pop"
                    tooltip="Забрати одну"/>
                <ui:Button name="BtnPopAll"  text="«" class="transfer-btn pop"
                    tooltip="Забрати всі"/>
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ════════════════════════════════════════
             QUICK ACTIONS (правий нижній)
             ════════════════════════════════════════ -->
        <ui:VisualElement name="HUDActions" picking-mode="Ignore" class="hud-actions">
            <ui:Button name="BtnOpenInventory" text="📦" class="hud-action-btn"
                tooltip="Інвентар"/>
            <ui:Button name="BtnOpenJournal"   text="📋" class="hud-action-btn"
                tooltip="Щоденник"/>
        </ui:VisualElement>

        <!-- ════════════════════════════════════════
             BOTTOM NAV BAR — ловить кліки
             ════════════════════════════════════════ -->
        <ui:VisualElement name="HUDNav" picking-mode="Position" class="hud-nav">
            <ui:Button name="NavTabShop"        text="Крамниця"   class="hud-nav-tab active"/>
            <ui:Button name="NavTabCatalog"     text="Каталог"    class="hud-nav-tab"/>
            <ui:Button name="NavTabOrders"      text="Замовлення" class="hud-nav-tab"/>
            <ui:Button name="NavTabCollections" text="Колекції"   class="hud-nav-tab"/>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
