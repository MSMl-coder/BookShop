<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="SettingsPanel" style="display: none; position: absolute; width: 600px; height: 500px; background-color: rgba(20, 15, 10, 0.95); align-self: center; justify-content: center;">
        <ui:Label text="НАЛАШТУВАННЯ" style="font-size: 32px; color: rgb(255, 215, 0); -unity-text-align: upper-center; margin-bottom: 30px;"/>
        <ui:Label text="Загальний звук" style="color: white; font-size: 16px;"/>
        <ui:Slider name="MasterSlider" low-value="0" high-value="1" value="1" style="margin-bottom: 15px;"/>
        <ui:Label text="Музика" style="color: white; font-size: 16px;"/>
        <ui:Slider name="MusicSlider" low-value="0" high-value="1" value="0.8" style="margin-bottom: 15px;"/>
        <ui:Label text="Ефекти" style="color: white; font-size: 16px;"/>
        <ui:Slider name="SFXSlider" low-value="0" high-value="1" value="1" style="margin-bottom: 25px;"/>
        <ui:Label text="Якість графіки" style="color: white; font-size: 16px;"/>
        <ui:DropdownField name="QualityDropdown" style="margin-bottom: 25px;"/>
        <ui:VisualElement style="flex-direction: row; justify-content: center;">
            <ui:Button text="Зберегти" name="BtnSave" style="width: 150px; height: 45px; margin-right: 20px;"/>
            <ui:Button text="Закрити" name="BtnClose" style="width: 150px; height: 45px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
