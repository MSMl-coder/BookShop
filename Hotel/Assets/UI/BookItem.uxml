<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         editor-extension-mode="False">

    <Style src="project://database/Assets/UI/Styles/InventoryStyles.uss"/>

    <ui:VisualElement name="BookCard" class="book-card" picking-mode="Position">
        <ui:VisualElement name="BookSpine" class="book-spine"/>
        <ui:VisualElement name="BookCover" class="book-cover">
            <ui:VisualElement name="BookIcon" class="book-icon"/>
            <ui:Label name="BookNameLabel" text="" class="book-icon-label"/>
        </ui:VisualElement>
        <ui:VisualElement name="BookFooter" class="book-footer">
            <ui:Label name="PriceLabel" text="—" class="book-price-label"/>
        </ui:VisualElement>
        <ui:VisualElement name="RarityDot" class="rarity-dot common"/>
    </ui:VisualElement>

</ui:UXML>
