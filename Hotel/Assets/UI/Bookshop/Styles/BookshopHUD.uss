/* ═══════════════════════════════════════════════════
   BookshopHUD.uss — HUD elements
   Path: Assets/UI/Bookshop/Styles/BookshopHUD.uss
═══════════════════════════════════════════════════ */

/* ── ① CLUB CARD — CSS opacity-fade flip (no 3D, no scaleX) ── */
.club-card {
    position: absolute;
    top: 26px; left: 19px;
    width: 160px; height: 232px;
}
.club-card__cord {
    top: -30px; height: 24px; width: 2px;
}
/* Both faces share the same position */
.club-card__face {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: var(--board);
    border-width: 2px;
    border-color: var(--gold-soft);
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px; padding-bottom: 13px;
    padding-left: 13px; padding-right: 13px;
    overflow: hidden;
    /* Fade transition driven by hidden class toggle */
    transition-property: opacity;
    transition-duration: 0.35s;
    opacity: 1;
}
/* Back face starts hidden */
.club-card__face--back {
    display: none;
    opacity: 0;
}
/* When not hidden: fade in */
.club-card__face--back:not(.hidden) {
    display: flex;
    opacity: 1;
}
/* C# toggles hidden class; transition handled by USS */
.club-card__face--front.hidden {
    opacity: 0;
    /* Keep display:flex so transition plays; C# hides after transition */
}

.club-card__tag-label {
    position: absolute; top: 11px; right: 11px;
    font-size: 9px; color: var(--gold); letter-spacing: 1.5px; -unity-font-style: bold;
}
.club-card__header { align-items: center; }
.club-card__title {
    font-size: 20px; color: var(--page);
    letter-spacing: 2.4px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.club-card__sub {
    font-size: 11px; color: var(--gold-bright);
    letter-spacing: 1.5px; -unity-font-style: italic; -unity-text-align: middle-center;
}
.club-card__emblem {
    font-size: 40px; -unity-text-align: middle-center;
}
.club-card__name-row {
    flex-direction: row; align-items: center; justify-content: center;
    max-width: 100%;
}
.club-card__name {
    font-size: 14px; color: var(--page);
    -unity-font-style: bold-and-italic; -unity-text-align: middle-center;
    white-space: normal; flex-shrink: 1;
}
.club-card__edit-btn {
    width: 18px; height: 18px;
    background-color: rgba(0,0,0,0); border-width: 0;
    color: var(--gold-soft); font-size: 12px; padding: 0;
    margin-left: 4px; flex-shrink: 0;
}
.club-card__edit-btn:hover { color: var(--gold); }
.club-card__stars {
    color: var(--gold-bright); font-size: 13px; letter-spacing: 2px;
    -unity-text-align: middle-center;
}
.club-card__prestige {
    font-size: 9px; letter-spacing: 2px; color: var(--gold);
    padding-top: 3px; padding-bottom: 3px; padding-left: 10px; padding-right: 10px;
    border-top-width: 1px; border-bottom-width: 1px; border-color: var(--gold-soft);
    -unity-font-style: bold; -unity-text-align: middle-center; width: 100%;
}
.club-card__stats {
    flex-direction: row; width: 100%; justify-content: space-around;
}
.club-card__stat { align-items: center; }
.club-card__stat-label {
    font-size: 9px; color: var(--gold); letter-spacing: 1.5px; -unity-font-style: bold;
}
.club-card__stat-value {
    font-size: 16px; color: var(--page); -unity-font-style: bold;
}
.club-card__hint {
    font-size: 8px; letter-spacing: 1.5px; color: var(--gold-soft); -unity-font-style: bold;
}
.club-card__day-block { align-items: center; }
.club-card__money {
    font-size: 20px; color: var(--gold-bright); -unity-font-style: bold; letter-spacing: 1px;
    -unity-text-align: middle-center;
}
.club-card__money-block { align-items: center; }
.club-card__day-num {
    font-size: 54px; color: var(--page); -unity-font-style: bold; -unity-text-align: middle-center;
    /* Fixed width prevents layout shift */
    width: 100%;
}
.club-card__phase-band {
    font-size: 9px; letter-spacing: 2px;
    color: var(--board); background-color: var(--gold);
    padding-top: 3px; padding-bottom: 3px; padding-left: 10px; padding-right: 10px;
    -unity-font-style: bold; -unity-text-align: middle-center; width: 100%;
}


/* ── ② BUFFS area (overlapping cards) ── */
.buffs-area {
    position: absolute;
    top: 30px;
    left: 198px;
    flex-direction: row;
    align-items: flex-start;
}

.buff-card {
    width: 42px;
    height: 50px;
    margin-left: -5px;
    margin-right: 0;
    padding-top: 6px; padding-bottom: 5px;
    padding-left: 3px; padding-right: 3px;
    background-color: var(--board);
    border-width: 1px;
    border-color: var(--gold-soft);
    align-items: center;
    justify-content: center;
    transition-property: scale, margin-left, margin-right, width, height;
    transition-duration: 0.25s;
}
.buff-card.first {
    margin-left: 0;
}
.buff-card:hover {
    width: 62px;
    height: 62px;
    margin-left: 3px;
    margin-right: 3px;
    scale: 1.05 1.05;
    border-color: var(--gold);
}
.buff-card__icon {
    font-size: 15px;
    -unity-text-align: middle-center;
    transition-property: font-size;
    transition-duration: 0.2s;
}
.buff-card:hover > .buff-card__icon {
    font-size: 22px;
}
.buff-card__name {
    font-size: 6px;
    color: var(--page);
    -unity-font-style: bold;
    letter-spacing: 0.4px;
    opacity: 0;
    -unity-text-align: middle-center;
    transition-property: opacity;
    transition-duration: 0.15s;
}
.buff-card:hover > .buff-card__name {
    opacity: 1;
    transition-delay: 0.1s;
}
.buff-card__value {
    font-size: 10px;
    color: var(--gold-bright);
    -unity-font-style: bold;
    transition-property: font-size;
    transition-duration: 0.2s;
}
.buff-card:hover > .buff-card__value {
    font-size: 13px;
}
.buff-card__tip {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 8px;
    background-color: var(--board-dark);
    color: var(--page);
    font-size: 11px;
    -unity-font-style: italic;
    padding-top: 4px; padding-bottom: 4px;
    padding-left: 9px; padding-right: 9px;
    border-width: 1px;
    border-color: var(--gold-soft);
    opacity: 0;
    white-space: nowrap;
    transition-property: opacity;
    transition-duration: 0.15s;
}
.buff-card:hover > .buff-card__tip {
    opacity: 1;
    transition-delay: 0.2s;
}

/* ── ③ FLIP CLOCK ── */
.clock-frame {
    position: absolute;
    top: 19px;
    left: 50%;
    margin-left: -210px;
    width: 420px;
    align-items: center;
    flex-direction: column;
}
.clock-bar {
    padding-top: 6px; padding-bottom: 6px;
    padding-left: 14px; padding-right: 14px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* Flip clock container: H1 H2 : M1 M2 */
.flip-clock {
    flex-direction: row;
    align-items: center;
    margin-left: 4px;
    margin-right: 8px;
}

/* Single flip digit panel */
.flip-digit {
    width: 44px;
    height: 56px;
    margin-left: 2px;
    margin-right: 2px;
    background-color: var(--board-dark);
    border-width: 1px;
    border-color: var(--gold-soft);
    border-radius: 4px;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    position: relative;
}

/* Top half — shows "upcoming" digit during flip */
.flip-digit__top {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 50%;
    background-color: var(--board-dark);
    align-items: center;
    overflow: hidden;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0,0,0,0.4);
}
/* Bottom half */
.flip-digit__bottom {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 50%;
    background-color: var(--board);
    align-items: center;
    overflow: hidden;
}

.flip-digit__top > Label,
.flip-digit__bottom > Label {
    font-size: 36px;
    color: var(--page);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    width: 100%;
}
/* Bottom label sits at top of its half (shows lower part of digit) */
.flip-digit__bottom > Label {
    position: absolute;
    top: -28px; /* shift upward so digit is "cut" at middle */
}

/* The animated flap — rotates from 0→-90° during flip */
.flip-digit__flap {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 50%;
    background-color: var(--board-dark);
    align-items: center;
    overflow: hidden;
    /* rotation driven by C# ValueAnimation */
    transform-origin: 50% 100%;  /* pivot at bottom center */
}
.flip-digit__flap > Label {
    font-size: 36px;
    color: var(--page);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    width: 100%;
}

/* Horizontal center line shadow */
.flip-digit::after {
    /* Simulated with a thin element inserted by C# */
}
.flip-digit__gap {
    position: absolute;
    top: 50%; left: 0; right: 0;
    height: 2px;
    background-color: rgba(0,0,0,0.6);
    margin-top: -1px;
}

/* Colon separator */
.flip-colon {
    width: 12px;
    height: 56px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    margin-left: 1px;
    margin-right: 1px;
}
.flip-colon__dot {
    width: 6px; height: 6px;
    border-radius: 3px;
    background-color: var(--gold);
    margin-top: 6px;
    margin-bottom: 6px;
}

.clock-divider {
    width: 1px;
    height: 22px;
    background-color: var(--gold-soft);
    opacity: 0.5;
    margin-left: 8px;
    margin-right: 8px;
}
.clock-key {
    width: 26px;
    height: 26px;
    background-color: var(--board-light);
    border-width: 1px;
    border-color: var(--gold-soft);
    color: var(--page);
    font-size: 11px;
    margin-left: 2px;
    margin-right: 2px;
    padding: 0;
}
.clock-key:hover {
    background-color: var(--board-dark);
    border-color: var(--gold);
}
.clock-key.active {
    background-color: var(--gold);
    color: var(--board-dark);
    border-color: var(--gold-bright);
}

/* ── PHASE BAR — stained-glass window style ── */
.phase-bar {
    width: 100%;
    height: 28px;
    flex-direction: row;
    margin-top: 6px;
    position: relative;
    overflow: visible;
}

/* Each phase segment */
.phase-segment {
    flex: 1;
    height: 22px;
    align-items: center;
    justify-content: center;
    position: relative;
    border-width: 1px;
    border-color: rgba(0,0,0,0.3);
}
.phase-segment:first-child {
    border-radius: 2px 0 0 2px;
}
.phase-segment:last-child {
    border-radius: 0 2px 2px 0;
}

/* Stained-glass: each phase has inner gradient + bright border */
.phase-segment--prep {
    background-color: rgb(58, 110, 58);   /* green */
    border-color: rgba(100, 200, 100, 0.35);
}
.phase-segment--work {
    background-color: rgb(40, 80, 148);   /* blue */
    border-color: rgba(80, 140, 255, 0.35);
}
.phase-segment--loot {
    background-color: rgb(138, 106, 40);  /* gold */
    border-color: rgba(255, 210, 80, 0.35);
}

/* Glass highlight stripe */
.phase-segment::after {
    position: absolute;
    top: 2px; left: 3px; right: 3px;
    height: 6px;
    background-color: rgba(255,255,255,0.15);
    border-radius: 1px;
}
.phase-segment.active {
    border-width: 2px;
    border-color: rgba(255,255,255,0.5);
}
.phase-segment.active::after {
    background-color: rgba(255,255,255,0.28);
}

.phase-segment__label {
    font-size: 7px;
    color: rgba(255,255,255,0.7);
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}
.phase-segment.active > .phase-segment__label {
    color: rgba(255,255,255,0.95);
}

/* Progress fill overlay — animated by C# changing width */
.phase-segment__fill {
    position: absolute;
    top: 0; left: 0; bottom: 0;
    background-color: rgba(255,255,255,0.12);
    /* width set dynamically from 0–100% */
}

/* Triangle pointer ABOVE the bar — positioned by C# via margin-left */
.phase-pointer-row {
    position: absolute;
    top: -9px; left: 0; right: 0;
    height: 10px;
    flex-direction: row;
    overflow: visible;
}
.phase-pointer {
    width: 0; height: 0;
    /* Unicode triangle via Label */
    position: absolute;
    top: 0;
    width: 14px;
    height: 10px;
    margin-left: -7px; /* center on pointer position */
    align-items: center;
    justify-content: center;
}
.phase-pointer > Label {
    font-size: 10px;
    color: var(--gold-bright);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

/* Dividers between segments */
.phase-divider {
    width: 2px;
    height: 22px;
    background-color: rgba(0,0,0,0.5);
}

/* ── TOAST AREA (text-only) ── */
.toast-area {
    position: absolute;
    top: 112px;
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: center;
}
.toast {
    font-size: 18px;
    color: var(--page);
    -unity-font-style: bold-and-italic;
    letter-spacing: 1px;
    margin-bottom: 5px;
    text-shadow: 0 2px 4px rgba(0,0,0,0.95);
    flex-direction: row;
}
.toast.warn { color: var(--rose); }
.toast.good { color: var(--gold-bright); }

/* ── ④ CALENDAR ── */
.calendar {
    position: absolute;
    top: 26px; right: 22px;
    width: 176px;
    background-color: var(--page-light);
    border-width: 2px;
    border-color: var(--gold-soft);
}
.calendar__month-head {
    background-color: var(--board);
    padding-top: 6px; padding-bottom: 5px;
    padding-left: 11px; padding-right: 11px;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--gold);
}
.calendar__month-name {
    font-size: 14px;
    color: var(--page);
    letter-spacing: 3.2px;
    -unity-font-style: bold;
}
.calendar__year {
    font-size: 9px;
    color: var(--gold);
    letter-spacing: 1.5px;
    -unity-font-style: bold;
}
.calendar__body {
    padding-top: 10px; padding-bottom: 11px;
    padding-left: 11px; padding-right: 11px;
}
.calendar__day-display {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
}
.calendar__big-day {
    font-size: 51px;
    color: var(--ink);
    -unity-font-style: bold;
    margin-right: 11px;
}
.calendar__day-side {
    align-items: flex-start;
}
.calendar__weekday {
    font-size: 15px;
    color: var(--ink);
    -unity-font-style: bold-and-italic;
}
.calendar__day-meta {
    font-size: 9px;
    color: var(--ink-mute);
    letter-spacing: 1.2px;
    -unity-font-style: bold;
}
.calendar__week-strip {
    flex-direction: row;
    justify-content: space-between;
    border-top-width: 1px;
    border-top-color: var(--gold-soft);
    padding-top: 6px;
}
.cal-tick {
    width: 19px; height: 19px;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    color: var(--ink-mute);
    -unity-font-style: bold;
}
.cal-tick.past {
    opacity: 0.35;
}
.cal-tick.today {
    background-color: var(--accent);
    color: var(--page);
}

/* ── ⑤ BOOK INFO ── */
.book-info {
    position: absolute;
    bottom: 96px; right: 22px;
    width: 200px;
    padding-top: 10px; padding-bottom: 11px;
    padding-left: 13px; padding-right: 13px;
    background-color: var(--page-light);
    border-width: 2px;
    border-color: var(--gold-soft);
    translate: 232px 0;
    transition-property: translate;
    transition-duration: 0.4s;
}
.book-info.visible {
    translate: 0 0;
}
.book-info__header {
    align-items: center;
    margin-bottom: 6px;
}
.book-info__title-head {
    font-size: 10px;
    letter-spacing: 2.4px;
    color: var(--ink);
    -unity-font-style: bold;
}
.book-info__num {
    font-size: 10px;
    color: var(--ink-mute);
    -unity-font-style: italic;
}
.book-info__field-label {
    font-size: 8px;
    letter-spacing: 2px;
    color: var(--ink-mute);
    -unity-font-style: bold;
    margin-top: 6px;
}
.book-info__field-value {
    font-size: 14px;
    color: var(--ink);
    -unity-font-style: bold-and-italic;
    border-bottom-width: 1px;
    border-bottom-color: var(--gold-soft);
    padding-bottom: 2px;
}
.book-info__row-two {
    flex-direction: row;
    margin-top: 6px;
}
.book-info__row-two > * {
    flex-grow: 1;
    margin-right: 8px;
}
.book-info__bonus-line {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
    padding: 4px 7px;
    background-color: rgba(212, 168, 67, 0.12);
    border-width: 1px;
    border-color: var(--gold-soft);
}
.book-info__bonus-dot {
    width: 3px; height: 10px;
    background-color: var(--accent);
    margin-right: 5px;
}
.book-info__stamp {
    position: absolute;
    bottom: 11px; right: 14px;
    width: 35px; height: 35px;
    border-width: 2px;
    border-color: var(--accent);
    color: var(--accent);
    opacity: 0.45;
    font-size: 7px;
    letter-spacing: 0.8px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    rotate: -10deg;
    white-space: normal;
}

/* ── ⑥ FUNCTION BAR ── */
.func-bar {
    position: absolute;
    bottom: 22px;
    left: 0; right: 0;
    flex-direction: row;
    justify-content: center;
}
.func-btn {
    width: 60px; height: 69px;
    margin-left: 10px;
    margin-right: 10px;
    background-color: var(--board);
    border-width: 1px;
    border-color: var(--gold-soft);
    padding-top: 10px; padding-bottom: 6px;
    padding-left: 4px; padding-right: 4px;
    align-items: center;
    justify-content: center;
    color: var(--page);
}
.func-btn:hover {
    translate: 0 -3px;
    border-color: var(--gold);
}
.func-btn.active {
    background-color: var(--accent);
    border-color: var(--gold-bright);
}
.func-btn__icon-frame {
    width: 27px; height: 27px;
    border-width: 1px;
    border-color: var(--gold-soft);
    background-color: rgba(212, 168, 67, 0.1);
    align-items: center;
    justify-content: center;
}
.func-btn__icon-frame > Label {
    font-size: 17px;
}
.func-btn__code {
    font-size: 9px;
    letter-spacing: 1.5px;
    color: var(--gold);
    -unity-font-style: bold;
    margin-top: 2px;
}
.func-btn.active .func-btn__code {
    color: var(--gold-bright);
}
.func-btn__badge {
    position: absolute;
    top: -5px; right: -5px;
    width: 18px; height: 18px;
    background-color: var(--accent);
    color: var(--page);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 2px;
    border-color: var(--gold-bright);
    border-radius: 9px;
}
.func-btn__tip {
    position: absolute;
    bottom: 100%;
    margin-bottom: 10px;
    background-color: var(--board-dark);
    color: var(--page);
    font-size: 14px;
    -unity-font-style: bold-and-italic;
    padding: 3px 10px;
    border-width: 1px;
    border-color: var(--gold);
    opacity: 0;
    white-space: nowrap;
    letter-spacing: 0.8px;
    transition-property: opacity;
    transition-duration: 0.15s;
}
.func-btn:hover > .func-btn__tip {
    opacity: 1;
}
