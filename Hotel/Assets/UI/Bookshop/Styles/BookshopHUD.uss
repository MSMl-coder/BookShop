/* ═══════════════════════════════════════════════════
   BookshopHUD.uss — HUD elements
   Path: Assets/UI/Bookshop/Styles/BookshopHUD.uss
═══════════════════════════════════════════════════ */

/* ── ① CLUB CARD ── */
.club-card {
    position: absolute;
    top: 26px; left: 19px;
    width: 160px; height: 232px;
}
.club-card__cord {
    top: -30px;
    height: 24px;
    width: 2px;
}

.flip-inner {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}
.flip-face {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: var(--board);
    border-width: 2px;
    border-color: var(--gold-soft);
}
.flip-face--back {
    display: none;
}
.club-card.flipped > .flip-inner > .flip-face {
    display: none;
}
.club-card.flipped > .flip-inner > .flip-face--back {
    display: flex;
}

.club-card__face {
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px; padding-bottom: 13px;
    padding-left: 13px; padding-right: 13px;
}
.club-card__tag-label {
    position: absolute;
    top: 11px; right: 11px;
    font-size: 9px;
    color: var(--gold);
    letter-spacing: 1.5px;
    -unity-font-style: bold;
}
.club-card__header {
    align-items: center;
}
.club-card__title {
    font-size: 21px;
    color: var(--page);
    letter-spacing: 2.4px;
    -unity-font-style: bold;
}
.club-card__sub {
    font-size: 11px;
    color: var(--gold-bright);
    letter-spacing: 1.5px;
    -unity-font-style: italic;
}
.club-card__emblem {
    font-size: 42px;
    -unity-text-align: middle-center;
}
.club-card__name {
    font-size: 15px;
    color: var(--page);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
    white-space: normal;
}
.club-card__stars {
    color: var(--gold-bright);
    font-size: 14px;
    letter-spacing: 1.5px;
}
.club-card__prestige {
    font-size: 10px;
    letter-spacing: 2.4px;
    color: var(--gold);
    padding-top: 3px; padding-bottom: 3px;
    padding-left: 11px; padding-right: 11px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--gold-soft);
    -unity-font-style: bold;
}
.club-card__stats {
    flex-direction: row;
    width: 100%;
    justify-content: space-around;
}
.club-card__stat {
    align-items: center;
}
.club-card__stat-label {
    font-size: 9px;
    color: var(--gold);
    letter-spacing: 1.5px;
    -unity-font-style: bold;
}
.club-card__stat-value {
    font-size: 17px;
    color: var(--page);
    -unity-font-style: bold;
}
.club-card__hint {
    font-size: 8px;
    letter-spacing: 1.5px;
    color: var(--gold-soft);
    -unity-font-style: bold;
}
.club-card__day-block {
    align-items: center;
}
.club-card__day-num {
    font-size: 62px;
    color: var(--page);
    -unity-font-style: bold;
}
.club-card__money-block {
    align-items: center;
}
.club-card__money {
    font-size: 21px;
    color: var(--gold-bright);
    -unity-font-style: bold;
    letter-spacing: 1px;
}
.club-card__phase-band {
    font-size: 10px;
    letter-spacing: 2.4px;
    color: var(--board);
    background-color: var(--gold);
    padding-top: 3px; padding-bottom: 3px;
    padding-left: 11px; padding-right: 11px;
    -unity-font-style: bold;
}

/* ── ② BUFFS area (overlapping cards) ── */
.buffs-area {
    position: absolute;
    top: 30px;
    left: 198px;
    flex-direction: row;
    align-items: flex-start;
}

.buff-card {
    width: 42px;
    height: 50px;
    margin-left: -5px;
    margin-right: 0;
    padding-top: 6px; padding-bottom: 5px;
    padding-left: 3px; padding-right: 3px;
    background-color: var(--board);
    border-width: 1px;
    border-color: var(--gold-soft);
    align-items: center;
    justify-content: center;
    transition-property: scale, margin-left, margin-right, width, height;
    transition-duration: 0.25s;
}
.buff-card.first {
    margin-left: 0;
}
.buff-card:hover {
    width: 62px;
    height: 62px;
    margin-left: 3px;
    margin-right: 3px;
    scale: 1.05 1.05;
    border-color: var(--gold);
}
.buff-card__icon {
    font-size: 15px;
    -unity-text-align: middle-center;
    transition-property: font-size;
    transition-duration: 0.2s;
}
.buff-card:hover > .buff-card__icon {
    font-size: 22px;
}
.buff-card__name {
    font-size: 6px;
    color: var(--page);
    -unity-font-style: bold;
    letter-spacing: 0.4px;
    opacity: 0;
    -unity-text-align: middle-center;
    transition-property: opacity;
    transition-duration: 0.15s;
}
.buff-card:hover > .buff-card__name {
    opacity: 1;
    transition-delay: 0.1s;
}
.buff-card__value {
    font-size: 10px;
    color: var(--gold-bright);
    -unity-font-style: bold;
    transition-property: font-size;
    transition-duration: 0.2s;
}
.buff-card:hover > .buff-card__value {
    font-size: 13px;
}
.buff-card__tip {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 8px;
    background-color: var(--board-dark);
    color: var(--page);
    font-size: 11px;
    -unity-font-style: italic;
    padding-top: 4px; padding-bottom: 4px;
    padding-left: 9px; padding-right: 9px;
    border-width: 1px;
    border-color: var(--gold-soft);
    opacity: 0;
    white-space: nowrap;
    transition-property: opacity;
    transition-duration: 0.15s;
}
.buff-card:hover > .buff-card__tip {
    opacity: 1;
    transition-delay: 0.2s;
}

/* ── ③ CLOCK ── */
.clock-frame {
    position: absolute;
    top: 19px;
    left: 50%;
    margin-left: -160px;
    width: 320px;
    align-items: center;
}
.clock-bar {
    padding-top: 6px; padding-bottom: 6px;
    padding-left: 14px; padding-right: 14px;
    flex-direction: row;
    align-items: center;
    min-width: 224px;
    justify-content: center;
}
.clock-digits {
    font-size: 26px;
    color: var(--page);
    letter-spacing: 2.4px;
    min-width: 80px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}
.clock-divider {
    width: 1px;
    height: 22px;
    background-color: var(--gold-soft);
    opacity: 0.5;
    margin-left: 8px;
    margin-right: 8px;
}
.clock-key {
    width: 26px;
    height: 26px;
    background-color: var(--board-light);
    border-width: 1px;
    border-color: var(--gold-soft);
    color: var(--page);
    font-size: 11px;
    margin-left: 2px;
    margin-right: 2px;
    padding: 0;
}
.clock-key:hover {
    background-color: var(--board-dark);
    border-color: var(--gold);
}
.clock-key.active {
    background-color: var(--gold);
    color: var(--board-dark);
    border-color: var(--gold-bright);
}

/* ── TOAST AREA (text-only) ── */
.toast-area {
    position: absolute;
    top: 112px;
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: center;
}
.toast {
    font-size: 18px;
    color: var(--page);
    -unity-font-style: bold-and-italic;
    letter-spacing: 1px;
    margin-bottom: 5px;
    text-shadow: 0 2px 4px rgba(0,0,0,0.95);
    flex-direction: row;
}
.toast.warn { color: var(--rose); }
.toast.good { color: var(--gold-bright); }

/* ── ④ CALENDAR ── */
.calendar {
    position: absolute;
    top: 26px; right: 22px;
    width: 176px;
    background-color: var(--page-light);
    border-width: 2px;
    border-color: var(--gold-soft);
}
.calendar__month-head {
    background-color: var(--board);
    padding-top: 6px; padding-bottom: 5px;
    padding-left: 11px; padding-right: 11px;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--gold);
}
.calendar__month-name {
    font-size: 14px;
    color: var(--page);
    letter-spacing: 3.2px;
    -unity-font-style: bold;
}
.calendar__year {
    font-size: 9px;
    color: var(--gold);
    letter-spacing: 1.5px;
    -unity-font-style: bold;
}
.calendar__body {
    padding-top: 10px; padding-bottom: 11px;
    padding-left: 11px; padding-right: 11px;
}
.calendar__day-display {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
}
.calendar__big-day {
    font-size: 51px;
    color: var(--ink);
    -unity-font-style: bold;
    margin-right: 11px;
}
.calendar__day-side {
    align-items: flex-start;
}
.calendar__weekday {
    font-size: 15px;
    color: var(--ink);
    -unity-font-style: bold-and-italic;
}
.calendar__day-meta {
    font-size: 9px;
    color: var(--ink-mute);
    letter-spacing: 1.2px;
    -unity-font-style: bold;
}
.calendar__week-strip {
    flex-direction: row;
    justify-content: space-between;
    border-top-width: 1px;
    border-top-color: var(--gold-soft);
    padding-top: 6px;
}
.cal-tick {
    width: 19px; height: 19px;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    color: var(--ink-mute);
    -unity-font-style: bold;
}
.cal-tick.past {
    opacity: 0.35;
}
.cal-tick.today {
    background-color: var(--accent);
    color: var(--page);
}

/* ── ⑤ BOOK INFO ── */
.book-info {
    position: absolute;
    bottom: 96px; right: 22px;
    width: 200px;
    padding-top: 10px; padding-bottom: 11px;
    padding-left: 13px; padding-right: 13px;
    background-color: var(--page-light);
    border-width: 2px;
    border-color: var(--gold-soft);
    translate: 232px 0;
    transition-property: translate;
    transition-duration: 0.4s;
}
.book-info.visible {
    translate: 0 0;
}
.book-info__header {
    align-items: center;
    margin-bottom: 6px;
}
.book-info__title-head {
    font-size: 10px;
    letter-spacing: 2.4px;
    color: var(--ink);
    -unity-font-style: bold;
}
.book-info__num {
    font-size: 10px;
    color: var(--ink-mute);
    -unity-font-style: italic;
}
.book-info__field-label {
    font-size: 8px;
    letter-spacing: 2px;
    color: var(--ink-mute);
    -unity-font-style: bold;
    margin-top: 6px;
}
.book-info__field-value {
    font-size: 14px;
    color: var(--ink);
    -unity-font-style: bold-and-italic;
    border-bottom-width: 1px;
    border-bottom-color: var(--gold-soft);
    padding-bottom: 2px;
}
.book-info__row-two {
    flex-direction: row;
    margin-top: 6px;
}
.book-info__row-two > * {
    flex-grow: 1;
    margin-right: 8px;
}
.book-info__bonus-line {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
    padding: 4px 7px;
    background-color: rgba(212, 168, 67, 0.12);
    border-width: 1px;
    border-color: var(--gold-soft);
}
.book-info__bonus-dot {
    width: 3px; height: 10px;
    background-color: var(--accent);
    margin-right: 5px;
}
.book-info__stamp {
    position: absolute;
    bottom: 11px; right: 14px;
    width: 35px; height: 35px;
    border-width: 2px;
    border-color: var(--accent);
    color: var(--accent);
    opacity: 0.45;
    font-size: 7px;
    letter-spacing: 0.8px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    rotate: -10deg;
    white-space: normal;
}

/* ── ⑥ FUNCTION BAR ── */
.func-bar {
    position: absolute;
    bottom: 22px;
    left: 0; right: 0;
    flex-direction: row;
    justify-content: center;
}
.func-btn {
    width: 60px; height: 69px;
    margin-left: 10px;
    margin-right: 10px;
    background-color: var(--board);
    border-width: 1px;
    border-color: var(--gold-soft);
    padding-top: 10px; padding-bottom: 6px;
    padding-left: 4px; padding-right: 4px;
    align-items: center;
    justify-content: center;
    color: var(--page);
}
.func-btn:hover {
    translate: 0 -3px;
    border-color: var(--gold);
}
.func-btn.active {
    background-color: var(--accent);
    border-color: var(--gold-bright);
}
.func-btn__icon-frame {
    width: 27px; height: 27px;
    border-width: 1px;
    border-color: var(--gold-soft);
    background-color: rgba(212, 168, 67, 0.1);
    align-items: center;
    justify-content: center;
}
.func-btn__icon-frame > Label {
    font-size: 17px;
}
.func-btn__code {
    font-size: 9px;
    letter-spacing: 1.5px;
    color: var(--gold);
    -unity-font-style: bold;
    margin-top: 2px;
}
.func-btn.active .func-btn__code {
    color: var(--gold-bright);
}
.func-btn__badge {
    position: absolute;
    top: -5px; right: -5px;
    width: 18px; height: 18px;
    background-color: var(--accent);
    color: var(--page);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 2px;
    border-color: var(--gold-bright);
    border-radius: 9px;
}
.func-btn__tip {
    position: absolute;
    bottom: 100%;
    margin-bottom: 10px;
    background-color: var(--board-dark);
    color: var(--page);
    font-size: 14px;
    -unity-font-style: bold-and-italic;
    padding: 3px 10px;
    border-width: 1px;
    border-color: var(--gold);
    opacity: 0;
    white-space: nowrap;
    letter-spacing: 0.8px;
    transition-property: opacity;
    transition-duration: 0.15s;
}
.func-btn:hover > .func-btn__tip {
    opacity: 1;
}
