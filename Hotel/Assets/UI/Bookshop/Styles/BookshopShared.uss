/* ═══════════════════════════════════════════════════
   BookshopShared.uss — Shared base styles
   Path: Assets/UI/Bookshop/Styles/BookshopShared.uss
═══════════════════════════════════════════════════ */

.root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    flex-direction: column;
}

.hud {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.modals-layer {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.hidden { display: none; }

/* ── TAG base (notebook hanging plate) ── */
.tag {
    background-color: var(--board);
    border-width: 1px;
    border-color: var(--gold-soft);
    color: var(--page);
}

.tag-ring {
    position: absolute;
    top: -10px;
    left: 50%;
    margin-left: -7px;
    width: 14px;
    height: 14px;
    background-color: var(--gold-soft);
    border-radius: 7px;
    border-width: 1px;
    border-color: var(--gold-deep);
}

.tag-cord {
    position: absolute;
    top: -34px;
    left: 50%;
    margin-left: -1px;
    width: 2px;
    height: 26px;
    background-color: var(--cord);
}

.tag-cord.tilt-left {
    rotate: 4deg;
    transform-origin: bottom;
}
.tag-cord.tilt-right {
    rotate: -4deg;
    transform-origin: bottom;
}

/* ── Frame borders (inner decorative lines) ── */
.flip-face__border-outer {
    position: absolute;
    top: 3px; left: 3px; right: 3px; bottom: 3px;
    border-width: 1px;
    border-color: var(--gold);
    opacity: 0.5;
}
.flip-face__border-inner {
    position: absolute;
    top: 2px; left: 2px; right: 2px; bottom: 2px;
    border-width: 1px;
    border-color: var(--gold-soft);
    opacity: 0.4;
}

/* ── Overlay (dim layer) ── */
.overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(20, 12, 4, 0.45);
    transition-property: opacity;
    transition-duration: 0.3s;
}
.overlay.hidden {
    opacity: 0;
}

/* Pill (genre/rarity badge) */
.inv-pill {
    font-size: 9px;
    letter-spacing: 1.2px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    border-width: 1px;
}
.inv-pill--genre {
    color: var(--ink-soft);
    border-color: var(--ink-soft);
    background-color: rgba(74, 58, 36, 0.08);
}
.inv-pill.common {
    color: var(--r-common);
    border-color: var(--r-common);
    background-color: rgba(107, 102, 85, 0.12);
}
.inv-pill.uncommon {
    color: var(--r-uncommon);
    border-color: var(--r-uncommon);
    background-color: rgba(74, 122, 74, 0.12);
}
.inv-pill.rare {
    color: var(--r-rare);
    border-color: var(--r-rare);
    background-color: rgba(58, 104, 168, 0.12);
}
.inv-pill.epic {
    color: var(--r-epic);
    border-color: var(--r-epic);
    background-color: rgba(122, 58, 168, 0.12);
}
.inv-pill.legend {
    color: var(--r-legend);
    border-color: var(--r-legend);
    background-color: rgba(184, 144, 42, 0.18);
}
