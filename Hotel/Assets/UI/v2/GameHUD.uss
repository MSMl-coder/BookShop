/*
    GameHUD.uss — Screen 1 styles
    Path: Assets/UI/v2/GameHUD/GameHUD.uss

    Залежить від BookshopVariables.uss (або BookshopUI.uss де задані --board, --gold тощо).
    Підключіть через @import або додайте BookshopVariables.uss до PanelSettings StyleSheets.

    АНІМАЦІЇ:
      - Жанрові картки: USS transitions на width + opacity + translate-x
      - Stat bars: USS transition на width
      - NPC панель: USS transition на opacity + translate-y (slide-in знизу)
*/

/* ══════════════════════════════════════
   ROOT
══════════════════════════════════════ */
.hud-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    flex-direction: column;
    overflow: visible;
}

/* ══════════════════════════════════════
   TOP BAR
   Figma: height~40px, dark bg, centered clock + speed arrows
══════════════════════════════════════ */
.top-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 40px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgb(36, 48, 42);
    border-bottom-width: 1px;
    border-bottom-color: rgba(184, 144, 42, 0.35);
}

.clock-row {
    flex-direction: row;
    align-items: center;
    height: 100%;
}

.clock-digit {
    font-size: 24px;
    color: rgb(245, 236, 214);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    width: 34px;
    letter-spacing: 1px;
}

.clock-colon {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 10px;
    margin-left: 2px;
    margin-right: 2px;
}
.clock-colon__dot {
    width: 4px; height: 4px;
    border-radius: 2px;
    background-color: rgb(212, 168, 67);
    margin-top: 4px;
    margin-bottom: 4px;
}

.clock-divider {
    width: 1px; height: 20px;
    background-color: rgb(184, 144, 42);
    opacity: 0.5;
    margin-left: 10px;
    margin-right: 10px;
}

.speed-btn {
    width: 30px;
    height: 28px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(150, 130, 70);
    border-radius: 3px;
    color: rgb(200, 175, 100);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-left: 3px;
    padding: 0;
    transition-property: background-color, border-color, color;
    transition-duration: 0.15s;
}
.speed-btn:hover {
    background-color: rgba(184, 144, 42, 0.2);
    border-color: rgb(212, 168, 67);
    color: rgb(232, 196, 90);
}
.speed-btn--active {
    background-color: rgb(212, 168, 67);
    color: rgb(28, 38, 30);
    border-color: rgb(232, 196, 90);
    -unity-font-style: bold;
}

/* ══════════════════════════════════════
   LEFT NAV — "slide-in tabs"

   АРХІТЕКТУРА: nav-btn-wrap → nav-btn__shadow + nav-btn > nav-btn__icon

   nav-btn-wrap  — прозорий контейнер БЕЗ rotate.
                   Ловить hover, анімує margin-left + translate.
                   Hitbox = прямокутник → нема gap-flicker при nахилі.

   nav-btn       — кнопка з rotate: -5deg (тільки піксельний ефект).
   nav-btn__shadow — тінь за кнопкою, offset вниз-вправо.
   nav-btn__icon   — слот для іконки.

   ЦИФРИ:
   · Видимо в спокої:    100 − 50 = 50px "вушко"
   · Висування hover:    28px (margin-left: −50 → −22)
   · Компенсація нахилу: 28 × sin(5°) ≈ 2.4px вгору
     Чому: кнопка rotate: −5deg → при слайді вправо Δx
     вона зсувається вниз на Δx×sin(5°) у видимій точці x=0.
     translate: 0 -2.5px повертає зазор між кнопками до норми.
══════════════════════════════════════ */

.left-nav {
    position: absolute;
    top: 0; bottom: 0; left: 0;
    width: 100px;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    overflow: visible;
}

/* ── Wrapper: hover-зона, slide-анімація, компенсація нахилу ── */
.nav-btn-wrap {
    width: 100px;
    height: 44px;
    margin-top: 3px;
    margin-bottom: 3px;
    margin-left: -50px;  /* 100 − 50 = 50px видимо в спокої */
    translate: 0 0px;
    overflow: visible;

    transition-property: margin-left, translate;
    transition-duration: 0.2s, 0.2s;
    transition-timing-function: ease-out;
}

.nav-btn-wrap:hover {
    margin-left: -22px;   /* −50 + 28 = −22 */
    translate: 0 -2.5px;  /* компенсація: 28 × sin(5°) ≈ 2.44px вгору */
}

/* ── Drop shadow: в UXML стоїть ДО кнопки → рендер за нею ── */
.nav-btn__shadow {
    position: absolute;
    top: 5px;
    left: 5px;
    width: 100px;
    height: 44px;
    border-radius: 0 12px 12px 0;
    background-color: rgba(0, 0, 0, 0.45);
    rotate: -5deg;
}

/* ── Button: візуальна кнопка з нахилом ── */
.nav-btn {
    width: 100px;
    height: 44px;
    background-color: rgb(69, 89, 148);
    border-width: 0;
    border-radius: 0 10px 10px 0;
    padding: 0;
    rotate: -5deg;

    transition-property: background-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

/* Hover-колір через батьківський wrapper (нема hitbox-конфлікту з rotate) */
.nav-btn-wrap:hover .nav-btn {
    background-color: rgb(85, 108, 175);
}

/* ── Icon slot ──
   50px visible: local x 50→100, center=75, icon_left = 75 − 13 = 62px */
.nav-btn__icon {
    position: absolute;
    width: 32px;
    height: 32px;
    top: 6px;    /* (44 − 32) / 2 = 6 → вертикальний центр */
    left: 56px;  /* горизонтальний центр 50px-вушка */
}

/* Active: клас залишено для C# (AddToClassList), жовта риска видалена */


/* ══════════════════════════════════════
   BOTTOM-LEFT CLUSTER
══════════════════════════════════════ */
.bottom-left-cluster {
    position: absolute;
    bottom: 16px;
    left: 58px;
    flex-direction: column;
    align-items: flex-start;
}

/* ══════════════════════════════════════
   NPC INSPECTOR PANEL
══════════════════════════════════════ */


/* ══════════════════════════════════════
   GENRE CARDS ROW — "колода карт"
══════════════════════════════════════ */
.genre-cards-row {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 8px;
    /* overflow: visible — щоб картки могли виходити за межі при fan-out */
    overflow: visible;
    height: 52px;
    /* Позиціонування: картки стоять щільно як колода */
}

/*
   GENRE CARD — одна картка жанру
   Collapsed: вузька (32px), картки перекривають одна одну
   Expanded: ширша (72px), з'являється лейбл

   Анімація: transition на width, opacity
   Зсув вправо для ефекту "розкладення" задається через C#
   translate на кожну картку (0 → індивідуальний offset)
*/
.genre-card {
    width: 32px;
    height: 48px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(212, 168, 67, 0.4);
    background-color: rgb(42, 55, 70);
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 4px;
    margin-right: -12px;        /* перекриття як у колоді */
    overflow: hidden;

    /* TRANSITION — серцевина анімації */
    transition-property: width, margin-right, opacity;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

/* Стан "розкладено" — додається C# при PointerEnter на GenreCardsRow */
.genre-card.expanded {
    width: 72px;
    margin-right: 6px;           /* нормальний відступ між картками */
}

/* Hover на конкретну картку — легке виділення */
.genre-card:hover {
    border-color: rgb(212, 168, 67);
    /* translate-y: -4px не підтримується як USS transition у всіх версіях Unity 6,
       тому робимо через C# RegisterCallback<PointerEnterEvent> */
}

/* Іконка жанру — placeholder квадрат, замінити на Texture2D */
.genre-card__icon {
    width: 20px; height: 20px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.15);
    margin-bottom: 2px;
    flex-shrink: 0;
}

/* Лейбл жанру — прихований при collapsed, з'являється при expanded */
.genre-card__label {
    font-size: 8px;
    color: rgb(245, 236, 214);
    -unity-text-align: middle-center;
    letter-spacing: 0.5px;
    white-space: nowrap;
    overflow: hidden;
    opacity: 0;
    /* Fade in разом із розширенням */
    transition-property: opacity;
    transition-duration: 0.2s;
    transition-delay: 0.1s;     /* затримка: спочатку розширюється, потім з'являється текст */
}
.genre-card.expanded > .genre-card__label {
    opacity: 1;
}

/* Мітка "виконано" — зелена галочка поверх картки */
.genre-card__fulfilled {
    position: absolute;
    top: 4px; right: 4px;
    width: 14px; height: 14px;
    border-radius: 7px;
    background-color: rgb(80, 180, 90);
    /* Вміст (✓) додається через C# або фоновий спрайт */
}

/* ── Жанрові кольори карток ──
   Відповідають BookGenre enum: Classic, Fantasy, SciFi, Horror, Mystery, Biography, Academic
── */
.genre-card--classic    { background-color: rgb(48,  40,  22); border-color: rgba(168, 144, 42,  0.6); }
.genre-card--fantasy    { background-color: rgb(38,  28,  68); border-color: rgba(122,  58, 168, 0.6); }
.genre-card--scifi      { background-color: rgb(18,  48,  68); border-color: rgba( 58, 168, 210, 0.6); }
.genre-card--horror     { background-color: rgb(52,  18,  18); border-color: rgba(168,  38,  38, 0.6); }
.genre-card--mystery    { background-color: rgb(22,  32,  58); border-color: rgba( 58, 104, 168, 0.6); }
.genre-card--biography  { background-color: rgb(22,  52,  28); border-color: rgba( 58, 168,  80, 0.6); }
.genre-card--academic   { background-color: rgb(52,  44,  18); border-color: rgba(184, 160,  60, 0.6); }

/* Коли книжку взяв гравець — картка стає яскравішою (колір відповідає книжці) */
.genre-card--fulfilled {
    border-color: rgb(212, 168, 67);
    border-width: 2px;
}

/* ════════════════════════════════════
   GENRE CARD TOOLTIP
════════════════════════════════════ */
.genre-card-tooltip {
    position: absolute;
    /* Позиція задається C# під активну карту */
    background-color: rgba(20, 14, 8, 0.96);
    border-width: 1px;
    border-color: rgb(184, 144, 42);
    border-radius: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
    flex-direction: column;
    min-width: 120px;

    transition-property: opacity;
    transition-duration: 0.15s;
    opacity: 1;
}
.genre-card-tooltip.hidden {
    opacity: 0;
}
.tooltip-title {
    font-size: 11px;
    color: rgb(245, 236, 214);
    -unity-font-style: italic;
    white-space: normal;
}
.tooltip-price {
    font-size: 12px;
    color: rgb(232, 196, 90);
    -unity-font-style: bold;
    margin-top: 3px;
}

/* ══════════════════════════════════════
   CHARACTER DOCK — Max / Vika
   Figma: великі портрети ~68x68px,
   темно-сірий фон, ім'я знизу, rounded
══════════════════════════════════════ */
.character-dock {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 8px;
}

.char-card {
    flex-direction: column;
    align-items: center;
    margin-right: 6px;
    cursor: default;
}

.char-card__portrait--placeholder {
    width: 68px;
    height: 68px;
    border-radius: 7px;
    background-color: rgb(52, 62, 72);
    border-width: 2px;
    border-color: rgba(140, 150, 160, 0.5);
}

.char-card__name {
    font-size: 11px;
    color: rgb(200, 190, 170);
    -unity-text-align: middle-center;
    margin-top: 4px;
    letter-spacing: 0.5px;
    -unity-font-style: normal;
}
