<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">

    <!-- Shared resources (переюзабельні для інших панелей) -->

    <!-- Panel-specific styles -->
    <Style src="project://database/Assets/UI/v2/Components/InventoryPanel/InventoryPanel.uss"/>

    <ui:VisualElement name="InventoryPanel" picking-mode="Position" class="inv-panel hidden">

        <!-- Кнопка закриття: абсолютна позиція, візуально окремо -->
        <ui:Button name="BtnClose" text="✕" picking-mode="Position" class="inv-close-btn"/>

        <!-- 7 квадратів-плейсхолдерів для іконок жанрів -->
        <ui:VisualElement name="CategoryBar" picking-mode="Position" class="inv-category-bar">
            <ui:VisualElement name="CatSlot0" picking-mode="Position" class="inv-cat-btn"/>
            <ui:VisualElement name="CatSlot1" picking-mode="Position" class="inv-cat-btn"/>
            <ui:VisualElement name="CatSlot2" picking-mode="Position" class="inv-cat-btn"/>
            <ui:VisualElement name="CatSlot3" picking-mode="Position" class="inv-cat-btn"/>
            <ui:VisualElement name="CatSlot4" picking-mode="Position" class="inv-cat-btn"/>
            <ui:VisualElement name="CatSlot5" picking-mode="Position" class="inv-cat-btn"/>
            <ui:VisualElement name="CatSlot6" picking-mode="Position" class="inv-cat-btn"/>
        </ui:VisualElement>

        <!-- Заголовок -->
        <ui:Label text="INVENTORY" class="inv-title"/>

        <!-- Пошук -->
        <ui:VisualElement name="SearchRow" picking-mode="Position" class="inv-search-row">
            <ui:TextField name="SearchField" placeholder-text="...." picking-mode="Position" class="inv-search-field"/>
            <ui:Button name="BtnSearch" text="🔍" picking-mode="Position" class="inv-search-btn"/>
        </ui:VisualElement>

        <!-- Subcategory (для сумісності, схована) -->
        <ui:VisualElement name="SubcategoryBar" picking-mode="Ignore" class="inv-subcategory-bar"/>

        <!-- Сітка слотів з кастомним скролбаром на лівому боці -->
        <ui:ScrollView name="BookGrid" mode="Vertical" mouse-wheel-scroll-size="80" vertical-scroller-visibility="AlwaysVisible" picking-mode="Position" class="inv-book-grid custom-scrollbar custom-scrollbar--left"/>

    </ui:VisualElement>
</ui:UXML>
