/*
    InventoryPanel.uss — V5 (refactored, shared resources extracted)
    Path: Assets/UI/v2/Components/InventoryPanel/InventoryPanel.uss

    ЗАЛЕЖНОСТІ (підвантажуються у InventoryPanel.uxml через <Style src>):
    · Assets/UI/v2/Shared/CustomScrollbar.uss  — стилі скролбара
    · Assets/UI/v2/Shared/BookCard.uss         — стилі картки книги

    ЦЕЙ ФАЙЛ МІСТИТЬ ЛИШЕ:
    · позиціонування панелі
    · ряд категорій + плейсхолдери
    · кнопку X
    · заголовок INVENTORY
    · пошук
    · grid container (без стилів самої картки)
    · section letters
*/


/* ════════════════════════════════════════
   ROOT — позиція й розмір з 2го фото
   2/3 висоти екрана + посунуто вправо
════════════════════════════════════════ */
.inv-panel {
    position: absolute;
    left: 300px;
    top: 30px;
    width: 360px;
    bottom: 33%;             /* ≈ 2/3 висоти екрана */

    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    flex-direction: column;
    overflow: visible;
    padding: 0;

    transition-property: opacity, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.inv-panel.hidden {
    opacity: 0;
    translate: -20px 0;
    display: none;
}


/* ════════════════════════════════════════
   КАТЕГОРІЇ — ряд із 7 плейсхолдерів
════════════════════════════════════════ */
.inv-category-bar {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: nowrap;
    flex-shrink: 0;

    padding-top: 16px;
    padding-left: 16px;
    padding-right: 60px;     /* залишає простір під X */
    padding-bottom: 8px;

    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.inv-cat-btn {
    width: 32px;
    height: 32px;
    background-color: rgb(225, 225, 225);

    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(140, 140, 140, 0.4);

    border-radius: 9px;
    margin-right: 6px;
    margin-bottom: 4px;
    padding: 0;
    flex-shrink: 0;

    transition-property: scale, background-color, translate;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
    translate: 0 0;
}
.inv-cat-btn:hover {
    background-color: rgb(238, 238, 238);
    translate: 0 -2px;
}
.inv-cat-btn--active {
    background-color: rgb(195, 200, 220);
    border-bottom-color: rgba(120, 125, 150, 0.45);
}


/* ════════════════════════════════════════
   КНОПКА X — абсолютна позиція, окремо
════════════════════════════════════════ */
.inv-close-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    border-radius: 18px;

    background-color: rgb(255, 255, 255);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(150, 150, 150, 0.3);

    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(70, 70, 70);
    -unity-text-align: middle-center;
    padding: 0;

    transition-property: background-color, scale, color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}
.inv-close-btn:hover {
    background-color: rgb(252, 230, 230);
    color: rgb(180, 50, 50);
    scale: 1.05 1.05;
}


/* ════════════════════════════════════════
   ЗАГОЛОВОК INVENTORY
════════════════════════════════════════ */
.inv-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(248, 235, 235);
    -unity-text-align: middle-left;
    letter-spacing: 5px;

    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(218, 195, 195, 0.85);

    margin-top: 8px;
    margin-left: 24px;
    margin-bottom: 12px;
    padding: 0;
    flex-shrink: 0;
}


/* ════════════════════════════════════════
   ПОШУК — абсолютна позиція справа під X
════════════════════════════════════════ */
.inv-search-row {
    position: absolute;
    top: 62px;
    right: 14px;
    height: 32px;
    width: 160px;

    flex-direction: row;
    align-items: center;
    background-color: rgb(255, 255, 255);
    border-radius: 16px;

    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(150, 150, 150, 0.3);

    padding-left: 14px;
    padding-right: 4px;
}

.inv-search-field {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    font-size: 12px;
    color: rgb(80, 80, 80);
    -unity-text-align: middle-left;
    padding: 0;
    margin: 0;
}
.inv-search-field > .unity-base-text-field__input,
.inv-search-field .unity-text-element {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    margin: 0;
    color: rgb(80, 80, 80);
    font-size: 12px;
}

.inv-search-btn {
    width: 24px;
    height: 24px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(60, 60, 60);
    font-size: 14px;
    padding: 0;
    margin-left: 2px;
}
.inv-search-btn:hover { color: rgb(20, 20, 20); }


/* ════════════════════════════════════════
   SUBCATEGORY — схована (на макеті відсутня)
════════════════════════════════════════ */
.inv-subcategory-bar {
    display: none;
}


/* ════════════════════════════════════════
   GRID CONTAINER — стилі картки у Shared/BookCard.uss
════════════════════════════════════════ */
.inv-book-grid {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin-top: 4px;
}

/* Контейнер контенту: flex-wrap для 3-х колонок */
.inv-book-grid #unity-content-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    padding-top: 8px;
    padding-left: 22px;
    padding-right: 12px;
    padding-bottom: 24px;
    background-color: rgba(0, 0, 0, 0);
}


/* ════════════════════════════════════════
   SECTION LETTERS — контролер додає Label.inv-section-letter
   між картками за алфавітом. flex-basis: 100% → новий рядок.
════════════════════════════════════════ */
.inv-section-letter {
    flex-basis: 100%;
    width: 100%;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(140, 125, 90);
    -unity-text-align: middle-left;
    margin-top: 6px;
    margin-bottom: 2px;
    padding-left: 2px;
    flex-shrink: 0;
    flex-grow: 0;
}
