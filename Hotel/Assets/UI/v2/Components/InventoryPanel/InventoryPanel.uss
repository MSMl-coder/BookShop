/*
    InventoryPanel.uss — V5 (refactored, shared resources extracted)
    Path: Assets/UI/v2/Components/InventoryPanel/InventoryPanel.uss

    ЗАЛЕЖНОСТІ (підвантажуються у InventoryPanel.uxml через <Style src>):
    · Assets/UI/v2/Shared/CustomScrollbar.uss  — стилі скролбара
    · Assets/UI/v2/Shared/BookCard.uss         — стилі картки книги

    ЦЕЙ ФАЙЛ МІСТИТЬ ЛИШЕ:
    · позиціонування панелі
    · ряд категорій + плейсхолдери
    · кнопку X
    · заголовок INVENTORY
    · пошук
    · grid container (без стилів самої картки)
    · section letters
*/


/* ════════════════════════════════════════
   ROOT — позиція й розмір з 2го фото
   2/3 висоти екрана + посунуто вправо
════════════════════════════════════════ */
.inv-panel {
    position: absolute;
    left: 300px;
    top: 30px;
    width: 360px;
    bottom: 33%;             /* ≈ 2/3 висоти екрана */

    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    flex-direction: column;
    overflow: visible;
    padding: 0;

    transition-property: opacity, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.inv-panel.hidden {
    opacity: 0;
    translate: -20px 0;
    display: none;
}


/* ════════════════════════════════════════
   КАТЕГОРІЇ — ряд із 7 плейсхолдерів
════════════════════════════════════════ */
.inv-category-bar {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: nowrap;
    flex-shrink: 0;

    padding-top: 16px;
    padding-left: 16px;
    padding-right: 60px;     /* залишає простір під X */
    padding-bottom: 8px;

    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.inv-cat-btn {
    width: 32px;
    height: 32px;
    background-color: rgb(225, 225, 225);

    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(140, 140, 140, 0.4);

    border-radius: 9px;
    margin-right: 6px;
    margin-bottom: 4px;
    padding: 0;
    flex-shrink: 0;

    transition-property: scale, background-color, translate;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
    translate: 0 0;
}
.inv-cat-btn:hover {
    background-color: rgb(238, 238, 238);
    translate: 0 -2px;
}
.inv-cat-btn--active {
    background-color: rgb(195, 200, 220);
    border-bottom-color: rgba(120, 125, 150, 0.45);
}


/* ════════════════════════════════════════
   КНОПКА X — абсолютна позиція, окремо
════════════════════════════════════════ */
.inv-close-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    border-radius: 18px;

    background-color: rgb(255, 255, 255);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(150, 150, 150, 0.3);

    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(70, 70, 70);
    -unity-text-align: middle-center;
    padding: 0;

    transition-property: background-color, scale, color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}
.inv-close-btn:hover {
    background-color: rgb(252, 230, 230);
    color: rgb(180, 50, 50);
    scale: 1.05 1.05;
}


/* ════════════════════════════════════════
   ЗАГОЛОВОК INVENTORY
════════════════════════════════════════ */
.inv-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(248, 235, 235);
    -unity-text-align: middle-left;
    letter-spacing: 5px;

    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(218, 195, 195, 0.85);

    margin-top: 8px;
    margin-left: 24px;
    margin-bottom: 12px;
    padding: 0;
    flex-shrink: 0;
}


/* ════════════════════════════════════════
   ПОШУК — абсолютна позиція справа під X
════════════════════════════════════════ */
.inv-search-row {
    position: absolute;
    top: 62px;
    right: 14px;
    height: 32px;
    width: 160px;

    flex-direction: row;
    align-items: center;
    background-color: rgb(255, 255, 255);
    border-radius: 16px;

    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(150, 150, 150, 0.3);

    padding-left: 14px;
    padding-right: 4px;
}

.inv-search-field {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    font-size: 12px;
    color: rgb(80, 80, 80);
    -unity-text-align: middle-left;
    padding: 0;
    margin: 0;
}
.inv-search-field > .unity-base-text-field__input,
.inv-search-field .unity-text-element {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    margin: 0;
    color: rgb(80, 80, 80);
    font-size: 12px;
}

.inv-search-btn {
    width: 24px;
    height: 24px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(60, 60, 60);
    font-size: 14px;
    padding: 0;
    margin-left: 2px;
}
.inv-search-btn:hover { color: rgb(20, 20, 20); }


/* ════════════════════════════════════════
   SUBCATEGORY — схована (на макеті відсутня)
════════════════════════════════════════ */
.inv-subcategory-bar {
    display: none;
}


/* ════════════════════════════════════════
   GRID CONTAINER — стилі картки у Shared/BookCard.uss
════════════════════════════════════════ */
.inv-book-grid {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin-top: 4px;
    overflow: hidden;       /* НЕ пропускати overflow за межі grid */
}

/* Контейнер контенту: flex-wrap для 3-х колонок */
.inv-book-grid #unity-content-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    padding-top: 8px;
    padding-left: 22px;
    padding-right: 12px;
    padding-bottom: 24px;
    background-color: rgba(0, 0, 0, 0);
}


/* ════════════════════════════════════════
   SECTION LETTERS — контролер додає Label.inv-section-letter
   між картками за алфавітом. flex-basis: 100% → новий рядок.
════════════════════════════════════════ */
.inv-section-letter {
    flex-basis: 100%;
    width: 100%;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(140, 125, 90);
    -unity-text-align: middle-left;
    margin-top: 6px;
    margin-bottom: 2px;
    padding-left: 2px;
    flex-shrink: 0;
    flex-grow: 0;
}

/* ═══════════════════════════════════════
   CustomScrollbar (merged — GUID import ненадійний)
═══════════════════════════════════════ */
/*
    CustomScrollbar.uss — переюзабельний скрол
    Path: Assets/UI/v2/Shared/CustomScrollbar.uss
    v3 — Fixed: explicit sizes, pill shape, always-visible friendly
*/

/* ── Vertical scroller container ── */
.custom-scrollbar #unity-vertical-scroller {
    width: 10px;
    min-width: 10px;
    max-width: 10px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin-left: 8px;
    margin-right: 4px;
    margin-top: 10px;
    margin-bottom: 10px;
    padding: 0;
}

/* Track — заокруглена тонка смуга */
.custom-scrollbar #unity-vertical-scroller #unity-tracker {
    width: 6px;
    border-radius: 3px;
    background-color: rgb(218, 213, 200);
    border-width: 0;
    margin: 0;
    padding: 0;
    align-self: center;
}

/* Dragger — фіксований розмір, pill */
.custom-scrollbar #unity-vertical-scroller #unity-dragger {
    width: 6px;
    height: 36px;
    min-height: 36px;
    max-height: 36px;
    border-radius: 3px;
    background-color: rgb(150, 144, 132);
    border-width: 0;
    margin: 0;
    padding: 0;
    align-self: center;
    
    transition-property: background-color;
    transition-duration: 0.15s;
}

.custom-scrollbar #unity-vertical-scroller #unity-dragger:hover {
    background-color: rgb(118, 112, 100);
}

/* Сховати стрілки — всі варіанти Unity 6 */
.custom-scrollbar #unity-vertical-scroller .unity-base-slider__low-button,
.custom-scrollbar #unity-vertical-scroller .unity-base-slider__high-button,
.custom-scrollbar #unity-vertical-scroller .unity-scroller__low-button,
.custom-scrollbar #unity-vertical-scroller .unity-scroller__high-button,
.custom-scrollbar #unity-vertical-scroller #unity-low-button,
.custom-scrollbar #unity-vertical-scroller #unity-high-button,
.custom-scrollbar #unity-low-button,
.custom-scrollbar #unity-high-button {
    display: none;
    height: 0;
    width: 0;
    min-height: 0;
    min-width: 0;
    max-height: 0;
    max-width: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
}


/* ── --left modifier: скрол на лівому боці ── */
.custom-scrollbar--left > .unity-scroll-view__content-and-vertical-scroll-container {
    flex-direction: row-reverse;
}


/* ── Horizontal ── */
.custom-scrollbar #unity-horizontal-scroller {
    height: 10px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 4px 8px;
}
.custom-scrollbar #unity-horizontal-scroller #unity-tracker {
    border-radius: 3px;
    background-color: rgb(218, 213, 200);
    border-width: 0;
}
.custom-scrollbar #unity-horizontal-scroller #unity-dragger {
    border-radius: 3px;
    background-color: rgb(150, 144, 132);
    min-width: 36px;
    max-width: 36px;
    border-width: 0;
}
.custom-scrollbar #unity-horizontal-scroller .unity-base-slider__low-button,
.custom-scrollbar #unity-horizontal-scroller .unity-base-slider__high-button {
    display: none;
}


/* ═══════════════════════════════════════
   BookCard (merged — GUID import ненадійний)
═══════════════════════════════════════ */
/*
    BookCard.uss — переюзабельна картка книги
    Path: Assets/UI/v2/Shared/BookCard.uss

    ПРИЗНАЧЕННЯ: спільний візуальний стиль для картки книги.
    Використовується в Inventory, Catalog, Awards, Lootbox, тощо.

    ВИКОРИСТАННЯ:
    1. Імпорт USS у вашому UXML:
       <Style src="project://database/Assets/UI/v2/Shared/BookCard.uss"/>
    2. Інстанціювати шаблон BookCard.uxml:
       VisualTreeAsset bookCard = ...;
       container.Add(bookCard.Instantiate().ElementAt(0));

    РОЗМІРИ: 71 × 81px, border-radius 11, border 3px темно-сірий.
    Колір кремовий rgb(247,244,230) — як на макеті інвентаря.

    ДВА РЕЖИМИ:
    1. БЕЗ wrapper'а — додати .book-card напряму в flex-grid:
         <ui:VisualElement class="book-card">...</ui:VisualElement>
       Картка у normal flow, БЕЗ drop-shadow (тільки border).

    2. З wrapper'ом — drop-shadow ідентичний genre-card з NPCInspector:
         <ui:VisualElement class="book-card-wrap">
           <ui:VisualElement class="book-card-shadow" picking-mode="Ignore"/>
           <ui:VisualElement class="book-card">...</ui:VisualElement>
         </ui:VisualElement>

    КЛАСИ:
    .book-card-wrap         — контейнер з drop-shadow
    .book-card-shadow       — затемнений дубль за карткою (offset 4,5)
    .book-card              — сама картка
    .book-card__icon        — слот для обкладинки/іконки (опційно)
    .book-card__dot         — крапка статусу в правому верхньому куті
       .common / .uncommon / .rare / .epic / .legendary
    .book-card__title       — назва (труncується)
    .book-card__price       — ціна
*/


/* ════════════════════════════════════════
   WRAPPER — контейнер з drop-shadow
════════════════════════════════════════ */
.book-card-wrap {
    position: relative;     /* positioning context для absolute дітей */
    width: 72px;
    height: 96px;
    margin-right: 16px;     /* gap між колонками у grid */
    margin-bottom: 18px;    /* місце для тіні (5px) + gap між рядами */
    overflow: visible;      /* тінь виходить за межі wrapper'а */
    flex-shrink: 0;
    flex-grow: 0;
}

/* Тінь — патерн з genre-card-shadow (NPCInspector.uss) */
.book-card-shadow {
    position: absolute;
    top: 0;
    left: 0;
    width: 72px;
    height: 96px;
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0.22);
    translate: 4px 5px;      /* offset 4 вправо, 5 вниз */
}


/* ════════════════════════════════════════
   КАРТКА — основний стиль
   У normal flow без wrapper'а працює як flex-item
   У wrapper'і — absolute поверх shadow
════════════════════════════════════════ */
.book-card {
    width: 72px;
    height: 96px;
    border-radius: 5px;
    border-width: 3px;
    border-color: rgb(211, 209, 209);     /* темно-сірий як stat-segment */
    background-color: rgb(247, 244, 230); /* кремовий */

    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 4px;
    margin-right: 16px;
    margin-bottom: 18px;
    overflow: hidden;
    cursor: link;
    flex-shrink: 0;
    flex-grow: 0;

    transition-property: translate, background-color, border-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
    translate: 0 0;
}

/* Override: всередині wrapper'а використати absolute для накладання поверх shadow */
.book-card-wrap > .book-card {
    position: absolute;
    top: 0;
    left: 0;
    margin-right: 0;
    margin-bottom: 0;
}

/* Hover */
.book-card:hover,
.book-card-wrap:hover .book-card {
    translate: 0 -3px;
    background-color: rgb(252, 250, 238);
    border-color: rgb(79, 177, 92);
}

/* Selected */
.book-card--selected,
.book-card-wrap.selected .book-card {
    border-color: rgb(79, 177, 92);
    border-width: 3px;
    background-color: rgb(242, 238, 218);
}


/* ════════════════════════════════════════
   ВНУТРІШНІ ЕЛЕМЕНТИ
════════════════════════════════════════ */

/* Слот для обкладинки/іконки (верхня частина картки) */
.book-card__icon {
    position: absolute;
    top: 8px;
    left: 8px;
    right: 8px;
    height: 42px;
    background-color: rgba(0, 0, 0, 0);
    /* Заповнити через C#: icon.style.backgroundImage = ... */
}

/* Крапка статусу/рарності у правому верхньому куті */
.book-card__dot {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(178, 176, 160);  /* common default */
}
.book-card__dot.common    { background-color: rgb(178, 176, 160); }
.book-card__dot.uncommon  { background-color: rgb(72, 168, 84);   }
.book-card__dot.rare      { background-color: rgb(56, 118, 210);  }
.book-card__dot.epic      { background-color: rgb(155, 56, 210);  }
.book-card__dot.legendary { background-color: rgb(218, 162, 28);  }

/* Назва книги */
.book-card__title {
    font-size: 9px;
    color: rgb(45, 42, 30);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    -unity-text-overflow-position: end;
    width: 58px;
    margin: 0;
    padding: 0;
    margin-bottom: 1px;
}

/* Ціна */
.book-card__price {
    font-size: 9px;
    color: rgb(95, 85, 60);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}
