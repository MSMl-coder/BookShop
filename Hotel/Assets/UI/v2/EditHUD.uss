/*
    EditHUD.uss — Screen 2 EditMode panel styles
    Path: Assets/UI/v2/EditHUD/EditHUD.uss

    Підключити BookshopVariables.uss до PanelSettings (або @import).
*/

/* ══════════════════════════════════════
   ROOT
══════════════════════════════════════ */
.edit-hud-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ══════════════════════════════════════
   LEFT PANEL — slide-in з лівого боку
══════════════════════════════════════ */
.edit-left-panel {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 280px;
    background-color: rgba(18, 26, 32, 0.94);
    border-right-width: 1px;
    border-right-color: rgba(184, 144, 42, 0.35);
    flex-direction: column;
    padding-top: 8px;
    padding-bottom: 8px;

    /* Slide-in анімація */
    transition-property: translate, opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
    translate: 0 0;
    opacity: 1;
}

/* Прихована — C# додає/прибирає */
.edit-left-panel--hidden {
    translate: -290px 0;
    opacity: 0;
}

/* Close button */
.edit-close-btn {
    position: absolute;
    top: 8px;
    right: -36px;          /* виходить за панель вправо */
    width: 32px; height: 32px;
    background-color: rgba(18, 26, 32, 0.9);
    border-width: 1px;
    border-color: rgba(184, 144, 42, 0.4);
    border-radius: 0 6px 6px 0;
    color: rgb(184, 144, 42);
    font-size: 14px;
    -unity-text-align: middle-center;
    padding: 0;
}
.edit-close-btn:hover {
    background-color: rgba(139, 58, 58, 0.8);
    border-color: rgb(139, 58, 58);
    color: rgb(245, 236, 214);
}

/* ── CATEGORY ICON BAR (вертикальний ряд) ── */
.category-icon-bar {
    flex-direction: row;
    flex-wrap: wrap;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(184, 144, 42, 0.2);
}

/* Кнопка-іконка категорії — placeholder квадрат */
.cat-icon-btn {
    width: 36px; height: 36px;
    background-color: rgba(42, 67, 71, 0.6);
    border-width: 1px;
    border-color: rgba(184, 144, 42, 0.2);
    border-radius: 6px;
    margin-right: 6px;
    margin-bottom: 0;
    padding: 0;
    /* C# задасть background-image зі спрайтом категорії */
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}
.cat-icon-btn:hover {
    background-color: rgba(62, 97, 101, 0.8);
    border-color: rgb(212, 168, 67);
}
.cat-icon-btn--active {
    background-color: rgba(212, 168, 67, 0.18);
    border-color: rgb(212, 168, 67);
    border-width: 2px;
}

/* ── SUBCATEGORY ROW (горизонтальний скрол) ── */
.subcategory-row {
    height: 36px;
    flex-shrink: 0;
    margin-top: 4px;
    margin-left: 8px;
    margin-right: 8px;
    margin-bottom: 4px;
}
/* Видалити скролбар */
.subcategory-row > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container {
    flex-direction: row;
}

/* Кнопка субкатегорії */
.subcat-btn {
    height: 28px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgba(42, 67, 71, 0.5);
    border-width: 1px;
    border-color: rgba(184, 144, 42, 0.2);
    border-radius: 14px;
    color: rgb(160, 140, 90);
    font-size: 10px;
    letter-spacing: 0.5px;
    margin-right: 6px;
    flex-shrink: 0;
    transition-property: background-color, border-color, color;
    transition-duration: 0.15s;
}
.subcat-btn:hover {
    background-color: rgba(62, 97, 101, 0.8);
    color: rgb(245, 236, 214);
    border-color: rgb(184, 144, 42);
}
.subcat-btn--active {
    background-color: rgba(212, 168, 67, 0.15);
    border-color: rgb(212, 168, 67);
    color: rgb(232, 196, 90);
}

/* ── SEARCH ROW ── */
.edit-search-row {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
    margin-right: 8px;
    margin-bottom: 8px;
    height: 30px;
}

.edit-search-field {
    flex-grow: 1;
    height: 28px;
    font-size: 11px;
    color: rgb(245, 236, 214);
    background-color: rgba(30, 44, 50, 0.8);
    border-width: 1px;
    border-color: rgba(184, 144, 42, 0.3);
    border-radius: 4px;
    padding-left: 8px;
}
.edit-search-field:focus {
    border-color: rgb(212, 168, 67);
}

.edit-search-btn {
    width: 28px; height: 28px;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    font-size: 14px;
    margin-left: 4px;
    padding: 0;
    color: rgb(184, 144, 42);
}
.edit-search-btn:hover {
    color: rgb(232, 196, 90);
}

/* ── ITEM GRID ── */
.edit-item-grid {
    flex-grow: 1;
    margin-left: 8px;
    margin-right: 4px; /* 4px для скролбару */
}

/* Внутрішній контейнер — wrap grid */
.edit-item-grid > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container {
    flex-direction: row;
    flex-wrap: wrap;
    padding-top: 4px;
    padding-bottom: 4px;
}

/* ── ITEM CARD ── */
.item-card {
    width: 72px;
    height: 72px;
    margin-right: 8px;
    margin-bottom: 8px;
    flex-direction: column;
    align-items: center;
    background-color: rgba(42, 55, 70, 0.7);
    border-width: 1px;
    border-color: rgba(100, 90, 60, 0.3);
    border-radius: 6px;
    overflow: hidden;
    cursor: link;
    transition-property: border-color, background-color;
    transition-duration: 0.15s;
}
.item-card:hover {
    border-color: rgb(212, 168, 67);
    background-color: rgba(62, 70, 50, 0.8);
}
.item-card--selected {
    border-color: rgb(232, 196, 90);
    border-width: 2px;
    background-color: rgba(212, 168, 67, 0.12);
}

.item-card__preview {
    width: 100%;
    flex-grow: 1;
    background-color: rgba(60, 70, 80, 0.5);
    /* C# задасть background-image */
}

.item-card__name {
    font-size: 8px;
    color: rgb(160, 140, 90);
    -unity-text-align: middle-center;
    height: 14px;
    padding-left: 2px;
    padding-right: 2px;
    overflow: hidden;
    -unity-text-overflow-position: end;
}

/* ══════════════════════════════════════
   CONTEXT TOOLBAR
   Знаходиться внизу по центру або
   над вибраним об'єктом (C# позиціонує)
══════════════════════════════════════ */
.context-toolbar {
    position: absolute;
    bottom: 40px;
    left: 0; right: 0;
    /* Центрується через align-self або margin auto */
    flex-direction: row;
    align-items: center;
    align-self: center;
    background-color: rgba(18, 26, 32, 0.95);
    border-width: 1px;
    border-color: rgba(184, 144, 42, 0.5);
    border-radius: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;

    /* Фіксована ширина, центруємо через margin */
    width: 280px;
    margin-left: auto;
    margin-right: auto;

    transition-property: opacity, translate;
    transition-duration: 0.2s;
    translate: 0 0;
    opacity: 1;
}
.context-toolbar--hidden {
    opacity: 0;
    translate: 0 12px;
}

/* Іконка предмету зліва */
.ctx-item-icon {
    width: 40px; height: 40px;
    border-radius: 6px;
    background-color: rgba(42, 55, 70, 0.8);
    border-width: 1px;
    border-color: rgba(184, 144, 42, 0.3);
    margin-right: 4px;
    flex-shrink: 0;
}

.ctx-divider {
    width: 1px; height: 32px;
    background-color: rgba(184, 144, 42, 0.3);
    margin-left: 6px;
    margin-right: 6px;
    flex-shrink: 0;
}

/* Кнопки тулбару */
.ctx-btn {
    width: 36px; height: 36px;
    background-color: rgba(0,0,0,0);
    border-width: 1px;
    border-color: rgba(184, 144, 42, 0.2);
    border-radius: 6px;
    font-size: 16px;
    -unity-text-align: middle-center;
    padding: 0;
    margin-left: 3px;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
    /* Іконки задаються через C# background-image або unicode placeholder */
}
.ctx-btn:hover {
    background-color: rgba(42, 67, 71, 0.8);
    border-color: rgb(212, 168, 67);
}
.ctx-btn--danger {
    border-color: rgba(139, 58, 58, 0.4);
}
.ctx-btn--danger:hover {
    background-color: rgba(139, 58, 58, 0.7);
    border-color: rgb(180, 70, 70);
}
.ctx-btn--confirm {
    border-color: rgba(58, 130, 58, 0.4);
}
.ctx-btn--confirm:hover {
    background-color: rgba(58, 130, 58, 0.7);
    border-color: rgb(80, 180, 80);
}
